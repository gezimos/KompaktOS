From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Gezim <gezimos@users.noreply.github.com>
Date: Mon, 5 Oct 2026 16:30:00 +0200
Subject: [PATCH 1/1] Kompakt: the alarm screen follows the mode

---
diff --git a/res/values/kompakt_alarm.xml b/res/values/kompakt_alarm.xml
new file mode 100644
--- /dev/null
+++ b/res/values/kompakt_alarm.xml
@@ -0,0 +1,6 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- Kompakt: the alarm screen's ink. It was white only, so in light mode the clock,
+     the buttons and the text were white on white. -->
+<resources>
+    <color name="kompakt_alarm_ink">#ff000000</color>
+</resources>
diff --git a/res/values-night/kompakt_alarm.xml b/res/values-night/kompakt_alarm.xml
new file mode 100644
--- /dev/null
+++ b/res/values-night/kompakt_alarm.xml
@@ -0,0 +1,4 @@
+<?xml version="1.0" encoding="utf-8"?>
+<resources>
+    <color name="kompakt_alarm_ink">#fffffffe</color>
+</resources>
diff --git a/res/drawable/kompakt_alarm_button_bg.xml b/res/drawable/kompakt_alarm_button_bg.xml
new file mode 100644
--- /dev/null
+++ b/res/drawable/kompakt_alarm_button_bg.xml
@@ -0,0 +1,7 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- Kompakt: snooze and dismiss. Shown only while selected (AlarmActivity fades its
+     alpha in), an ink disc under the icon drawn in the page colour. -->
+<shape xmlns:android="http://schemas.android.com/apk/res/android"
+    android:shape="oval">
+    <solid android:color="@color/kompakt_alarm_ink" />
+</shape>
diff --git a/res/layout/alarm_activity.xml b/res/layout/alarm_activity.xml
--- a/res/layout/alarm_activity.xml
+++ b/res/layout/alarm_activity.xml
@@ -34,6 +34,7 @@
