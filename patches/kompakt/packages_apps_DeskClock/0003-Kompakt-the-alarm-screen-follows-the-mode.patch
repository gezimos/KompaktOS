             android:id="@+id/title"
             style="@style/body"
+            android:textColor="@color/kompakt_alarm_ink"
             android:layout_width="0dp"
             android:layout_height="wrap_content"
             android:gravity="center"
@@ -70,33 +72,34 @@
             app:layout_column="0"
             app:layout_columnSpan="3"
             app:layout_gravity="fill"
-            app:fillColor="@android:color/white"
+            app:fillColor="@color/kompakt_alarm_ink"
             app:radius="@dimen/alarm_lockscreen_pulse_radius" />
 
         <ImageView
             android:id="@+id/snooze"
             android:layout_width="wrap_content"
             android:layout_height="wrap_content"
-            android:background="@drawable/bg_circle_white"
+            android:background="@drawable/kompakt_alarm_button_bg"
             android:contentDescription="@string/alarm_alert_snooze_text"
             app:layout_row="2"
             app:layout_column="0"
             app:layout_columnWeight="1"
             app:layout_gravity="center"
-            app:backgroundTint="?attr/colorAccent"
-            app:srcCompat="@drawable/ic_snooze" />
+            app:srcCompat="@drawable/ic_snooze"
+            app:tint="@color/kompakt_alarm_ink" />
 
         <ImageView
             android:id="@+id/dismiss"
             android:layout_width="wrap_content"
             android:layout_height="wrap_content"
-            android:background="@drawable/bg_circle_white"
+            android:background="@drawable/kompakt_alarm_button_bg"
             android:contentDescription="@string/alarm_alert_dismiss_text"
             app:layout_row="2"
             app:layout_column="2"
             app:layout_columnWeight="1"
             app:layout_gravity="center"
-            app:srcCompat="@drawable/ic_dismiss" />
+            app:srcCompat="@drawable/ic_dismiss"
+            app:tint="@color/kompakt_alarm_ink" />
 
         <ImageView
             android:id="@+id/alarm"
@@ -112,14 +115,15 @@
             app:layout_column="1"
             app:layout_columnWeight="1"
             app:layout_gravity="center"
-            app:srcCompat="@drawable/ic_fab_alarm" />
+            app:srcCompat="@drawable/ic_fab_alarm"
+            app:tint="@color/kompakt_alarm_ink" />
 
         <TextView
             android:id="@+id/hint"
             android:layout_width="wrap_content"
             android:layout_height="wrap_content"
             android:layout_marginBottom="@dimen/alarm_lockscreen_bottom_margin"
-            android:textColor="@android:color/white"
+            android:textColor="@color/kompakt_alarm_ink"
             android:textSize="@dimen/bottom_text_size"
             android:visibility="gone"
             app:layout_row="2"
@@ -144,7 +148,7 @@
             android:layout_height="wrap_content"
             android:gravity="center_horizontal"
             android:textAppearance="@style/alarm_lockscreen_thin"
-            android:textColor="@android:color/white" />
+            android:textColor="@color/kompakt_alarm_ink" />
 
         <TextView
             android:id="@+id/alert_info"
@@ -152,7 +156,7 @@
             android:layout_height="wrap_content"
             android:gravity="center_horizontal"
             android:textAppearance="@style/alarm_lockscreen_thin"
-            android:textColor="@android:color/white"
+            android:textColor="@color/kompakt_alarm_ink"
             android:textStyle="bold"
             android:visibility="gone" />
 
diff --git a/src/com/android/deskclock/alarms/AlarmActivity.java b/src/com/android/deskclock/alarms/AlarmActivity.java
