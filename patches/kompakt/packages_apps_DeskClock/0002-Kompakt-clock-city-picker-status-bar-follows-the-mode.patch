From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: gezimos <>
Date: Fri, 25 Sep 2026 17:50:32 +0300
Subject: [PATCH] Kompakt: clock city picker status bar follows the mode

---
diff --git a/src/com/android/deskclock/worldclock/CitySelectionActivity.java b/src/com/android/deskclock/worldclock/CitySelectionActivity.java
index 796211e11..323a5e94c 100644
--- a/src/com/android/deskclock/worldclock/CitySelectionActivity.java
+++ b/src/com/android/deskclock/worldclock/CitySelectionActivity.java
@@ -107,6 +107,21 @@ public final class CitySelectionActivity extends BaseActivity {
         super.onCreate(savedInstanceState);
 
         setContentView(R.layout.cities_activity);
+
+        // Kompakt: set the bars from code, as DeskClock does; BaseActivity wipes the theme's.
+        final android.view.WindowInsetsController kompaktBars =
+                getWindow().getInsetsController();
+        if (kompaktBars != null) {
+            final int light =
+                    android.view.WindowInsetsController.APPEARANCE_LIGHT_STATUS_BARS
+                            | android.view.WindowInsetsController
+                                    .APPEARANCE_LIGHT_NAVIGATION_BARS;
+            final boolean kompaktNight =
+                    (getResources().getConfiguration().uiMode
+                            & android.content.res.Configuration.UI_MODE_NIGHT_MASK)
+                            == android.content.res.Configuration.UI_MODE_NIGHT_YES;
+            kompaktBars.setSystemBarsAppearance(kompaktNight ? 0 : light, light);
+        }
         ActionBar actionBar = getSupportActionBar();
         if (actionBar == null) return;
         mSearchMenuItemController =
-- 
