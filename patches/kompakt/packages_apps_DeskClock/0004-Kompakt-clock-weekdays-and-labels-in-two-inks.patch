From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Gezim <gezimos@users.noreply.github.com>
Date: Mon, 5 Oct 2026 17:20:00 +0200
Subject: [PATCH 1/1] Kompakt: clock weekdays and labels in two inks

---
diff --git a/res/drawable/bg_day_selected.xml b/res/drawable/bg_day_selected.xml
--- a/res/drawable/bg_day_selected.xml
+++ b/res/drawable/bg_day_selected.xml
@@ -6,7 +6,7 @@
         android:bottom="8dp">
         <shape android:shape="oval" >
             <size android:height="20dp" android:width="20dp" />
-            <solid android:color="?attr/colorPrimary" />
+            <solid android:color="@color/kompakt_alarm_ink" />
         </shape>
     </item>
 </layer-list>
diff --git a/res/drawable/bg_day_unselected.xml b/res/drawable/bg_day_unselected.xml
--- a/res/drawable/bg_day_unselected.xml
+++ b/res/drawable/bg_day_unselected.xml
@@ -6,7 +6,7 @@
         android:bottom="8dp">
         <shape android:shape="oval" >
             <size android:height="20dp" android:width="20dp" />
-            <stroke android:width="1dp" android:color="?attr/colorSecondary" />
+            <stroke android:width="2dp" android:color="@color/kompakt_alarm_ink" />
         </shape>
     </item>
 </layer-list>
diff --git a/res/layout/alarm_time_expanded.xml b/res/layout/alarm_time_expanded.xml
--- a/res/layout/alarm_time_expanded.xml
+++ b/res/layout/alarm_time_expanded.xml
@@ -36,13 +36,15 @@
         android:focusable="true"
         android:gravity="start|center"
         android:hint="@string/add_label"
+        android:textColor="@color/kompakt_alarm_ink"
+        android:textColorHint="@color/kompakt_alarm_ink"
         android:paddingStart="4.0dip"
         android:paddingEnd="4.0dip"
         android:singleLine="true"
         android:textAlignment="viewStart"
         android:textAppearance="@style/body"
         app:drawableStartCompat="@drawable/ic_label"
-        app:drawableTint="?colorControlNormal"
+        app:drawableTint="@color/kompakt_alarm_ink"
         app:layout_constraintEnd_toStartOf="@id/arrow"
         app:layout_constraintStart_toEndOf="@id/start_guide_thin"
         app:layout_constraintTop_toTopOf="parent" />
diff --git a/res/layout/alarm_time_collapsed.xml b/res/layout/alarm_time_collapsed.xml
--- a/res/layout/alarm_time_collapsed.xml
+++ b/res/layout/alarm_time_collapsed.xml
@@ -36,6 +36,8 @@
         android:focusable="true"
         android:gravity="start|center"
         android:hint="@string/add_label"
+        android:textColor="@color/kompakt_alarm_ink"
+        android:textColorHint="@color/kompakt_alarm_ink"
         android:paddingStart="4.0dip"
         android:paddingEnd="4.0dip"
         android:singleLine="true"
diff --git a/res/values/kompakt_alarm.xml b/res/values/kompakt_alarm.xml
--- a/res/values/kompakt_alarm.xml
+++ b/res/values/kompakt_alarm.xml
@@ -3,4 +3,5 @@
      the buttons and the text were white on white. -->
 <resources>
     <color name="kompakt_alarm_ink">#ff000000</color>
+    <color name="kompakt_page">#fffffffe</color>
 </resources>
diff --git a/res/values-night/kompakt_alarm.xml b/res/values-night/kompakt_alarm.xml
--- a/res/values-night/kompakt_alarm.xml
+++ b/res/values-night/kompakt_alarm.xml
@@ -1,4 +1,5 @@
 <?xml version="1.0" encoding="utf-8"?>
 <resources>
     <color name="kompakt_alarm_ink">#fffffffe</color>
+    <color name="kompakt_page">#ff000000</color>
 </resources>
diff --git a/src/com/android/deskclock/alarms/dataadapter/ExpandedAlarmViewHolder.java b/src/com/android/deskclock/alarms/dataadapter/ExpandedAlarmViewHolder.java
--- a/src/com/android/deskclock/alarms/dataadapter/ExpandedAlarmViewHolder.java
+++ b/src/com/android/deskclock/alarms/dataadapter/ExpandedAlarmViewHolder.java
@@ -189,12 +189,13 @@
         for (int i = 0; i < weekdays.size(); i++) {
             final CompoundButton dayButton = dayButtons[i];
             if (alarm.daysOfWeek.isBitOn(weekdays.get(i))) {
+                // Kompakt: an ink disc with the letter in the page colour; unselected is an
+                // ink ring with an ink letter. It was white on white in light mode.
                 dayButton.setChecked(true);
-                dayButton.setTextColor(ThemeUtils.resolveColor(context,
-                        android.R.attr.windowBackground));
+                dayButton.setTextColor(context.getColor(R.color.kompakt_page));
             } else {
                 dayButton.setChecked(false);
-                dayButton.setTextColor(Color.WHITE);
+                dayButton.setTextColor(context.getColor(R.color.kompakt_alarm_ink));
             }
         }
     }
-- 
