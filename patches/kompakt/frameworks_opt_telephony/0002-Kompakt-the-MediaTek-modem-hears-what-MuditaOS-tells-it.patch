diff --git a/src/java/com/android/internal/telephony/kompakt/MtkModem.java b/src/java/com/android/internal/telephony/kompakt/MtkModem.java
new file mode 100644
--- /dev/null
+++ b/src/java/com/android/internal/telephony/kompakt/MtkModem.java
@@ -0,0 +1,265 @@
+package com.android.internal.telephony.kompakt;
+
+import android.annotation.NonNull;
+import android.hardware.radio.V1_0.RadioResponseInfo;
+import android.os.Handler;
+import android.os.HandlerThread;
+import android.os.IHwBinder;
+import android.os.RemoteException;
+import android.provider.Settings;
+import android.telephony.AccessNetworkConstants;
+import android.telephony.NetworkRegistrationInfo;
+import android.telephony.ServiceState;
+import android.telephony.SubscriptionManager;
+import android.telephony.TelephonyManager;
+import android.telephony.data.ApnSetting;
+import android.telephony.data.DataProfile;
+
+import com.android.internal.telephony.Phone;
+import com.android.internal.telephony.data.DataSettingsManager;
+import com.android.internal.telephony.data.DataSettingsManager.DataSettingsManagerCallback;
+import com.android.internal.telephony.kompakt.mtkradioex.V3_0.IAssistRadioResponse;
+import com.android.internal.telephony.kompakt.mtkradioex.V3_0.IMtkRadioEx;
+import com.android.telephony.Rlog;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.NoSuchElementException;
+
+/**
+ * Kompakt: what MuditaOS's MediaTek telephony framework tells the modem, and the two modem
+ * requests it answers. A GSI has none of it. One instance per phone, on one shared thread.
+ */
+public final class MtkModem implements IHwBinder.DeathRecipient {
+    private static final String TAG = "KompaktMtkModem";
+    /** A data setting the modem should leave as it is. */
+    private static final int KEEP = -2;
+    private static final int EVENT_RADIO_ON = 1;
+    private static final long RECONNECT_MS = 2000;
+    private static final long COOKIE_RADIO = 0;
+    private static final long COOKIE_ASSIST = 1;
+
+    private static final Object sLock = new Object();
+    private static MtkModem[] sModems = new MtkModem[0];
+    private static Handler sHandler;
+
+    private final Phone mPhone;
+    private final int mSlot;
+    private final Handler mHandler;
+    /** mtkSlotN: requests, and the modem's indications. */
+    private IMtkRadioEx mRadio;
+    /** mtkAssistN: the data settings, through the instance MtkTelephonyAssist uses. */
+    private IMtkRadioEx mAssist;
+    private final Runnable mConnect = this::connect;
+    private boolean mUnavailable;
+    private int mSerial;
+
+    /** Called for each phone PhoneFactory makes. */
+    public static void make(@NonNull Phone phone) {
+        synchronized (sLock) {
+            if (sHandler == null) {
+                HandlerThread thread = new HandlerThread(TAG);
+                thread.start();
+                sHandler = new Handler(thread.getLooper());
+            }
+            int id = phone.getPhoneId();
+            if (id < 0) return;
+            if (id >= sModems.length) sModems = Arrays.copyOf(sModems, id + 1);
+            if (sModems[id] != null) return;
+            sModems[id] = new MtkModem(phone, sHandler);
+            sModems[id].start();
+        }
+    }
+
+    private static MtkModem get(int phoneId) {
+        synchronized (sLock) {
+            return phoneId >= 0 && phoneId < sModems.length ? sModems[phoneId] : null;
+        }
+    }
+
+    /** MtkRetryManager.configureRetry: a new attempt on an APN restarts the modem's retry count. */
+    public static void onSetupData(@NonNull Phone phone, @NonNull DataProfile profile) {
+        MtkModem modem = get(phone.getPhoneId());
+        ApnSetting apn = profile.getApnSetting();
+        if (modem == null || apn == null) return;
+        String name = apn.getApnName();
+        modem.mHandler.post(() -> modem.resetMdDataRetryCount(name));
+    }
+
+    /** MtkServiceStateTracker.pollStateDone: the modem hears every service state poll. */
+    public static void onServiceStateChanged(@NonNull Phone phone, @NonNull ServiceState ss) {
+        MtkModem modem = get(phone.getPhoneId());
+        if (modem == null) return;
+        ServiceState copy = new ServiceState(ss);
+        modem.mHandler.post(() -> modem.sendServiceState(copy));
+    }
+
+    private MtkModem(Phone phone, Handler handler) {
+        mPhone = phone;
+        mSlot = phone.getPhoneId();
+        mHandler = handler;
+    }
+
+    private void start() {
+        Handler events = new Handler(mHandler.getLooper(), msg -> {
+            // MtkTelephonyAssist resends the data settings each time the radio comes on.
+            if (msg.what == EVENT_RADIO_ON) syncData();
+            return true;
+        });
+        mPhone.mCi.registerForOn(events, EVENT_RADIO_ON, null);
+        DataSettingsManager settings = mPhone.getDataSettingsManager();
+        if (settings != null) {
+            settings.registerCallback(new DataSettingsManagerCallback(mHandler::post) {
+                @Override
+                public void onDataEnabledChanged(boolean enabled, int reason,
+                        @NonNull String callingPackage) {
+                    syncData();
+                }
+
+                @Override
+                public void onDataRoamingEnabledChanged(boolean enabled) {
+                    syncData();
+                }
+            });
+        }
+        SubscriptionManager subs = mPhone.getContext().getSystemService(SubscriptionManager.class);
+        if (subs != null) {
+            subs.addOnSubscriptionsChangedListener(mHandler::post,
+                    new SubscriptionManager.OnSubscriptionsChangedListener() {
+                        @Override
+                        public void onSubscriptionsChanged() {
+                            syncData();
+                        }
+                    });
+        }
+        mHandler.post(mConnect);
+    }
+
+    private void connect() {
+        if (mUnavailable) return;
+        try {
+            if (mRadio == null) {
+                IMtkRadioEx radio = IMtkRadioEx.getService("mtkSlot" + (mSlot + 1), true);
+                radio.linkToDeath(this, COOKIE_RADIO);
+                radio.setResponseFunctionsMtk(new MtkModemResponse(), new MtkModemIndication(this));
+                mRadio = radio;
+            }
+            if (mAssist == null) {
+                IMtkRadioEx assist = IMtkRadioEx.getService("mtkAssist" + (mSlot + 1), true);
+                assist.linkToDeath(this, COOKIE_ASSIST);
+                assist.setResponseFunctionsAssist(new AssistResponse());
+                mAssist = assist;
+            }
+        } catch (NoSuchElementException e) {
+            Rlog.w(TAG, "slot " + mSlot + ": no MediaTek radio HAL, staying off");
+            mUnavailable = true;
+            return;
+        } catch (RemoteException | RuntimeException e) {
+            Rlog.e(TAG, "slot " + mSlot + ": MediaTek radio HAL not reachable, retrying: " + e);
+            mHandler.postDelayed(mConnect, RECONNECT_MS);
+            return;
+        }
+        Rlog.i(TAG, "slot " + mSlot + ": connected");
+        syncData();
+        sendServiceState(new ServiceState(mPhone.getServiceState()));
+    }
+
+    @Override
+    public void serviceDied(long cookie) {
+        Rlog.w(TAG, "slot " + mSlot + ": MediaTek radio HAL died");
+        mHandler.post(() -> {
+            if (cookie == COOKIE_RADIO) mRadio = null;
+            else mAssist = null;
+            mHandler.removeCallbacks(mConnect);
+            mHandler.postDelayed(mConnect, RECONNECT_MS);
+        });
+    }
+
+    /** MtkDcTracker EVENT_RESET_ATTACH_APN: the modem asks for the attach APN again. */
+    void onResetAttachApn() {
+        Rlog.i(TAG, "slot " + mSlot + ": modem asks for the attach APN again");
+        mPhone.getDataNetworkController().getDataProfileManager().resendInitialAttachApn();
+    }
+
+    /** MtkDcTracker EVENT_MD_DATA_RETRY_COUNT_RESET: retry every APN the framework gave up on. */
+    void onMdDataRetryCountReset() {
+        Rlog.i(TAG, "slot " + mSlot + ": modem reset its data retry count");
+        mPhone.getDataNetworkController().onModemDataRetryCountReset();
+    }
+
+    private void resetMdDataRetryCount(String apn) {
+        if (mRadio == null) return;
+        try {
+            mRadio.resetMdDataRetryCount(++mSerial, apn);
+            Rlog.d(TAG, "slot " + mSlot + ": resetMdDataRetryCount " + apn);
+        } catch (RemoteException | RuntimeException e) {
+            Rlog.e(TAG, "slot " + mSlot + ": resetMdDataRetryCount failed: " + e);
+        }
+    }
+
+    /** The voice roaming type goes twice, as MtkServiceStateTracker sends it. */
+    private void sendServiceState(ServiceState ss) {
+        if (mRadio == null) return;
+        NetworkRegistrationInfo cs = ss.getNetworkRegistrationInfo(
+                NetworkRegistrationInfo.DOMAIN_CS, AccessNetworkConstants.TRANSPORT_TYPE_WWAN);
+        NetworkRegistrationInfo ps = ss.getNetworkRegistrationInfo(
+                NetworkRegistrationInfo.DOMAIN_PS, AccessNetworkConstants.TRANSPORT_TYPE_WWAN);
+        int rilVoice = cs != null ? cs.getRegistrationState()
+                : NetworkRegistrationInfo.REGISTRATION_STATE_UNKNOWN;
+        int rilData = ps != null ? ps.getRegistrationState()
+                : NetworkRegistrationInfo.REGISTRATION_STATE_UNKNOWN;
+        try {
+            mRadio.setServiceStateToModem(++mSerial, ss.getState(), ss.getDataRegistrationState(),
+                    ss.getVoiceRoamingType(), ss.getVoiceRoamingType(), rilVoice, rilData);
+        } catch (RemoteException | RuntimeException e) {
+            Rlog.e(TAG, "slot " + mSlot + ": setServiceStateToModem failed: " + e);
+        }
+    }
+
+    /** MtkTelephonyAssist's DataStateController: this SIM's data settings, then the data SIM. */
+    private void syncData() {
+        int sub = mPhone.getSubId();
+        DataSettingsManager settings = mPhone.getDataSettingsManager();
+        if (SubscriptionManager.isValidSubscriptionId(sub) && settings != null) {
+            int data = settings.isDataEnabledForReason(TelephonyManager.DATA_ENABLED_REASON_USER)
+                    ? 1 : 0;
+            int roaming = settings.isDataRoamingEnabled() ? 1 : 0;
+            sendDataSettings(this, data, roaming, KEEP, mtkSetting("domestic_data_roaming", sub),
+                    mtkSetting("international_data_roaming", sub));
+        }
+        // Stock sends the data SIM once, through the first slot.
+        if (mSlot == 0) {
+            sendDataSettings(this, KEEP, KEEP,
+                    SubscriptionManager.getSlotIndex(
+                            SubscriptionManager.getDefaultDataSubscriptionId()), KEEP, KEEP);
+        }
+    }
+
+    /** MediaTek's own roaming switches; nothing sets them here, so they read 0 as on stock. */
+    private int mtkSetting(String name, int sub) {
+        return Settings.Global.getInt(mPhone.getContext().getContentResolver(), name + sub, 0) != 0
+                ? 1 : 0;
+    }
+
+    private static void sendDataSettings(MtkModem modem, int... values) {
+        if (modem.mAssist == null) return;
+        ArrayList<Integer> list = new ArrayList<>(values.length);
+        for (int value : values) list.add(value);
+        try {
+            modem.mAssist.syncDataSettingsToMd(++modem.mSerial, list);
+            Rlog.i(TAG, "slot " + modem.mSlot + ": syncDataSettingsToMd " + list);
+        } catch (RemoteException | RuntimeException e) {
+            Rlog.e(TAG, "slot " + modem.mSlot + ": syncDataSettingsToMd failed: " + e);
+        }
+    }
+
+    private static final class AssistResponse extends IAssistRadioResponse.Stub {
+        @Override
+        public void syncDataSettingsToMdResponse(RadioResponseInfo info) {
+            if (info.error != 0) Rlog.w(TAG, "syncDataSettingsToMd error " + info.error);
+        }
+
+        @Override
+        public void setFdModeResponse(RadioResponseInfo info) {}
+    }
+}
