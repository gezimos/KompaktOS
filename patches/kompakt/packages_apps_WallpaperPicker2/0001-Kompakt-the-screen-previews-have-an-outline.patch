From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Gezim <gezimos@users.noreply.github.com>
Date: Mon, 5 Oct 2026 10:15:00 +0200
Subject: [PATCH 1/1] Kompakt: the screen previews have an outline

---
diff --git a/res/drawable/kompakt_preview_outline.xml b/res/drawable/kompakt_preview_outline.xml
new file mode 100644
--- /dev/null
+++ b/res/drawable/kompakt_preview_outline.xml
@@ -0,0 +1,10 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- Kompakt: an outline around the lock and home screen previews, so their edges show
+     on a white or black wallpaper and it is clear the previews can be swiped. -->
+<shape xmlns:android="http://schemas.android.com/apk/res/android"
+    android:shape="rectangle">
+    <solid android:color="@android:color/transparent" />
+    <stroke
+        android:width="2dp"
+        android:color="?android:attr/textColorPrimary" />
+</shape>
diff --git a/res/layout/wallpaper_preview_card2.xml b/res/layout/wallpaper_preview_card2.xml
--- a/res/layout/wallpaper_preview_card2.xml
+++ b/res/layout/wallpaper_preview_card2.xml
@@ -25,6 +25,8 @@
         android:layout_width="match_parent"
         android:layout_height="match_parent"
         android:layout_gravity="center"
+        android:background="@drawable/kompakt_preview_outline"
+        android:padding="2dp"
         android:clipChildren="false"
         android:importantForAccessibility="no">
 
-- 
2.43.0

