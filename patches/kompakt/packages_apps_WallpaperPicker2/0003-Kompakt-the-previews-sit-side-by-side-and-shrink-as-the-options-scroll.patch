Subject: [PATCH 1/1] Kompakt: the previews sit side by side and shrink as the options scroll

---
diff --git a/res/values/dimens.xml b/res/values/dimens.xml
--- a/res/values/dimens.xml
+++ b/res/values/dimens.xml
@@ -410,9 +410,10 @@
     <dimen name="wallpaper_effect_exit_button_text_size">14sp</dimen>
 
     <!-- Dimensions for the customization picker  -->
-    <!-- Kompakt: one preview height, open or scrolled. -->
-    <dimen name="customization_picker_preview_header_collapsed_height">300dp</dimen>
-    <dimen name="customization_picker_preview_header_expanded_height">300dp</dimen>
+    <!-- Kompakt: side by side previews, smaller once the options scroll. -->
+    <dimen name="customization_picker_preview_header_collapsed_height">180dp</dimen>
+    <dimen name="kompakt_preview_half_gap">8dp</dimen>
+    <dimen name="customization_picker_preview_header_expanded_height">310dp</dimen>
     <dimen name="customization_picker_min_preview_collapsed_height">70dp</dimen>
     <dimen name="customization_picker_min_preview_expanded_height">100dp</dimen>
     <dimen name="customization_picker_max_preview_expanded_height">580dp</dimen>
diff --git a/res/xml/customization_picker_layout_scene.xml b/res/xml/customization_picker_layout_scene.xml
--- a/res/xml/customization_picker_layout_scene.xml
+++ b/res/xml/customization_picker_layout_scene.xml
@@ -23,7 +23,12 @@
         android:id="@+id/transition_primary"
         app:constraintSetStart="@id/expanded_header_primary"
         app:constraintSetEnd="@id/collapsed_header_primary">
-        <!-- Kompakt: no swipe to collapse the previews; a drag scrolls the options. -->
+
+        <OnSwipe
+            app:dragDirection="dragUp"
+            app:onTouchUp="autoComplete"
+            app:touchAnchorId="@+id/bottom_scroll_view"
+            app:touchAnchorSide="top" />
     </Transition>
 
     <ConstraintSet android:id="@+id/expanded_header_primary">
diff --git a/res/xml/preview_pager_motion_scene.xml b/res/xml/preview_pager_motion_scene.xml
--- a/res/xml/preview_pager_motion_scene.xml
+++ b/res/xml/preview_pager_motion_scene.xml
@@ -24,9 +24,7 @@
         app:constraintSetStart="@id/lock_preview_selected"
         app:constraintSetEnd="@id/home_preview_selected"
         app:duration="1">
-        <OnSwipe
-            app:touchAnchorId="@id/lock_preview"
-            app:dragDirection="dragStart" />
+        <!-- Kompakt: no swiping; both previews show side by side. -->
     </Transition>
 
     <!-- Left edge effect transition (when at lock screen and trying to swipe more left) -->
@@ -45,7 +43,7 @@
         app:duration="1"
         motionInterpolator="spring(1.0, 0.4)"/>
 
-    <!-- Lock preview selected -->
+    <!-- Lock preview selected. Kompakt: both states show the previews side by side. -->
     <ConstraintSet android:id="@+id/lock_preview_selected">
         <Constraint
             android:id="@+id/label_placeholder"
@@ -70,10 +68,10 @@
             android:id="@+id/lock_preview"
             android:layout_width="wrap_content"
             android:layout_height="0dp"
+            android:layout_marginEnd="@dimen/kompakt_preview_half_gap"
             app:layout_constraintTop_toBottomOf="@+id/label_placeholder"
             app:layout_constraintBottom_toBottomOf="parent"
-            app:layout_constraintStart_toStartOf="@+id/guideline_center"
-            app:layout_constraintEnd_toEndOf="@+id/guideline_center" />
+            app:layout_constraintEnd_toStartOf="@+id/guideline_center" />
 
         <Constraint
             android:id="@+id/home_preview_label_container"
@@ -88,10 +86,10 @@
             android:id="@+id/home_preview"
             android:layout_width="wrap_content"
             android:layout_height="0dp"
-            android:layout_marginStart="@dimen/handheld_small_preview_space_between_preview"
+            android:layout_marginStart="@dimen/kompakt_preview_half_gap"
             app:layout_constraintTop_toBottomOf="@+id/label_placeholder"
             app:layout_constraintBottom_toBottomOf="parent"
-            app:layout_constraintStart_toEndOf="@+id/lock_preview" />
+            app:layout_constraintStart_toEndOf="@+id/guideline_center" />
     </ConstraintSet>
 
     <!-- Home preview selected -->
@@ -119,10 +117,10 @@
             android:id="@+id/lock_preview"
             android:layout_width="wrap_content"
             android:layout_height="0dp"
-            android:layout_marginEnd="@dimen/handheld_small_preview_space_between_preview"
+            android:layout_marginEnd="@dimen/kompakt_preview_half_gap"
             app:layout_constraintTop_toBottomOf="@+id/label_placeholder"
             app:layout_constraintBottom_toBottomOf="parent"
-            app:layout_constraintEnd_toStartOf="@+id/home_preview" />
+            app:layout_constraintEnd_toStartOf="@+id/guideline_center" />
 
         <Constraint
             android:id="@+id/home_preview_label_container"
@@ -137,10 +135,10 @@
             android:id="@+id/home_preview"
             android:layout_width="wrap_content"
             android:layout_height="0dp"
+            android:layout_marginStart="@dimen/kompakt_preview_half_gap"
             app:layout_constraintTop_toBottomOf="@+id/label_placeholder"
             app:layout_constraintBottom_toBottomOf="parent"
-            app:layout_constraintStart_toStartOf="@+id/guideline_center"
-            app:layout_constraintEnd_toEndOf="@+id/guideline_center" />
+            app:layout_constraintStart_toEndOf="@+id/guideline_center" />
     </ConstraintSet>
 
     <!-- Left edge effect active
diff --git a/src/com/android/wallpaper/picker/customization/ui/CustomizationPickerFragment2.kt b/src/com/android/wallpaper/picker/customization/ui/CustomizationPickerFragment2.kt
--- a/src/com/android/wallpaper/picker/customization/ui/CustomizationPickerFragment2.kt
+++ b/src/com/android/wallpaper/picker/customization/ui/CustomizationPickerFragment2.kt
@@ -526,18 +526,24 @@
         packThemeSuggestedChip: PackThemeSuggestedChip?,
         bottomInset: Int,
     ) {
-        // Kompakt: one fixed preview height, so it neither shrinks on open nor collapses on scroll.
+        // Kompakt: fixed preview heights, so nothing resizes when the page opens.
         wallpaperPickerEntry.configureForAnimation()
-        val headerHeight =
-            resources.getDimensionPixelSize(
-                R.dimen.customization_picker_preview_header_expanded_height
-            )
         pickerMotionContainer
             .getConstraintSet(R.id.collapsed_header_primary)
-            ?.constrainHeight(R.id.preview_header, headerHeight)
+            ?.constrainHeight(
+                R.id.preview_header,
+                resources.getDimensionPixelSize(
+                    R.dimen.customization_picker_preview_header_collapsed_height
+                ),
+            )
         pickerMotionContainer
             .getConstraintSet(R.id.expanded_header_primary)
-            ?.constrainHeight(R.id.preview_header, headerHeight)
+            ?.constrainHeight(
+                R.id.preview_header,
+                resources.getDimensionPixelSize(
+                    R.dimen.customization_picker_preview_header_expanded_height
+                ),
+            )
     }
 
     private fun setMotionLayoutOnTransitionCompleteListener(
