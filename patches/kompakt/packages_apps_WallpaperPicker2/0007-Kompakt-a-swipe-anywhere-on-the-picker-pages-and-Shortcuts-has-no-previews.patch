diff --git a/src/com/kompakt/eink/PagedMotionLayout.java b/src/com/kompakt/eink/PagedMotionLayout.java
new file mode 100644
index 0000000..04ac439
--- /dev/null
+++ b/src/com/kompakt/eink/PagedMotionLayout.java
@@ -0,0 +1,45 @@
+package com.kompakt.eink;
+
+import android.content.Context;
+import android.util.AttributeSet;
+import android.view.GestureDetector;
+import android.view.MotionEvent;
+
+import androidx.constraintlayout.motion.widget.MotionLayout;
+
+/** Kompakt: a swipe anywhere on the picker page turns a page, not only on the options. */
+public class PagedMotionLayout extends MotionLayout {
+
+    /** Moves by delta pages, +1 forward and -1 back; true if anything moved. */
+    public interface Pager {
+        boolean page(int delta);
+    }
+
+    private Pager mPager;
+    private final GestureDetector mDetector;
+
+    public PagedMotionLayout(Context context) {
+        this(context, null);
+    }
+
+    public PagedMotionLayout(Context context, AttributeSet attrs) {
+        this(context, attrs, 0);
+    }
+
+    public PagedMotionLayout(Context context, AttributeSet attrs, int defStyleAttr) {
+        super(context, attrs, defStyleAttr);
+        mDetector = new GestureDetector(context, new PageGestureListener(context,
+                delta -> mPager != null && mPager.page(delta)));
+    }
+
+    public void setPager(Pager pager) {
+        mPager = pager;
+    }
+
+    /** The detector sees every touch first; taps and clicks still reach the children. */
+    @Override
+    public boolean dispatchTouchEvent(MotionEvent ev) {
+        mDetector.onTouchEvent(ev);
+        return super.dispatchTouchEvent(ev);
+    }
+}
