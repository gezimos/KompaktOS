         app:layout_constraintBottom_toBottomOf="@id/toolbar" />
 
-    <androidx.constraintlayout.motion.widget.MotionLayout
+    <com.kompakt.eink.PagedMotionLayout
         android:id="@+id/picker_motion_layout"
         android:layout_width="0dp"
         android:layout_height="0dp"
@@ -228,6 +228,19 @@
             </androidx.constraintlayout.widget.ConstraintLayout>
         </com.kompakt.eink.PagedScrollView>
 
+        <!-- Kompakt: covers the previews on option pages that have nothing to preview. -->
+        <View
+            android:id="@+id/kompakt_preview_cover"
+            android:layout_width="0dp"
+            android:layout_height="0dp"
+            android:background="?android:attr/colorBackground"
+            android:clickable="true"
+            android:visibility="gone"
+            app:layout_constraintTop_toTopOf="parent"
+            app:layout_constraintBottom_toBottomOf="parent"
+            app:layout_constraintStart_toStartOf="parent"
+            app:layout_constraintEnd_toEndOf="parent" />
+
         <FrameLayout
             android:id="@+id/customization_option_floating_sheet_container"
             android:layout_width="0dp"
@@ -235,6 +248,6 @@
             app:layout_constraintStart_toStartOf="parent"
             app:layout_constraintEnd_toEndOf="parent"
             app:layout_constraintTop_toBottomOf="parent" />
-    </androidx.constraintlayout.motion.widget.MotionLayout>
+    </com.kompakt.eink.PagedMotionLayout>
 </androidx.constraintlayout.widget.ConstraintLayout>
 
