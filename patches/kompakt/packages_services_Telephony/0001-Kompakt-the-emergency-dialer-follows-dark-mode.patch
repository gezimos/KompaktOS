@@ -914,10 +911,29 @@ public class EmergencyDialer extends Activity implements View.OnClickListener,
 
     @Override
     public void onColorsChanged(WallpaperColors colors, int which) {
-        if ((which & WallpaperManager.FLAG_LOCK) != 0) {
-            mBackgroundDrawable.setColor(getPrimaryColor(colors));
-            updateTheme(supportsDarkText(colors));
-        }
+        // Kompakt: the wallpaper does not colour this screen.
+    }
+
+    // Kompakt: true when the system is in dark mode.
+    private boolean isNightMode() {
+        return (getResources().getConfiguration().uiMode & Configuration.UI_MODE_NIGHT_MASK)
+                == Configuration.UI_MODE_NIGHT_YES;
+    }
+
+    // Kompakt: the dial button in the two inks, an outlined circle instead of the green disc.
+    private void inkDialButton(ImageButton button) {
+        int ink = isNightMode() ? Color.WHITE : Color.BLACK;
+        int paper = isNightMode() ? Color.BLACK : Color.WHITE;
+        GradientDrawable disc = new GradientDrawable();
+        disc.setShape(GradientDrawable.OVAL);
+        disc.setColor(paper);
+        disc.setStroke((int) TypedValue.applyDimension(TypedValue.COMPLEX_UNIT_DIP, 2,
+                getResources().getDisplayMetrics()), ink);
+        button.setBackground(disc);
+        button.setImageTintList(ColorStateList.valueOf(ink));
+        button.setElevation(0);
+        button.setTranslationZ(0);
+        button.setStateListAnimator(null);
     }
 
