Subject: [PATCH 64/99] Kompakt: the older volume dialog, outlined and smaller

---
 .../volume_dialog_kompakt_outline.xml         |  8 ++++++
 .../res/drawable/volume_row_seekbar.xml       |  4 ++-
 .../res/layout/volume_dialog_legacy.xml       |  1 +
 packages/SystemUI/res/values/config.xml       |  2 +-
 packages/SystemUI/res/values/dimens.xml       | 27 ++++++++++---------
 .../systemui/volume/dagger/VolumeModule.java  |  3 ++-
 6 files changed, 29 insertions(+), 16 deletions(-)
 create mode 100644 packages/SystemUI/res/drawable/volume_dialog_kompakt_outline.xml

diff --git a/packages/SystemUI/res/drawable/volume_dialog_kompakt_outline.xml b/packages/SystemUI/res/drawable/volume_dialog_kompakt_outline.xml
new file mode 100644
index 000000000000..f8b67f4850dd
--- /dev/null
+++ b/packages/SystemUI/res/drawable/volume_dialog_kompakt_outline.xml
@@ -0,0 +1,8 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- Kompakt: one ink outline around the whole volume column, drawn over its pieces. -->
+<shape xmlns:android="http://schemas.android.com/apk/res/android">
+    <solid android:color="@android:color/transparent" />
+    <stroke android:width="@dimen/kompakt_dialog_outline_width"
+        android:color="?android:attr/textColorPrimary" />
+    <corners android:radius="@dimen/volume_dialog_panel_width_half" />
+</shape>
diff --git a/packages/SystemUI/res/drawable/volume_row_seekbar.xml b/packages/SystemUI/res/drawable/volume_row_seekbar.xml
index c47d7c0e8eb1..9e08a479994a 100644
--- a/packages/SystemUI/res/drawable/volume_row_seekbar.xml
+++ b/packages/SystemUI/res/drawable/volume_row_seekbar.xml
@@ -26,7 +26,9 @@
         <shape>
             <size android:height="@dimen/volume_dialog_track_width" />
             <corners android:radius="@dimen/volume_dialog_panel_width_half" />
-            <solid android:color="@androidprv:color/materialColorOutlineVariant" />
+            <solid android:color="?androidprv:attr/colorSurface" />
+            <stroke android:width="@dimen/kompakt_dialog_outline_width"
+                android:color="?android:attr/textColorPrimary" />
         </shape>
     </item>
     <item android:id="@android:id/progress"
diff --git a/packages/SystemUI/res/layout/volume_dialog_legacy.xml b/packages/SystemUI/res/layout/volume_dialog_legacy.xml
index d44b6a8534f2..edf0ba3cf39f 100644
--- a/packages/SystemUI/res/layout/volume_dialog_legacy.xml
+++ b/packages/SystemUI/res/layout/volume_dialog_legacy.xml
@@ -33,6 +33,7 @@
         android:gravity="right"
         android:layout_gravity="right"
         android:layout_marginRight="@dimen/volume_dialog_panel_transparent_padding_right"
+        android:foreground="@drawable/volume_dialog_kompakt_outline"
         android:orientation="vertical"
         android:clipToPadding="false"
         android:clipChildren="false">
diff --git a/packages/SystemUI/res/values/config.xml b/packages/SystemUI/res/values/config.xml
index 7d0d9b5fce3f..83a2338d780d 100644
