+                override val previous: MediaSecondaryActionViewModel
+                    get() = session.leftAction.toSecondaryActionViewModel()
+
+                override val next: MediaSecondaryActionViewModel
+                    get() = session.rightAction.toSecondaryActionViewModel()
+
+                override val onStop: () -> Unit = {
+                    falsingSystem.runIfNotFalseTap(FalsingManager.LOW_PENALTY) {
+                        interactor.hide(session.key, 0L)
+                    }
+                }
             }
         }
     }
