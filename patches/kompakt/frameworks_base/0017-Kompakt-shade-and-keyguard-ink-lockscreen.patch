+/** The icon pair for a tile spec, or null to leave the tile's own drawable alone. */
+fun kompaktTileIcon(spec: String, active: Boolean): ImageVector? {
+    val key =
+        if (spec.startsWith("custom(")) spec.substringAfter("custom(").lowercase() else spec
+    return when {
+        key.startsWith("bt") || key.contains("bluetooth") ->
+            if (active) BluetoothOn else BluetoothOff
+        key.startsWith("flashlight") || key.contains("torch") ->
+            if (active) FlashlightOn else FlashlightOff
+        key.startsWith("airplane") ->
+            if (active) AirplaneOn else AirplaneOff
+        key.startsWith("rotation") ->
+            if (active) ScreenRotationOn else ScreenRotationOff
+        key.startsWith("cast") ->
+            if (active) CastOn else CastOff
+        key.startsWith("saver") || key.startsWith("battery") ->
+            if (active) BatterySaverOn else BatterySaverOff
+        key.startsWith("dnd") || key.startsWith("modes") ->
+            if (active) DoNotDisturbOn else DoNotDisturbOff
+        key.startsWith("alarm") ->
+            if (active) AlarmOn else AlarmOff
+        key.startsWith("location") ->
+            if (active) LocationOn else LocationOff
+        key.startsWith("hotspot") ->
+            if (active) HotspotOn else HotspotOff
+        key.startsWith("dark") ->
+            if (active) DarkModeOn else DarkModeOff
+        key.startsWith("nfc") ->
+            if (active) NfcOn else NfcOff
+        key.startsWith("qr") ->
+            if (active) QrCodeOn else QrCodeOff
+        key.startsWith("screenrecord") ->
+            if (active) VideocamOn else VideocamOff
+        key.startsWith("night") ->
+            if (active) NightlightOn else NightlightOff
+        key.startsWith("inversion") || key.startsWith("color") ->
+            if (active) InvertColorsOn else InvertColorsOff
+        key.startsWith("mictoggle") ->
+            if (active) MicOn else MicOff
+        key.startsWith("cameratoggle") ->
+            if (active) PhotoCameraOn else PhotoCameraOff
+        key.startsWith("screenshot") ->
+            if (active) ScreenshotOn else ScreenshotOff
+        key.startsWith("wallet") ->
+            if (active) WalletOn else WalletOff
+        key.startsWith("controls") ->
+            if (active) WidgetsOn else WidgetsOff
+        key.contains("einktileservice") ->
+            if (active) EinkModeOn else EinkModeOff
+        key.contains("refreshtileservice") ->
+            if (active) RefreshOn else RefreshOff
+        key.contains("esimtileservice") ->
+            if (active) SimCardOn else SimCardOff
+        else -> null
+    }
+}
