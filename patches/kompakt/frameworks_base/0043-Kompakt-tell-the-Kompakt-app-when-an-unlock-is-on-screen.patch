From da187192b4b434d63cefd17a954b9e0411520b25 Mon Sep 17 00:00:00 2001
From: Gezim <gezimos@users.noreply.github.com>
Date: Mon, 28 Sep 2026 13:10:00 +0200
Subject: [PATCH 43/99] Kompakt: tell the Kompakt app when an unlock is on
 screen

---
 .../keyguard/mediator/ScreenOnCoordinator.kt   | 14 ++++++++++++++
 .../android/server/wm/KompaktUnlockHold.java   | 18 ++++++++++++++++++
 2 files changed, 32 insertions(+)

diff --git a/packages/SystemUI/src/com/android/keyguard/mediator/ScreenOnCoordinator.kt b/packages/SystemUI/src/com/android/keyguard/mediator/ScreenOnCoordinator.kt
index c6ec85fd5df0..6f2c93186144 100644
--- a/packages/SystemUI/src/com/android/keyguard/mediator/ScreenOnCoordinator.kt
+++ b/packages/SystemUI/src/com/android/keyguard/mediator/ScreenOnCoordinator.kt
@@ -17,7 +17,10 @@
 package com.android.keyguard.mediator
 
 import android.annotation.BinderThread
+import android.content.Context
+import android.content.Intent
 import android.os.Handler
+import android.os.UserHandle
 import android.os.Trace
 import android.util.Log
 import android.view.Choreographer
@@ -65,6 +68,7 @@ constructor(
     private val keyguardInteractor: Lazy<KeyguardInteractor>,
     @Application private val applicationScope: CoroutineScope,
     @Main private val mainDispatcher: CoroutineDispatcher,
+    @Application private val context: Context,
 ) {
 
     private val foldAodAnimationController =
@@ -119,6 +123,16 @@ constructor(
                         }
                     Log.i(TAG, "Kompakt wake-and-unlock hold released, gone=" + (reached != null))
                     done.run()
+                    // Tells the Kompakt app the unlocked screen is showing, for its optional refresh.
+                    if (reached != null) {
+                        context.sendBroadcastAsUser(
+                            Intent("com.kompakt.service.action.UNLOCKED")
+                                .setPackage("com.kompakt.service")
+                                .putExtra("from", "sleep")
+                                .addFlags(Intent.FLAG_RECEIVER_FOREGROUND),
+                            UserHandle.CURRENT,
+                        )
+                    }
                 }
         }
 
diff --git a/services/core/java/com/android/server/wm/KompaktUnlockHold.java b/services/core/java/com/android/server/wm/KompaktUnlockHold.java
index 672651fb75f7..7a1403a4e37e 100644
--- a/services/core/java/com/android/server/wm/KompaktUnlockHold.java
+++ b/services/core/java/com/android/server/wm/KompaktUnlockHold.java
@@ -16,9 +16,11 @@
 
 package com.android.server.wm;
 
+import android.content.Intent;
 import android.graphics.Rect;
 import android.hardware.HardwareBuffer;
 import android.os.SystemProperties;
+import android.os.UserHandle;
 import android.util.Slog;
 import android.view.Display;
 import android.view.SurfaceControl;
@@ -35,6 +37,7 @@ class KompaktUnlockHold {
 
     private final WindowManagerService mWmService;
     private SurfaceControl mLayer;
+    private String mHoldReason;
 
     private final Runnable mTimeout = () -> {
         synchronized (KompaktUnlockHold.this.mWmService.mGlobalLock) {
@@ -91,6 +94,7 @@ class KompaktUnlockHold {
         buffer.close();
 
         mLayer = layer;
+        mHoldReason = reason;
         mWmService.mH.postDelayed(mTimeout, TIMEOUT_MS);
         Slog.i(TAG, "hold: " + reason);
     }
@@ -111,5 +115,19 @@ class KompaktUnlockHold {
         t.close();
         mLayer = null;
         Slog.i(TAG, "release: " + reason);
+        if (!"keyguard shown".equals(reason)) {
+            sendUnlocked("keyguard hidden".equals(mHoldReason) ? "aod" : "lockscreen");
+        }
+    }
+
+    /** Tells the Kompakt app that the unlocked screen is showing, for its optional refresh. */
+    private void sendUnlocked(String from) {
+        final Intent intent = new Intent("com.kompakt.service.action.UNLOCKED")
+                .setPackage("com.kompakt.service")
+                .putExtra("from", from)
+                .addFlags(Intent.FLAG_RECEIVER_FOREGROUND);
+        // Posted: this runs with the global lock held.
+        mWmService.mH.post(
+                () -> mWmService.mContext.sendBroadcastAsUser(intent, UserHandle.CURRENT));
     }
 }
-- 
