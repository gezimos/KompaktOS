@@ -711,7 +711,8 @@ private fun StatusMessage(viewModel: BouncerMessageViewModel, modifier: Modifier
     Crossfade(
         targetState = message,
         label = "Bouncer message",
-        animationSpec = if (message?.isUpdateAnimated == true) tween() else snap(),
+        // Kompakt: the message changes in one frame too.
+        animationSpec = snap(),
         modifier = modifier.fillMaxWidth(),
     ) { msg ->
         // Kompakt: centre wrapped lines too, and keep off the panel edges.
@@ -803,8 +804,9 @@ private fun InputArea(
 private fun ActionArea(viewModel: BouncerOverlayContentViewModel, modifier: Modifier = Modifier) {
     val actionButton: BouncerActionButtonModel? by
         viewModel.actionButton.collectAsStateWithLifecycle()
-    val appearFadeInAnimatable = remember { Animatable(0f) }
-    val appearMoveAnimatable = remember { Animatable(0f) }
+    // Kompakt: the emergency button is there with the pad, not 133 ms late and sliding.
+    val appearFadeInAnimatable = remember { Animatable(1f) }
+    val appearMoveAnimatable = remember { Animatable(1f) }
     val appearAnimationInitialOffset = with(LocalDensity.current) { 80.dp.toPx() }
 
     actionButton?.let { actionButtonModel ->
diff --git a/packages/SystemUI/compose/features/src/com/android/systemui/bouncer/ui/composable/PinBouncer.kt b/packages/SystemUI/compose/features/src/com/android/systemui/bouncer/ui/composable/PinBouncer.kt
