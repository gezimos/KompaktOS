@@ -25,7 +26,8 @@ import com.android.systemui.bouncer.ui.composable.Bouncer
 val BOUNCER_INITIAL_TRANSLATION = 48.dp
 
 fun TransitionBuilder.fromBouncerTransition() {
-    spec = tween(durationMillis = 500)
