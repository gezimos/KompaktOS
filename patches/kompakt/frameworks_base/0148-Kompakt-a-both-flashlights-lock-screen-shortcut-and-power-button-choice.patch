-    // Kompakt: the power button may switch the warm flash LED, which the Kompakt app owns.
+    // Kompakt: the power button may switch the warm flash LED, or both, which the Kompakt app owns.
+    private String kompaktPowerTorch() {
+        return Settings.Global.getString(mContext.getContentResolver(), "kompakt_power_torch");
+    }
+
     private boolean kompaktWarmTorch() {
-        return "warm".equals(Settings.Global.getString(mContext.getContentResolver(),
-                "kompakt_power_torch"));
+        final String torch = kompaktPowerTorch();
+        return "warm".equals(torch) || "both".equals(torch);
     }
 
     private boolean kompaktWarmTorchOn() {
@@ -7555,7 +7559,9 @@ public class PhoneWindowManager implements WindowManagerPolicy {
     private void toggleTorch() {
         cancelTorchOff();
         if (kompaktWarmTorch()) {
-            mContext.sendBroadcastAsUser(new Intent("com.kompakt.service.action.TORCH_WARM")
+            final String action = "both".equals(kompaktPowerTorch())
+                    ? "com.kompakt.service.action.TORCH_BOTH" : "com.kompakt.service.action.TORCH_WARM";
+            mContext.sendBroadcastAsUser(new Intent(action)
                     .setPackage("com.kompakt.service")
                     .addFlags(Intent.FLAG_RECEIVER_FOREGROUND), UserHandle.SYSTEM);
             return;
