diff --git a/packages/SystemUI/src/com/android/systemui/keyguard/data/quickaffordance/BothFlashlightsQuickAffordanceConfig.kt b/packages/SystemUI/src/com/android/systemui/keyguard/data/quickaffordance/BothFlashlightsQuickAffordanceConfig.kt
