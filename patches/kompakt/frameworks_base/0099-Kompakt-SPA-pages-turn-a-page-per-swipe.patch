+/*
+ * Kompakt: SPA pages and lists turn a page per swipe, as the rest of Settings does on e-ink.
+ */
+
+package com.android.settingslib.spa.framework.compose
+
+import androidx.compose.foundation.ScrollState
+import androidx.compose.foundation.gestures.detectVerticalDragGestures
+import androidx.compose.foundation.gestures.scrollBy
+import androidx.compose.foundation.lazy.LazyListState
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.rememberCoroutineScope
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.input.pointer.pointerInput
+import androidx.compose.ui.platform.LocalDensity
+import androidx.compose.ui.unit.dp
+import kotlin.math.abs
+import kotlinx.coroutines.launch
+
+/** Drag distance that turns a page, as the PageGestureListener in Settings. */
+private val KompaktPageDrag = 56.dp
+
+/** A drag turns pages; the list itself takes no drag (pair with userScrollEnabled = false). */
+@Composable
+fun Modifier.kompaktPaged(state: LazyListState): Modifier {
+    val scope = rememberCoroutineScope()
+    val threshold = with(LocalDensity.current) { KompaktPageDrag.toPx() }
+    return kompaktPageGesture(threshold) { forward -> scope.launch { state.kompaktPage(forward) } }
+}
+
+/** A drag turns pages of a scrolling column (pair with verticalScroll(state, enabled = false)). */
+@Composable
+fun Modifier.kompaktPaged(state: ScrollState): Modifier {
+    val scope = rememberCoroutineScope()
+    val threshold = with(LocalDensity.current) { KompaktPageDrag.toPx() }
+    return kompaktPageGesture(threshold) { forward ->
+        scope.launch {
+            val step = if (forward) state.viewportSize else -state.viewportSize
+            state.scrollTo((state.value + step).coerceIn(0, state.maxValue))
+        }
+    }
+}
+
+private fun Modifier.kompaktPageGesture(threshold: Float, page: (Boolean) -> Unit): Modifier =
+    pointerInput(threshold) {
+        var travelled = 0f
+        detectVerticalDragGestures(
+            onDragStart = { travelled = 0f },
+            onVerticalDrag = { change, dy ->
+                change.consume()
+                travelled += dy
+                // Each threshold of travel turns one page, as inkOS and Settings do.
+                if (abs(travelled) > threshold) {
+                    page(travelled < 0)
+                    travelled = 0f
+                }
+            },
+        )
+    }
+
+/** Forward: to the first row the bottom edge cuts. Back: a viewport up, the top row whole. */
+private suspend fun LazyListState.kompaktPage(forward: Boolean) {
+    val info = layoutInfo
+    val visible = info.visibleItemsInfo
+    if (visible.isEmpty()) return
+    val viewport = (info.viewportEndOffset - info.viewportStartOffset).toFloat()
+    if (forward) {
+        val end = info.viewportEndOffset - info.afterContentPadding
+        val cut = visible.firstOrNull { it.offset + it.size > end && it.index > firstVisibleItemIndex }
+        if (cut != null) scrollToItem(cut.index) else scrollBy(viewport)
+    } else {
+        scrollBy(-viewport)
+        if (firstVisibleItemScrollOffset > 0) scrollToItem(firstVisibleItemIndex)
+    }
+}
