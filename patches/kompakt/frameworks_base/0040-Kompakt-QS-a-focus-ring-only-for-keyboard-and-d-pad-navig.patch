         drawContent()
         val focusOutline = Rect(Offset.Zero, size).inflate(padding.toPx())
-        if (focused) {
+        // Kompakt: a focus ring only for keyboard and fingerprint d-pad navigation.
+        val keyboard = currentValueOf(LocalInputModeManager).inputMode == InputMode.Keyboard
+        if (focused && keyboard) {
             drawRoundRect(
                 color = color,
                 topLeft = focusOutline.topLeft,
