From 4fdf6e434b555e1fee06da4766b2393b4655346c Mon Sep 17 00:00:00 2001
From: gezimos <>
Date: Sun, 27 Sep 2026 16:00:00 +0200
Subject: [PATCH 42/99] Kompakt: the keys under the screen can stop vibrating

---
 .../java/com/android/server/policy/PhoneWindowManager.java  | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/services/core/java/com/android/server/policy/PhoneWindowManager.java b/services/core/java/com/android/server/policy/PhoneWindowManager.java
index 53d0b2845235..3a78c025524f 100644
--- a/services/core/java/com/android/server/policy/PhoneWindowManager.java
+++ b/services/core/java/com/android/server/policy/PhoneWindowManager.java
@@ -5168,6 +5168,12 @@ public class PhoneWindowManager implements WindowManagerPolicy {
                 && (!isNavBarVirtKey || mNavBarVirtualKeyHapticFeedbackEnabled ||
                         event.getDeviceId() > 0)
                 && event.getRepeatCount() == 0;
+        // Kompakt: the keys under the screen vibrate unless the Kompakt app turned it off.
+        if (useHapticFeedback && event.getDeviceId() > 0 && Settings.Secure.getIntForUser(
+                mContext.getContentResolver(), "kompakt_key_vibration", 1,
+                UserHandle.USER_CURRENT) == 0) {
+            useHapticFeedback = false;
+        }
 
         // Specific device key handling
         if (dispatchKeyToKeyHandlers(event)) {
-- 
