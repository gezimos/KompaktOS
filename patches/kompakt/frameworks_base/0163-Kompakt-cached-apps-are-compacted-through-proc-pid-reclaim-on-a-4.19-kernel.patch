From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Gezim <gezimos@users.noreply.github.com>
Date: Sun, 9 Nov 2026 07:00:00 +0200
Subject: [PATCH] Kompakt: cached apps are compacted through /proc/<pid>/reclaim on a 4.19 kernel

---
diff --git a/services/core/jni/com_android_server_am_CachedAppOptimizer.cpp b/services/core/jni/com_android_server_am_CachedAppOptimizer.cpp
index 0000000..0000000 100644
--- a/services/core/jni/com_android_server_am_CachedAppOptimizer.cpp
+++ b/services/core/jni/com_android_server_am_CachedAppOptimizer.cpp
@@ -26,6 +26,7 @@
 #include <android_runtime/AndroidRuntime.h>
 #include <cutils/compiler.h>
 #include <dirent.h>
+#include <fcntl.h>
 #include <jni.h>
 #include <linux/errno.h>
 #include <linux/time.h>
@@ -65,6 +66,29 @@ using android::base::unique_fd;
 
 #define MAX_RW_COUNT (INT_MAX & kPageMask)
 
+// Kompakt: a 4.19 kernel has no process_madvise(). It has Android's own /proc/<pid>/reclaim,
+// which pages out a process's anonymous memory ("anon"), deactivates its file pages ("file")
+// or both ("all"): what MADV_PAGEOUT and MADV_COLD do per VMA below, for the whole process.
+static bool processMadviseAvailable() {
+    static const bool available = [] {
+        // An invalid pidfd and no VMAs: a kernel with the syscall answers EBADF, one without it ENOSYS.
+        struct iovec none = {nullptr, 0};
+        if (process_madvise(-1, &none, 0, MADV_PAGEOUT, 0) == 0) return true;
+        bool ok = errno != ENOSYS;
+        if (!ok) ALOGI("no process_madvise in this kernel; compaction goes through /proc/<pid>/reclaim");
+        return ok;
+    }();
+    return available;
+}
+
+static void reclaimProcess(int pid, const char* what) {
+    std::string path = StringPrintf("/proc/%d/reclaim", pid);
+    unique_fd fd(TEMP_FAILURE_RETRY(open(path.c_str(), O_WRONLY | O_CLOEXEC)));
+    if (fd < 0 || !android::base::WriteStringToFd(what, fd)) {
+        ALOGW("reclaim %s of %d failed: %s", what, pid, strerror(errno));
+    }
+}
+
 // Defines the maximum amount of VMAs we can send per process_madvise syscall.
 // Currently this is set to UIO_MAXIOV which is the maximum segments allowed by
 // iovec implementation used by process_madvise syscall
@@ -415,6 +439,11 @@ static void compactProcess(int pid, int compactionFlags) {
     bool compactAnon = compactionFlags & COMPACT_ACTION_ANON_FLAG;
     bool compactFile = compactionFlags & COMPACT_ACTION_FILE_FLAG;
 
+    if (!processMadviseAvailable()) {
+        reclaimProcess(pid, compactAnon ? (compactFile ? "all" : "anon") : "file");
+        return;
+    }
+
     VmaToAdviseFunc vmaToAdviseFunc;
 
     if (compactAnon) {
