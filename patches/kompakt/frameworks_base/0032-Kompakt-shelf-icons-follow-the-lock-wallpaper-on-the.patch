From: gezimos <>
Date: Wed, 23 Sep 2026 11:05:00 +0200
Subject: [PATCH 32/38] Kompakt: shelf icons follow the lock wallpaper on the
 keyguard

---
 .../src/com/android/systemui/statusbar/NotificationShelf.java | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/packages/SystemUI/src/com/android/systemui/statusbar/NotificationShelf.java b/packages/SystemUI/src/com/android/systemui/statusbar/NotificationShelf.java
index fd20a01b7e2b..04a22a18c273 100644
--- a/packages/SystemUI/src/com/android/systemui/statusbar/NotificationShelf.java
+++ b/packages/SystemUI/src/com/android/systemui/statusbar/NotificationShelf.java
@@ -57,6 +57,7 @@ import com.android.systemui.statusbar.notification.shared.NotificationMinimalism
 import com.android.systemui.statusbar.notification.shelf.NotificationShelfBackgroundView;
 import com.android.systemui.statusbar.notification.shelf.NotificationShelfIconContainer;
 import com.android.systemui.statusbar.notification.stack.AmbientState;
+import com.android.systemui.wallpapers.KompaktInk;
 import com.android.systemui.statusbar.notification.stack.AnimationProperties;
 import com.android.systemui.statusbar.notification.stack.ExpandableViewState;
 import com.android.systemui.statusbar.notification.stack.NotificationRoundnessManager;
@@ -567,6 +568,9 @@ public class NotificationShelf extends ActivatableNotificationView {
 
         // TODO(b/172289889) transition last icon in shelf to notification icon and vice versa.
         setVisibility(isHidden ? View.INVISIBLE : View.VISIBLE);
+        // Kompakt: on the keyguard the shelf sits on the lock wallpaper, not the shade.
+        mShelfIcons.setUseInverseOverrideIconColor(
+                mAmbientState.isOnKeyguard() && KompaktInk.isDarkSurface(getContext()));
         mShelfIcons.calculateIconXTranslations();
         mShelfIcons.applyIconStates();
         for (int i = 0; i < getHostLayoutChildCount(); i++) {
