 ) {
 
     private val foldAodAnimationController =
@@ -51,6 +73,9 @@ constructor(
         unfoldComponent.map(SysUIUnfoldComponent::getFullScreenLightRevealAnimations).getOrNull()
     private val pendingTasks = PendingTasksContainer()
 
+    /** Kompakt: the wake-and-unlock hold, see [onScreenTurningOn]. */
+    private var kompaktHoldJob: Job? = null
+
     /**
      * When turning on, registers tasks that may need to run before invoking [onDrawn]. This is
      * called on a binder thread from [com.android.systemui.keyguard.KeyguardService].
@@ -59,6 +84,8 @@ constructor(
     fun onScreenTurningOn(reason: Int, onDrawn: Runnable) {
         Trace.beginSection("ScreenOnCoordinator#onScreenTurningOn")
 
+        kompaktHoldJob?.cancel()
+        kompaktHoldJob = null
         pendingTasks.reset()
 
         foldAodAnimationController?.onScreenTurningOn(pendingTasks.registerTask("fold-to-aod"))
@@ -71,6 +98,30 @@ constructor(
                 pendingTasks.registerTask("pending-display-change-controller"));
         }
 
+        // Kompakt: on a wake-and-unlock, hold the screen until the keyguard is gone.
+        if (SceneContainerFlag.isEnabled &&
+            BiometricUnlockMode.isWakeAndUnlock(
+                keyguardInteractor.get().biometricUnlockState.value.mode
+            )
+        ) {
+            val done = pendingTasks.registerTask("kompakt-wake-and-unlock-gone")
+            kompaktHoldJob =
+                applicationScope.launch(mainDispatcher) {
+                    val reached =
+                        withTimeoutOrNull(WAKE_AND_UNLOCK_GONE_TIMEOUT_MS) {
+                            sceneInteractor.get().transitionState.first {
+                                it is ObservableTransitionState.Idle &&
+                                    it.currentScene == Scenes.Gone
+                            }
+                            // Two frames: the first draws Gone, the second commits it.
+                            awaitFrame()
+                            awaitFrame()
+                        }
+                    Log.i(TAG, "Kompakt wake-and-unlock hold released, gone=" + (reached != null))
+                    done.run()
+                }
+        }
+
         pendingTasks.onTasksComplete {
             if (Flags.enableBackgroundKeyguardOndrawnCallback()) {
                 // called by whatever thread completes the last task registered.
@@ -93,6 +144,20 @@ constructor(
 
     @BinderThread
     fun onScreenTurnedOff() {
+        kompaktHoldJob?.cancel()
+        kompaktHoldJob = null
         pendingTasks.reset()
     }
+
+    private suspend fun awaitFrame() =
+        suspendCancellableCoroutine<Unit> { cont ->
+            val callback = Choreographer.FrameCallback { if (cont.isActive) cont.resume(Unit) }
+            Choreographer.getInstance().postFrameCallback(callback)
+            cont.invokeOnCancellation { Choreographer.getInstance().removeFrameCallback(callback) }
+        }
+
+    companion object {
+        private const val TAG = "ScreenOnCoordinator"
+        private const val WAKE_AND_UNLOCK_GONE_TIMEOUT_MS = 1200L
+    }
 }
