+        val barsWidth = run {
+            val unit = batterySize.height / 18f
+            val fiveBar = (batterySize.width - 16f * unit) / 5f
+            (batterySize.width - fiveBar - 2f * unit).roundToInt()
+        }
         val batteryFramePlaceable =
             batteryFrame.measure(
                 constraints =
@@ -302,12 +328,16 @@ class BatteryMeasurePolicy : MeasurePolicy {
                         minWidth =
