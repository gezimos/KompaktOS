                                 batterySize.height.roundToInt()
+                            } else if (batteryFrame.layoutId == LayoutId.FrameBars) {
+                                barsWidth
                             } else {
                                 batterySize.width.roundToInt()
                             },
                         maxWidth =
                             if (batteryFrame.layoutId == LayoutId.FrameCircle) {
                                 batterySize.height.roundToInt()
+                            } else if (batteryFrame.layoutId == LayoutId.FrameBars) {
+                                barsWidth
                             } else {
                                 batterySize.width.roundToInt()
                             },
@@ -418,6 +448,47 @@ class BatteryMeasurePolicy : MeasurePolicy {
     }
 }
 
+/**
+ * Kompakt: MuditaOS's battery: an outline with up to four bars, one per 25%. Stroke, gaps and
+ * corners keep the proportions of its 31.5x18 body, scaled to the height it is given.
+ */
+@Composable
+fun BarsBatteryBody(
+    levelProvider: () -> Int?,
+    colorsProvider: () -> BatteryColors,
+    modifier: Modifier = Modifier,
+    contentDescription: String = "",
+) {
+    Canvas(modifier = modifier, contentDescription = contentDescription) {
+        val level = levelProvider()
+        val ink = colorsProvider().attribution
+        val unit = size.height / 18f
+        val stroke = 2f * unit
+        drawRoundRect(
+            ink,
+            topLeft = Offset(stroke / 2f, stroke / 2f),
+            size = Size(size.width - stroke, size.height - stroke),
+            cornerRadius = CornerRadius(2f * unit),
+            style = Stroke(stroke),
+        )
+        // Any charge in a quarter shows that quarter; only 0 is an empty outline.
+        val bars = if (level == null) 0 else ((level + 24) / 25).coerceIn(0, 4)
+        val gap = 2f * unit
+        val barWidth = (size.width - 2f * stroke - 5f * gap) / 4f
+        val barHeight = size.height - 2f * stroke - 2f * gap
+        val rtl = layoutDirection == LayoutDirection.Rtl
+        for (i in 0 until bars) {
+            val x = stroke + gap + i * (barWidth + gap)
+            drawRoundRect(
+                ink,
+                topLeft = Offset(if (rtl) size.width - x - barWidth else x, stroke + gap),
+                size = Size(barWidth, barHeight),
+                cornerRadius = CornerRadius(0.5f * unit),
+            )
+        }
+    }
+}
