From 9c1cb1f2b92fe6445daa81ce7194f0879ee3a703 Mon Sep 17 00:00:00 2001
From: Gezim <gezimos@users.noreply.github.com>
Date: Sat, 24 Oct 2026 12:00:00 +0300
Subject: [PATCH 123/144] Kompakt: apps held at boot are not started for
 background broadcasts

0122 holds BOOT_COMPLETED back from apps not needed at boot, but the
same apps were still started in the first minutes by every other
broadcast: storage mounted, Bluetooth and network changes, widget
updates, pushes. Two boot traces of 382 showed 75-80 process starts
and 40-42 lowmemorykiller kills in three minutes.

While an app's BOOT_COMPLETED is held, a broadcast queue for one of its
uids with no running process is not runnable, unless it holds an
ordered, result-awaiting, alarm or interactive broadcast. The hold ends
with the BOOT_COMPLETED hold: when the app first starts for any other
reason (opened, a provider or a service) or at its turn two minutes
after boot. Nothing is dropped; queued broadcasts are delivered then.
---
 .../server/am/ActivityManagerService.java     | 39 ++++++++++++++++---
 .../server/am/BroadcastProcessQueue.java      | 17 +++++++-
 .../com/android/server/am/BroadcastQueue.java |  7 ++++
 .../android/server/am/BroadcastQueueImpl.java |  8 ++++
 4 files changed, 65 insertions(+), 6 deletions(-)

diff --git a/services/core/java/com/android/server/am/ActivityManagerService.java b/services/core/java/com/android/server/am/ActivityManagerService.java
index 7da04fd0d60a..4d03f6246199 100644
--- a/services/core/java/com/android/server/am/ActivityManagerService.java
+++ b/services/core/java/com/android/server/am/ActivityManagerService.java
@@ -1612,6 +1612,9 @@ public class ActivityManagerService extends IActivityManager.Stub
     // Kompakt: packages whose BOOT_COMPLETED waits (UserController); first start sends it sooner.
     @GuardedBy("this")
     private final ArraySet<String> mKompaktBootCompletedPending = new ArraySet<String>();
+    // Kompakt: their uids; background broadcasts that would start them wait too.
+    @GuardedBy("this")
+    private final SparseArray<String> mKompaktBootHeldUids = new SparseArray<>();
 
     /**
      * Whether to force background check on all apps (for battery saver) or not.
@@ -5189,10 +5192,12 @@ public class ActivityManagerService extends IActivityManager.Stub
 
         // Kompakt: a package whose BOOT_COMPLETED was held back gets it when it first starts.
         if (app.userId == UserHandle.USER_SYSTEM && !isRestrictedBackupMode
-                && mKompaktBootCompletedPending.remove(app.info.packageName)
-                && StorageManager.isCeStorageUnlocked(app.userId)) {
-            sendBootBroadcastToAppLocked(app, new Intent(Intent.ACTION_BOOT_COMPLETED),
-                    REASON_BOOT_COMPLETED);
+                && mKompaktBootCompletedPending.remove(app.info.packageName)) {
+            kompaktReleaseBootHoldLocked(app.info.packageName);
+            if (StorageManager.isCeStorageUnlocked(app.userId)) {
+                sendBootBroadcastToAppLocked(app, new Intent(Intent.ACTION_BOOT_COMPLETED),
+                        REASON_BOOT_COMPLETED);
+            }
         }
 
         final UserManagerInternal umInternal =
@@ -5261,12 +5266,36 @@ public class ActivityManagerService extends IActivityManager.Stub
         synchronized (this) {
             mKompaktBootCompletedPending.clear();
             mKompaktBootCompletedPending.addAll(packages);
+            for (String packageName : packages) {
+                final int uid = getPackageManagerInternal().getPackageUid(packageName,
+                        /*flags=*/ 0, UserHandle.USER_SYSTEM);
+                if (uid < 0) continue;
+                mKompaktBootHeldUids.put(uid, packageName);
+                mBroadcastQueue.kompaktSetBootHold(uid, true);
+            }
         }
     }
 
     boolean kompaktTakeBootCompletedPending(String packageName) {
         synchronized (this) {
-            return mKompaktBootCompletedPending.remove(packageName);
+            if (!mKompaktBootCompletedPending.remove(packageName)) return false;
+            kompaktReleaseBootHoldLocked(packageName);
+            return true;
+        }
+    }
+
+    @GuardedBy("this")
+    boolean kompaktIsBootHeldLocked(int uid) {
+        return mKompaktBootHeldUids.indexOfKey(uid) >= 0;
+    }
+
+    @GuardedBy("this")
+    private void kompaktReleaseBootHoldLocked(String packageName) {
+        for (int i = mKompaktBootHeldUids.size() - 1; i >= 0; i--) {
+            if (!packageName.equals(mKompaktBootHeldUids.valueAt(i))) continue;
+            final int uid = mKompaktBootHeldUids.keyAt(i);
+            mKompaktBootHeldUids.removeAt(i);
+            mBroadcastQueue.kompaktSetBootHold(uid, false);
         }
     }
 
