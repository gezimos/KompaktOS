+    /**
+     * Kompakt: a sleeping phone never keeps the LOCKSCREEN keyguard state, whatever order the scene
+     * transitions arrived in. Once nothing has moved for a moment, it goes to the asleep state.
+     */
+    private fun listenForSleepStateMismatch() {
+        applicationScope.launch {
+            combine(
+                    powerInteractor.isAsleep,
+                    sceneInteractor.transitionState,
+                    transitionInteractor.currentKeyguardState,
+                ) { asleep, scene, state ->
+                    Triple(asleep, scene, state)
+                }
+                .collectLatest { (asleep, scene, state) ->
+                    val idleOnLockscreen =
+                        scene is ObservableTransitionState.Idle &&
+                            scene.currentScene == Scenes.Lockscreen &&
+                            scene.currentOverlays.isEmpty()
+                    if (!asleep || !idleOnLockscreen || state != LOCKSCREEN) return@collectLatest
+                    delay(SLEEP_SETTLE_MS)
+                    if (currentTransitionId != null) return@collectLatest
+                    val target = keyguardInteractor.asleepKeyguardState.value
+                    Log.w(TAG, "asleep in LOCKSCREEN, moving to $target")
+                    finishReversedTransitionTo(target)
+                }
+        }
+    }
+
     private suspend fun handleIdle(
         prevTransition: ObservableTransitionState,
         idle: ObservableTransitionState.Idle,
@@ -244,4 +282,9 @@ constructor(
             RUNNING,
         )
     }
+
+    private companion object {
+        const val TAG = "KompaktKeyguard"
+        const val SLEEP_SETTLE_MS = 400L
+    }
 }
