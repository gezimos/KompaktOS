From 2dc2c30527ed8faf8d478a71ab70b03b9286fd25 Mon Sep 17 00:00:00 2001
From: Gezim <gezimos@users.noreply.github.com>
Date: Tue, 6 Oct 2026 16:00:00 +0200
Subject: [PATCH 66/99] Kompakt: notification app icons use the app's
 monochrome icon

---
 .../notification/row/icon/AppIconProvider.kt    | 17 ++++++++++-------
 1 file changed, 10 insertions(+), 7 deletions(-)

diff --git a/packages/SystemUI/src/com/android/systemui/statusbar/notification/row/icon/AppIconProvider.kt b/packages/SystemUI/src/com/android/systemui/statusbar/notification/row/icon/AppIconProvider.kt
index 39871d138234..4b2b72f23821 100644
--- a/packages/SystemUI/src/com/android/systemui/statusbar/notification/row/icon/AppIconProvider.kt
+++ b/packages/SystemUI/src/com/android/systemui/statusbar/notification/row/icon/AppIconProvider.kt
@@ -19,7 +19,6 @@ package com.android.systemui.statusbar.notification.row.icon
 import android.annotation.WorkerThread
 import android.app.ActivityManager
 import android.app.Flags
-import android.app.Flags.notificationsRedesignThemedAppIcons
 import android.content.Context
 import android.content.pm.PackageManager.MATCH_UNINSTALLED_PACKAGES
 import android.content.pm.PackageManager.NameNotFoundException
@@ -86,6 +85,9 @@ interface AppIconProvider {
     fun purgeCache(wantedPackages: Collection<String>)
 }
 
+/** Kompakt: themed notification app icons, on in place of the experiment flag. */
+private const val KOMPAKT_THEMED_APP_ICONS = true
+
 @SysUISingleton
 class AppIconProviderImpl
 @Inject
@@ -118,19 +120,20 @@ constructor(
                 fullResIconDpi = densityDpi,
                 iconBitmapSize = iconSize,
                 // Initialize the controller so that we can support themed icons.
+                // Kompakt: the app's own monochrome icon, in the ink on the card colour.
                 themeController =
-                    if (notificationsRedesignThemedAppIcons())
+                    if (KOMPAKT_THEMED_APP_ICONS)
                         MonoIconThemeController(
-                            shouldForceThemeIcon = true,
+                            shouldForceThemeIcon = false,
                             colorProvider = { ctx ->
                                 val res = ctx.resources
                                 intArrayOf(
-                                    /* background */ res.getColor(R.color.materialColorPrimary),
-                                    /* icon */ res.getColor(
+                                    /* background */ res.getColor(
                                         R.color.materialColorSurfaceContainerHigh
                                     ),
+                                    /* icon */ res.getColor(R.color.materialColorPrimary),
                                     /* adaptive background */ res.getColor(
-                                        R.color.materialColorPrimary
+                                        R.color.materialColorSurfaceContainerHigh
                                     ),
                                 )
                             },
@@ -174,7 +177,7 @@ constructor(
             userHandle = userHandle,
             drawableInstanceKey = instanceKey,
             createDrawable = {
-                it.createIconDrawable(themed = notificationsRedesignThemedAppIcons())
+                it.createIconDrawable(themed = KOMPAKT_THEMED_APP_ICONS)
             },
         ) {
             fetchAppIconBitmapInfo(
