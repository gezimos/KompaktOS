+    // Kompakt: as isValidMapping, but the brightness may go down as the lux goes up.
+    private static boolean isValidFrontlightCurve(float[] x, float[] y) {
+        if (x == null || y == null || x.length == 0 || x.length != y.length) {
+            return false;
+        }
+        for (int i = 0; i < x.length; i++) {
+            if (Float.isNaN(x[i]) || Float.isNaN(y[i]) || x[i] < 0 || y[i] < 0
+                    || (i > 0 && x[i - 1] >= x[i])) {
+                return false;
+            }
+        }
+        return true;
+    }
+
     private static boolean isValidMapping(float[] x, float[] y) {
