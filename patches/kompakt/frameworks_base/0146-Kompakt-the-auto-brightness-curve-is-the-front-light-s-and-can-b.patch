+            mDefaultBrightness = mBrightness;
 
             mMaxGamma = maxGamma;
             mAutoBrightnessAdjustment = 0;
@@ -662,12 +684,34 @@ public abstract class BrightnessMappingStrategy {
 
         @Override
         public boolean setBrightnessConfiguration(@Nullable BrightnessConfiguration config) {
-            return false;
+            // Kompakt: the configuration's nits are backlight steps, as the overlay curve's.
+            if (Objects.equals(config, mConfig)) {
+                return false;
+            }
+            float[] lux = mDefaultLux;
+            float[] brightness = mDefaultBrightness;
+            if (config != null) {
+                final Pair<float[], float[]> curve = config.getCurve();
+                lux = curve.first;
+                brightness = new float[curve.second.length];
+                for (int i = 0; i < brightness.length; i++) {
+                    brightness[i] = BrightnessSynchronizer.brightnessIntToFloat(
+                            Math.round(curve.second[i]));
+                }
+                if (!isValidFrontlightCurve(lux, brightness)) {
+                    return false;
+                }
+            }
+            mConfig = config;
+            mLux = lux;
+            mBrightness = brightness;
+            computeSpline();
+            return true;
         }
 
         @Override
         public BrightnessConfiguration getBrightnessConfiguration() {
-            return null;
+            return mConfig;
         }
 
         @Override
@@ -761,7 +805,7 @@ public abstract class BrightnessMappingStrategy {
 
         @Override
         public boolean isDefaultConfig() {
-            return true;
+            return mConfig == null;
         }
 
         @Override
@@ -778,6 +822,7 @@ public abstract class BrightnessMappingStrategy {
         public void dump(PrintWriter pw, float hbmTransition) {
             pw.println("SimpleMappingStrategy");
             pw.println("  mSpline=" + mSpline);
+            pw.println("  mConfig=" + mConfig);
             pw.println("  mMaxGamma=" + mMaxGamma);
             pw.println("  mAutoBrightnessAdjustment=" + mAutoBrightnessAdjustment);
             pw.println("  mUserLux=" + mUserLux);
@@ -806,11 +851,36 @@ public abstract class BrightnessMappingStrategy {
         }
 
         private void computeSpline() {
-            Pair<float[], float[]> curve = getAdjustedCurve(mLux, mBrightness, mUserLux,
-                    mUserBrightness, mAutoBrightnessAdjustment, mMaxGamma);
+            Pair<float[], float[]> curve = kompaktScaleToUserPoint();
+            if (curve == null) {
+                curve = getAdjustedCurve(mLux, mBrightness, mUserLux,
+                        mUserBrightness, mAutoBrightnessAdjustment, mMaxGamma);
+            }
             mSpline = Spline.createSpline(curve.first, curve.second);
         }
 
+        // Kompakt: a user point scales the whole curve, so a frontlight curve still falls to off.
+        private Pair<float[], float[]> kompaktScaleToUserPoint() {
+            if (mUserLux == INVALID_LUX || !(mUserBrightness >= 0)) {
+                return null;
+            }
+            float lowest = Float.MAX_VALUE;
+            for (float b : mBrightness) {
+                if (b > 0) lowest = Math.min(lowest, b);
+            }
+            final float base = getUnadjustedBrightness(mUserLux);
+            // Where the curve is off or nearly so, a scale would be huge; stock handles it.
+            if (!(base >= lowest)) {
+                return null;
+            }
+            final float scale = mUserBrightness / base;
+            final float[] brightness = new float[mBrightness.length];
+            for (int i = 0; i < brightness.length; i++) {
+                brightness[i] = MathUtils.constrain(mBrightness[i] * scale, 0, 1);
+            }
+            return Pair.create(mLux, brightness);
+        }
+
         private float getUnadjustedBrightness(float lux) {
             Spline spline = Spline.createSpline(mLux, mBrightness);
             return spline.interpolate(lux);
