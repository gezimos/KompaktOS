+package android.kompakt.aux;
+
+/**
+ * The method order is the one of MuditaOS 2.0, so the transaction codes match its apps.
+ *
+ * {@hide}
+ */
+interface IKompaktAuxService {
+    boolean isHWKSOn();
+    boolean isOnBootHwksOn();
+    void startBatteryCounting();
+    void updateBatteryStatus();
+    String getBatteryProductionDate();
+    void updateBatteryProductionDate(String date);
+    int getBatteryCycleCount();
+    String getBatteryFirstUseDate();
+    int getBatteryMaxChargeLevel();
+    void setBatteryMaxChargeLevel(int level);
+    String getMuditaRegion();
+    void setESimState(int state);
+    int getESimState();
+    String getFirstUsePredictedDate();
+    void setFirstUsePredictedDate(String date);
+    int getCrashReportingEnabled();
+    void setCrashReportingEnabled(int enabled);
+    void setAgpsEnabled(boolean enabled);
+    boolean isAgpsEnabled();
+    void setLocationEnabled(boolean enabled);
+    boolean isLocationEnabled();
+    void setOfflinePlusCameraEnabled(boolean enabled);
+    boolean isOfflinePlusCameraEnabled();
+    void setOfflinePlusBluetoothEnabled(boolean enabled);
+    boolean isOfflinePlusBluetoothEnabled();
+}
