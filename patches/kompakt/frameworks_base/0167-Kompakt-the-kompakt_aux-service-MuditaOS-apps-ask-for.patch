+package com.android.server.kompakt.aux;
+
+import android.Manifest;
+import android.content.ContentResolver;
+import android.content.Context;
+import android.content.pm.PackageManager;
+import android.kompakt.aux.IKompaktAuxService;
+import android.location.LocationManager;
+import android.os.Binder;
+import android.os.Process;
+import android.os.SystemProperties;
+import android.provider.Settings;
+import android.util.Log;
+
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+
+/**
+ * The "kompakt_aux" service MuditaOS 2.0's apps ask for: the Offline+ switch, the battery
+ * counters and a few settings. It only answers; the Kompakt app switches the radios.
+ */
+public class KompaktAuxService extends IKompaktAuxService.Stub {
+    private static final String TAG = "KompaktAuxService";
+
+    private static final String SWITCH_STATE =
+            "/sys/bus/platform/drivers/pmic-codec-accdet/irqkey_state";
+    private static final String BATTERY = "/sys/kernel/battery_monitor/";
+    private static final String CRASH_REPORTING = "sentry_crash_logs_report";
+    private static final String OFFLINE_PLUS_CAMERA = "offline_plus_camera_enabled";
+    private static final String OFFLINE_PLUS_BLUETOOTH = "offline_plus_bluetooth_enabled";
+
+    private final Context mContext;
+    private final ContentResolver mResolver;
+
+    public KompaktAuxService(Context context) {
+        mContext = context;
+        mResolver = context.getContentResolver();
+    }
+
+    private static int readDigit(String path) throws IOException {
+        try (FileInputStream in = new FileInputStream(path)) {
+            return Character.getNumericValue(in.read());
+        }
+    }
+
+    private static String readText(String path) throws IOException {
+        return new String(Files.readAllBytes(new File(path).toPath()), StandardCharsets.UTF_8);
+    }
+
+    private static void writeText(String path, String value) throws IOException {
+        try (FileOutputStream out = new FileOutputStream(path)) {
+            out.write(value.getBytes(StandardCharsets.UTF_8));
+        }
+    }
+
+    /** Settings that change the phone are for the system and for apps allowed to write them. */
+    private boolean mayWrite(String what) {
+        if (Binder.getCallingUid() == Process.SYSTEM_UID
+                || mContext.checkCallingOrSelfPermission(Manifest.permission.WRITE_SECURE_SETTINGS)
+                        == PackageManager.PERMISSION_GRANTED) {
+            return true;
+        }
+        Log.w(TAG, what + " ignored for uid " + Binder.getCallingUid());
+        return false;
+    }
+
+    @Override
+    public boolean isHWKSOn() {
+        try {
+            return readDigit(SWITCH_STATE) > 0;
+        } catch (Exception e) {
+            Log.e(TAG, "cannot read the Offline+ switch", e);
+            return false;
+        }
+    }
+
+    @Override
+    public boolean isOnBootHwksOn() {
+        try {
+            return readDigit(BATTERY + "hwks_on_boot") > 0;
+        } catch (Exception e) {
+            Log.e(TAG, "cannot read the Offline+ switch at boot", e);
+            return false;
+        }
+    }
+
+    @Override
+    public void startBatteryCounting() {
+        if (!mayWrite("startBatteryCounting")) return;
+        try {
+            writeText(BATTERY + "first_use_trigger", "1");
+        } catch (Exception e) {
+            Log.e(TAG, "cannot start battery counting", e);
+        }
+    }
+
+    @Override
+    public void updateBatteryStatus() {
+        // MuditaOS pushes the battery state to the health HAL here; ours reads the nodes live.
+    }
+
+    @Override
+    public String getBatteryProductionDate() {
+        try {
+            return readText(BATTERY + "battery_production_date");
+        } catch (Exception e) {
+            return "";
+        }
+    }
+
+    @Override
+    public void updateBatteryProductionDate(String date) {
+        if (date == null || !mayWrite("updateBatteryProductionDate")) return;
+        try {
+            writeText(BATTERY + "battery_production_date", date);
+        } catch (Exception e) {
+            Log.e(TAG, "cannot write the battery production date", e);
+        }
+    }
+
+    @Override
+    public int getBatteryCycleCount() {
+        try {
+            return Integer.parseInt(readText(BATTERY + "cycle_counter").trim());
+        } catch (Exception e) {
+            return -1;
+        }
+    }
+
+    @Override
+    public String getBatteryFirstUseDate() {
+        try {
+            return readText(BATTERY + "first_use_date");
+        } catch (Exception e) {
+            return "";
+        }
+    }
+
+    @Override
+    public int getBatteryMaxChargeLevel() {
+        try {
+            return Integer.parseInt(readText(BATTERY + "charge_limit").trim());
+        } catch (Exception e) {
+            return 100;
+        }
+    }
+
+    @Override
+    public void setBatteryMaxChargeLevel(int level) {
+        if (!mayWrite("setBatteryMaxChargeLevel")) return;
+        try {
+            writeText(BATTERY + "charge_limit", String.valueOf(level));
+        } catch (Exception e) {
+            Log.e(TAG, "cannot set the charge limit", e);
+        }
+    }
+
+    @Override
+    public String getMuditaRegion() {
+        String region = SystemProperties.get("ro.product.mudita_region", "");
+        if (!region.isEmpty()) return region;
+        // Our vendor images are per region; the modem version ends in P8 (Global) or P6 (USA).
+        String baseband = SystemProperties.get("gsm.version.baseband", "");
+        if (baseband.contains(".P8")) return "GLOBAL";
+        if (baseband.contains(".P6")) return "NAM";
+        return "";
+    }
+
+    @Override
+    public void setESimState(int state) {
+        if (!mayWrite("setESimState")) return;
+        try {
+            writeText(BATTERY + "extra_data", state + "\n");
+            writeText(BATTERY + "extra_trigger", "1");
+        } catch (Exception e) {
+            Log.e(TAG, "cannot set the eSIM state", e);
+        }
+    }
+
+    @Override
+    public int getESimState() {
+        try {
+            int state = readDigit(BATTERY + "extra_data");
+            return state < 0 || state > 2 ? 0 : state;
+        } catch (Exception e) {
+            return 0;
+        }
+    }
+
+    @Override
+    public String getFirstUsePredictedDate() {
+        try {
+            return readText(BATTERY + "first_use_predicted_date");
+        } catch (Exception e) {
+            return "";
+        }
+    }
+
+    @Override
+    public void setFirstUsePredictedDate(String date) {
+        if (date == null || !mayWrite("setFirstUsePredictedDate")) return;
+        try {
+            writeText(BATTERY + "first_use_predicted_date", date);
+            writeText(BATTERY + "first_use_trigger", "1");
+        } catch (Exception e) {
+            Log.e(TAG, "cannot set the predicted first use date", e);
+        }
+    }
+
+    @Override
+    public int getCrashReportingEnabled() {
+        return Settings.Secure.getInt(mResolver, CRASH_REPORTING, 1);
+    }
+
+    @Override
+    public void setCrashReportingEnabled(int enabled) {
+        if (!mayWrite("setCrashReportingEnabled")) return;
+        final long token = Binder.clearCallingIdentity();
+        try {
+            Settings.Secure.putInt(mResolver, CRASH_REPORTING, enabled);
+        } finally {
+            Binder.restoreCallingIdentity(token);
+        }
+    }
+
+    @Override
+    public void setAgpsEnabled(boolean enabled) {
+        // MediaTek's AGPS setting is not part of this tree.
+    }
+
+    @Override
+    public boolean isAgpsEnabled() {
+        return false;
+    }
+
+    @Override
+    public void setLocationEnabled(boolean enabled) {
+        if (!mayWrite("setLocationEnabled")) return;
+        final long token = Binder.clearCallingIdentity();
+        try {
+            mContext.getSystemService(LocationManager.class)
+                    .setLocationEnabledForUser(enabled, Process.myUserHandle());
+        } finally {
+            Binder.restoreCallingIdentity(token);
+        }
+    }
+
+    @Override
+    public boolean isLocationEnabled() {
+        final long token = Binder.clearCallingIdentity();
+        try {
+            return mContext.getSystemService(LocationManager.class).isLocationEnabled();
+        } finally {
+            Binder.restoreCallingIdentity(token);
+        }
+    }
+
+    @Override
+    public void setOfflinePlusCameraEnabled(boolean enabled) {
+        if (!mayWrite("setOfflinePlusCameraEnabled")) return;
+        final long token = Binder.clearCallingIdentity();
+        try {
+            Settings.Global.putInt(mResolver, OFFLINE_PLUS_CAMERA, enabled ? 1 : 0);
+        } finally {
+            Binder.restoreCallingIdentity(token);
+        }
+    }
+
+    @Override
+    public boolean isOfflinePlusCameraEnabled() {
+        return Settings.Global.getInt(mResolver, OFFLINE_PLUS_CAMERA, 0) == 1;
+    }
+
+    @Override
+    public void setOfflinePlusBluetoothEnabled(boolean enabled) {
+        if (!mayWrite("setOfflinePlusBluetoothEnabled")) return;
+        final long token = Binder.clearCallingIdentity();
+        try {
+            Settings.Global.putInt(mResolver, OFFLINE_PLUS_BLUETOOTH, enabled ? 1 : 0);
+        } finally {
+            Binder.restoreCallingIdentity(token);
+        }
+    }
+
+    @Override
+    public boolean isOfflinePlusBluetoothEnabled() {
+        return Settings.Global.getInt(mResolver, OFFLINE_PLUS_BLUETOOTH, 0) == 1;
+    }
+}
