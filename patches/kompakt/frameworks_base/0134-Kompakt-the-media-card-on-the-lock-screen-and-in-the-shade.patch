+/**
+ * Kompakt: the first session as a notification-sized card, after Katapult's music widget: the
+ * track on top; the cover, square, in the bottom corner beside open, previous, play/pause, next and
+ * stop. Also the notifications shade's media.
+ */
+@Composable
+fun KompaktMediaCard(
+    viewModelFactory: MediaViewModel.Factory,
+    carouselVisibility: MediaCarouselVisibility,
+) {
+    val context = LocalContext.current
+    val media: MediaViewModel =
+        rememberViewModel("KompaktMediaCard") {
+            viewModelFactory.create(context = context, carouselVisibility = carouselVisibility)
+        }
+    val card = media.cards.firstOrNull() ?: return
+    val ink = colorResource(R.color.kompakt_notification_outline)
+    val paper = if (isSystemInDarkTheme()) Color.Black else Color.White
+    val line = with(LocalDensity.current) { 2.toDp() }
+    val corner = dimensionResource(R.dimen.notification_corner_radius)
+    val shape = RoundedCornerShape(corner)
+    val cover = (card.background as? Icon.Loaded)?.asImageBitmap()
+
+    Column(
+        modifier =
+            Modifier.fillMaxWidth()
+                .height(80.dp)
+                .clip(shape)
+                .background(paper)
+                .border(line, ink, shape)
+    ) {
+        Box(
+            contentAlignment = Alignment.Center,
+            // Kompakt: the border is drawn over the content, so its width is padding too.
+            modifier = Modifier.fillMaxWidth().weight(1.4f).padding(top = line).padding(horizontal = 12.dp),
+        ) {
+            Text(
+                text = listOf(card.title, card.subtitle).filter { it.isNotBlank() }.joinToString(" - "),
+                color = ink,
+                fontSize = 16.sp,
+                maxLines = 1,
+                overflow = TextOverflow.Ellipsis,
+            )
+        }
+        Box(Modifier.fillMaxWidth().height(line).background(ink))
+        Row(
+            verticalAlignment = Alignment.CenterVertically,
+            modifier = Modifier.fillMaxWidth().weight(2f),
+        ) {
+            Box(
+                contentAlignment = Alignment.Center,
+                modifier =
+                    Modifier.fillMaxHeight()
+                        .aspectRatio(1f)
+                        .clip(RoundedCornerShape(bottomStart = corner))
+                        .background(if (cover != null) ink else paper),
+            ) {
+                if (cover != null) {
+                    Image(
+                        bitmap = cover,
+                        contentDescription = null,
+                        contentScale = ContentScale.Crop,
+                        modifier = Modifier.fillMaxSize(),
+                    )
+                } else {
+                    MaterialIcon(Icons.Rounded.MusicNote, null, tint = ink, modifier = Modifier.size(28.dp))
+                }
+            }
+            Box(Modifier.fillMaxHeight().width(line).background(ink))
+            // Kompakt: one equal slot per control; bottom padding for the border drawn over it.
+            Row(
+                verticalAlignment = Alignment.CenterVertically,
+                modifier = Modifier.weight(1f).fillMaxHeight().padding(bottom = line),
+            ) {
+                val slot = Modifier.weight(1f)
+                Box(slot, contentAlignment = Alignment.Center) {
+                    // Kompakt: inkOS's open button, a solid record dot.
+                    Expandable(
+                        controller =
+                            rememberExpandableController(color = Color.Transparent, shape = CircleShape),
+                        useModifierBasedImplementation = true,
+                    ) { expandable ->
+                        Box(
+                            contentAlignment = Alignment.Center,
+                            modifier =
+                                Modifier.size(32.dp).clickable(
+                                    interactionSource = remember { MutableInteractionSource() },
+                                    indication = null,
+                                ) {
+                                    card.onClick(expandable)
+                                },
+                        ) {
+                            // Kompakt: as wide as the Stop glyph's square (12 of 24 units at 32dp).
+                            Box(Modifier.size(16.dp).background(ink, CircleShape))
+                        }
+                    }
+                }
+                Box(slot, contentAlignment = Alignment.Center) {
+                    KompaktMediaButton(Icons.Rounded.SkipPrevious, (card.previous as? MediaSecondaryActionViewModel.Action)?.onClick, ink, 32.dp)
+                }
+                val play = card.playPauseAction
+                Box(slot, contentAlignment = Alignment.Center) {
+                    KompaktMediaButton(
+                        if (play?.state == MediaSessionState.Playing) Icons.Rounded.Pause else Icons.Rounded.PlayArrow,
+                        play?.onClick,
+                        ink,
+                        40.dp,
+                    )
+                }
+                Box(slot, contentAlignment = Alignment.Center) {
+                    KompaktMediaButton(Icons.Rounded.SkipNext, (card.next as? MediaSecondaryActionViewModel.Action)?.onClick, ink, 32.dp)
+                }
+                Box(slot, contentAlignment = Alignment.Center) {
+                    KompaktMediaButton(Icons.Rounded.Stop, card.onStop, ink, 32.dp)
+                }
+            }
+        }
+    }
+}
+
+/** No ripple: the panel would repaint for it. */
+@Composable
+private fun KompaktMediaButton(icon: ImageVector, onClick: (() -> Unit)?, ink: Color, size: Dp) {
+    MaterialIcon(
+        icon,
+        contentDescription = null,
+        tint = if (onClick != null) ink else Color.Transparent,
+        modifier =
+            Modifier.size(size)
+                .clickable(
+                    interactionSource = remember { MutableInteractionSource() },
+                    indication = null,
+                    enabled = onClick != null,
+                ) {
+                    onClick?.invoke()
+                },
+    )
+}
