+
+package com.android.server.wm;
+
+import android.graphics.Rect;
+import android.hardware.HardwareBuffer;
+import android.os.SystemProperties;
+import android.util.Slog;
+import android.view.Display;
+import android.view.SurfaceControl;
+import android.window.ScreenCapture.ScreenCaptureParams;
+import android.window.ScreenCaptureInternal;
+
+import com.android.internal.policy.TransitionAnimation;
+
+/** Kompakt: keeps the last lockscreen or AOD frame on the panel while the
+ * keyguard goes away, until home has been drawn behind it. */
+class KompaktUnlockHold {
+    private static final String TAG = "KompaktUnlockHold";
+    private static final long TIMEOUT_MS = 1500;
+
+    private final WindowManagerService mWmService;
+    private SurfaceControl mLayer;
+
+    private final Runnable mTimeout = () -> {
+        synchronized (KompaktUnlockHold.this.mWmService.mGlobalLock) {
+            release("timeout");
+        }
+    };
+
+    KompaktUnlockHold(WindowManagerService wmService) {
+        mWmService = wmService;
+    }
+
+    boolean isHolding() {
+        return mLayer != null;
+    }
+
+    /** Freezes the panel on what it shows now. Called with the global lock held. */
+    void hold(DisplayContent dc, String reason) {
+        if (mLayer != null || dc == null) return;
+        if (!SystemProperties.getBoolean("persist.sys.kompakt.unlock_hold", true)) return;
+        // A dark panel is held by the screen-on block instead, and has nothing to freeze.
+        if (Display.isOffState(dc.getDisplayInfo().state)) return;
+
+        final Rect crop = new Rect(dc.getBounds());
+        crop.offsetTo(0, 0);
+        final ScreenCaptureInternal.LayerCaptureArgs args =
+                new ScreenCaptureInternal.LayerCaptureArgs.Builder(dc.getSurfaceControl())
+                        .setSourceCrop(crop)
+                        .setSecureContentPolicy(ScreenCaptureParams.SECURE_CONTENT_POLICY_CAPTURE)
+                        .setProtectedContentPolicy(
+                                ScreenCaptureParams.PROTECTED_CONTENT_POLICY_CAPTURE)
+                        .setPreserveDisplayColors(true)
+                        .build();
+        final ScreenCaptureInternal.ScreenshotHardwareBuffer shot =
+                ScreenCaptureInternal.captureLayers(args);
+        final HardwareBuffer buffer = shot == null ? null : shot.getHardwareBuffer();
+        if (buffer == null || buffer.getWidth() <= 1 || buffer.getHeight() <= 1) {
+            Slog.w(TAG, "no screenshot, not holding (" + reason + ")");
+            return;
+        }
+
+        final SurfaceControl layer = dc.makeOverlay()
+                .setName("KompaktUnlockHold")
+                .setOpaque(true)
+                .setSecure(shot.containsSecureLayers())
+                .setCallsite("KompaktUnlockHold")
+                .setBLASTLayer()
+                .build();
+        final SurfaceControl.Transaction t = mWmService.mTransactionFactory.get();
+        TransitionAnimation.configureScreenshotLayer(t, layer, shot);
+        t.setLayer(layer, Integer.MAX_VALUE);
+        t.show(layer);
+        t.apply();
+        t.close();
+        buffer.close();
+
+        mLayer = layer;
+        mWmService.mH.postDelayed(mTimeout, TIMEOUT_MS);
+        Slog.i(TAG, "hold: " + reason);
+    }
+
+    /** Releases the hold after the next frame has placed every surface. */
+    void releaseAfterNextFrame(String reason) {
+        if (mLayer == null) return;
+        mWmService.mAnimator.addAfterPrepareSurfacesRunnable(() -> release(reason));
+    }
+
+    /** Called with the global lock held. */
+    void release(String reason) {
+        if (mLayer == null) return;
+        mWmService.mH.removeCallbacks(mTimeout);
+        final SurfaceControl.Transaction t = mWmService.mTransactionFactory.get();
+        t.remove(mLayer);
+        t.apply();
+        t.close();
+        mLayer = null;
+        Slog.i(TAG, "release: " + reason);
+    }
+}
diff --git a/services/core/java/com/android/server/wm/TransitionController.java b/services/core/java/com/android/server/wm/TransitionController.java
index eace57ac234c..7d5e35ad5a69 100644
--- a/services/core/java/com/android/server/wm/TransitionController.java
+++ b/services/core/java/com/android/server/wm/TransitionController.java
@@ -1127,6 +1127,10 @@ class TransitionController {
             mAtm.mWindowManager.mAnimator.addSurfaceVisibilityUpdate(
                     record.mTargets.get(i).mContainer);
         }
+        // Kompakt: an unlock holds the panel on the lockscreen until this point.
+        if (!inTransition()) {
+            mAtm.mKeyguardController.onKompaktTransitionsIdle();
+        }
     }
 
     /** Called by {@link Transition#finishTransition} if it committed invisible to any activities */
