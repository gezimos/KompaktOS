+++ b/services/core/java/com/android/server/wm/KeyguardController.java
@@ -92,6 +92,8 @@ class KeyguardController {
 
     private final ActivityTaskSupervisor mTaskSupervisor;
     private WindowManagerService mWindowManager;
+    // Kompakt: see KompaktUnlockHold.
+    private KompaktUnlockHold mKompaktUnlockHold;
 
     private final SparseArray<KeyguardDisplayState> mDisplayStates = new SparseArray<>();
     private final ActivityTaskManagerService mService;
@@ -108,6 +110,14 @@ class KeyguardController {
     void setWindowManager(WindowManagerService windowManager) {
         mWindowManager = windowManager;
         mRootWindowContainer = mService.mRootWindowContainer;
+        mKompaktUnlockHold = new KompaktUnlockHold(windowManager);
+    }
+
+    /** Kompakt: transitions settled; if the keyguard is gone, release the held frame. */
+    void onKompaktTransitionsIdle() {
+        if (mKompaktUnlockHold == null || !mKompaktUnlockHold.isHolding()) return;
+        if (isKeyguardOrAodShowing(DEFAULT_DISPLAY)) return;
+        mKompaktUnlockHold.releaseAfterNextFrame("transitions idle");
     }
 
     boolean isAodShowing(int displayId) {
@@ -209,6 +219,16 @@ class KeyguardController {
             return;
         }
 
+        // Kompakt: hold the lockscreen or AOD frame until home is drawn behind it, and let go
+        // if the keyguard comes back instead.
+        if (displayId == DEFAULT_DISPLAY) {
+            if (!keyguardShowing && state.mKeyguardShowing) {
+                mKompaktUnlockHold.hold(dc, "keyguard hidden");
+            } else if (keyguardShowing) {
+                mKompaktUnlockHold.release("keyguard shown");
+            }
+        }
+
         final ActionChain chain = mService.mChainTracker.startTransit("setKGShown");
 
         if (ENABLE_NEW_KEYGUARD_SHELL_TRANSITIONS) {
@@ -312,6 +332,10 @@ class KeyguardController {
                 if (state.mKeyguardShowing && !state.mKeyguardGoingAway) {
                     state.mKeyguardGoingAway = true;
                     state.writeEventLog("keyguardGoingAway");
+                    if (dc.mDisplayId == DEFAULT_DISPLAY) {
+                        // Kompakt: see setKeyguardShown.
+                        mKompaktUnlockHold.hold(dc, "keyguard going away");
+                    }
                     scheduleGoingAwayTimeout(dc.mDisplayId);
                     changedDisplays.add(dc);
                 }
diff --git a/services/core/java/com/android/server/wm/KompaktUnlockHold.java b/services/core/java/com/android/server/wm/KompaktUnlockHold.java
new file mode 100644
index 000000000000..bf592e372d9e
--- /dev/null
+++ b/services/core/java/com/android/server/wm/KompaktUnlockHold.java
@@ -0,0 +1,115 @@
