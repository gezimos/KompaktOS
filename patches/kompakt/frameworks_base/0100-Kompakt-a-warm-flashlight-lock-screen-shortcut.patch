+package com.android.systemui.keyguard.data.quickaffordance
+
+import android.content.Context
+import android.content.Intent
+import android.database.ContentObserver
+import android.provider.Settings
+import com.android.systemui.animation.Expandable
+import com.android.systemui.common.coroutine.ChannelExt.trySendWithFailureLogging
+import com.android.systemui.common.shared.model.ContentDescription
+import com.android.systemui.common.shared.model.Icon
+import com.android.systemui.dagger.SysUISingleton
+import com.android.systemui.keyguard.shared.quickaffordance.ActivationState
+import com.android.systemui.res.R
+import com.android.systemui.shade.ShadeDisplayAware
+import com.android.systemui.utils.coroutines.flow.conflatedCallbackFlow
+import javax.inject.Inject
+import kotlinx.coroutines.channels.awaitClose
+import kotlinx.coroutines.flow.Flow
+
+/**
+ * Kompakt: a lock screen shortcut for the warm flash LED. The Kompakt app owns the LED (SystemUI
+ * cannot write it), so a tap asks it to switch, and it publishes the state in a global setting.
+ */
+@SysUISingleton
+class WarmFlashlightQuickAffordanceConfig
+@Inject
+constructor(@ShadeDisplayAware private val context: Context) : KeyguardQuickAffordanceConfig {
+
+    override val key: String
+        get() = KEY
+
+    override fun pickerName(): String =
+        context.getString(R.string.kompakt_warm_flashlight_label)
+
+    override val pickerIconResourceId: Int
+        get() = R.drawable.ic_flashlight_off
+
+    override val lockScreenState: Flow<KeyguardQuickAffordanceConfig.LockScreenState> =
+        conflatedCallbackFlow {
+            val resolver = context.contentResolver
+            val send = {
+                val on = Settings.Global.getInt(resolver, SETTING, 0) == 1
+                trySendWithFailureLogging(state(on), TAG)
+            }
+            val observer =
+                object : ContentObserver(null) {
+                    override fun onChange(selfChange: Boolean) {
+                        send()
+                    }
+                }
+            resolver.registerContentObserver(Settings.Global.getUriFor(SETTING), false, observer)
+            send()
+            awaitClose { resolver.unregisterContentObserver(observer) }
+        }
+
+    private fun state(on: Boolean) =
+        KeyguardQuickAffordanceConfig.LockScreenState.Visible(
+            Icon.Resource(
+                if (on) R.drawable.qs_flashlight_icon_on else R.drawable.qs_flashlight_icon_off,
+                ContentDescription.Resource(R.string.kompakt_warm_flashlight_label),
+            ),
+            if (on) ActivationState.Active else ActivationState.Inactive,
+        )
+
+    override fun onTriggered(
+        expandable: Expandable?
+    ): KeyguardQuickAffordanceConfig.OnTriggeredResult {
+        context.sendBroadcast(
+            Intent(ACTION_TOGGLE)
+                .setPackage(KOMPAKT_PACKAGE)
+                .addFlags(Intent.FLAG_RECEIVER_FOREGROUND)
+        )
+        return KeyguardQuickAffordanceConfig.OnTriggeredResult.Handled(false)
+    }
+
+    override suspend fun getPickerScreenState(): KeyguardQuickAffordanceConfig.PickerScreenState =
+        KeyguardQuickAffordanceConfig.PickerScreenState.Default()
+
+    companion object {
+        private const val TAG = "WarmFlashlightQuickAffordanceConfig"
+        const val KEY = "kompakt_warm_flashlight"
+        private const val SETTING = "kompakt_torch_warm"
+        private const val ACTION_TOGGLE = "com.kompakt.service.action.TORCH_WARM"
+        private const val KOMPAKT_PACKAGE = "com.kompakt.service"
+    }
+}
