 import static android.view.WindowManagerGlobal.RELAYOUT_RES_SURFACE_CHANGED;
@@ -1554,6 +1553,11 @@ public class WindowManagerService extends IWindowManager.Stub
                 lightRadius);
     }
 
+    /** Kompakt: animations are off for good; whatever scale is set or stored, it runs at 0. */
+    private static float fixScale(float scale) {
