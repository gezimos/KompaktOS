From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Gezim <gezimos@users.noreply.github.com>
Date: Tue, 27 Oct 2026 13:00:00 +0200
Subject: [PATCH] Kompakt: locking goes straight to AOD

---
diff --git a/packages/SystemUI/src/com/android/systemui/statusbar/phone/DozeParameters.java b/packages/SystemUI/src/com/android/systemui/statusbar/phone/DozeParameters.java
--- a/packages/SystemUI/src/com/android/systemui/statusbar/phone/DozeParameters.java
+++ b/packages/SystemUI/src/com/android/systemui/statusbar/phone/DozeParameters.java
@@ -324,8 +324,9 @@ public class DozeParameters implements
 
     public void updateControlScreenOff() {
         if (!getDisplayNeedsBlanking()) {
-            final boolean controlScreenOff =
-                    getAlwaysOn() && (mKeyguardVisible || shouldControlUnlockedScreenOff());
+            // Kompakt: AOD always takes over the screen off, so locking goes straight to DOZE
+            // with no panel power-down and no sleep picture under the AOD.
+            final boolean controlScreenOff = getAlwaysOn();
             setControlScreenOffAnimation(controlScreenOff);
         }
     }
@@ -376,11 +377,8 @@ public class DozeParameters implements
      * delayed for a few seconds. This might be useful to play animations without reducing FPS.
      */
     public boolean shouldDelayDisplayDozeTransition() {
-        if (mTransitionInteractor.getTransitionState().getValue().getTo() == KeyguardState.AOD) {
-            return true;
-        }
-        return willAnimateFromLockScreenToAod()
-                || mScreenOffAnimationController.shouldDelayDisplayDozeTransition();
+        // Kompakt: no animation to wait for; the display enters DOZE as soon as AOD is drawn.
+        return false;
     }
 
     private boolean willAnimateFromLockScreenToAod() {
-- 
