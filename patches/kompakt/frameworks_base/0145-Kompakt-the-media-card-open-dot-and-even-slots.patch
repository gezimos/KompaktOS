From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Gezim <gezimos@users.noreply.github.com>
Date: Tue, 27 Oct 2026 20:30:00 +0200
Subject: [PATCH] Kompakt: the media card open dot and even slots

---
  .../ui/composable/elements/MediaElementProvider.kt | 76 ++++++++++------------
  1 file changed, 35 insertions(+), 41 deletions(-)

diff --git a/packages/SystemUI/compose/features/src/com/android/systemui/keyguard/ui/composable/elements/MediaElementProvider.kt b/packages/SystemUI/compose/features/src/com/android/systemui/keyguard/ui/composable/elements/MediaElementProvider.kt
index 65dde96..380c01d 100644
--- a/packages/SystemUI/compose/features/src/com/android/systemui/keyguard/ui/composable/elements/MediaElementProvider.kt
+++ b/packages/SystemUI/compose/features/src/com/android/systemui/keyguard/ui/composable/elements/MediaElementProvider.kt
@@ -23,7 +23,6 @@ import androidx.compose.foundation.border
 import androidx.compose.foundation.clickable
 import androidx.compose.foundation.interaction.MutableInteractionSource
 import androidx.compose.foundation.isSystemInDarkTheme
-import androidx.compose.foundation.layout.Arrangement
 import androidx.compose.foundation.layout.Box
 import androidx.compose.foundation.layout.Column
 import androidx.compose.foundation.layout.Row
@@ -159,7 +158,8 @@ fun KompaktMediaCard(
     ) {
         Box(
             contentAlignment = Alignment.Center,
-            modifier = Modifier.fillMaxWidth().weight(1.4f).padding(horizontal = 12.dp),
+            // Kompakt: the border is drawn over the content, so its width is padding too.
+            modifier = Modifier.fillMaxWidth().weight(1.4f).padding(top = line).padding(horizontal = 12.dp),
         ) {
             Text(
                 text = listOf(card.title, card.subtitle).filter { it.isNotBlank() }.joinToString(" - "),
@@ -194,57 +194,51 @@ fun KompaktMediaCard(
                 }
             }
             Box(Modifier.fillMaxHeight().width(line).background(ink))
+            // Kompakt: one equal slot per control; bottom padding for the border drawn over it.
             Row(
-                horizontalArrangement = Arrangement.SpaceEvenly,
                 verticalAlignment = Alignment.CenterVertically,
-                modifier = Modifier.weight(1f).fillMaxHeight().padding(horizontal = 8.dp),
+                modifier = Modifier.weight(1f).fillMaxHeight().padding(bottom = line),
             ) {
-                // Kompakt: inkOS's round open button, the cover as a record.
-                Expandable(
-                    controller =
-                        rememberExpandableController(color = Color.Transparent, shape = CircleShape),
-                    useModifierBasedImplementation = true,
-                ) { expandable ->
-                    Box(
-                        contentAlignment = Alignment.Center,
-                        modifier =
-                            Modifier.size(32.dp)
-                                .clip(CircleShape)
-                                .border(line, ink, CircleShape)
-                                .clickable(
+                val slot = Modifier.weight(1f)
+                Box(slot, contentAlignment = Alignment.Center) {
+                    // Kompakt: inkOS's open button, a solid record dot.
+                    Expandable(
+                        controller =
+                            rememberExpandableController(color = Color.Transparent, shape = CircleShape),
+                        useModifierBasedImplementation = true,
+                    ) { expandable ->
+                        Box(
+                            contentAlignment = Alignment.Center,
+                            modifier =
+                                Modifier.size(32.dp).clickable(
                                     interactionSource = remember { MutableInteractionSource() },
                                     indication = null,
                                 ) {
                                     card.onClick(expandable)
                                 },
-                    ) {
-                        if (cover != null) {
-                            Image(
-                                bitmap = cover,
-                                contentDescription = card.onClickLabel,
-                                contentScale = ContentScale.Crop,
-                                modifier = Modifier.fillMaxSize(),
-                            )
-                        } else {
-                            MaterialIcon(
-                                Icons.Rounded.MusicNote,
-                                card.onClickLabel,
-                                tint = ink,
-                                modifier = Modifier.size(20.dp),
-                            )
+                        ) {
+                            Box(Modifier.size(22.dp).background(ink, CircleShape))
                         }
                     }
                 }
-                KompaktMediaButton(Icons.Rounded.SkipPrevious, (card.previous as? MediaSecondaryActionViewModel.Action)?.onClick, ink, 32.dp)
+                Box(slot, contentAlignment = Alignment.Center) {
+                    KompaktMediaButton(Icons.Rounded.SkipPrevious, (card.previous as? MediaSecondaryActionViewModel.Action)?.onClick, ink, 32.dp)
+                }
                 val play = card.playPauseAction
-                KompaktMediaButton(
-                    if (play?.state == MediaSessionState.Playing) Icons.Rounded.Pause else Icons.Rounded.PlayArrow,
-                    play?.onClick,
-                    ink,
-                    40.dp,
-                )
-                KompaktMediaButton(Icons.Rounded.SkipNext, (card.next as? MediaSecondaryActionViewModel.Action)?.onClick, ink, 32.dp)
-                KompaktMediaButton(Icons.Rounded.Stop, card.onStop, ink, 32.dp)
+                Box(slot, contentAlignment = Alignment.Center) {
+                    KompaktMediaButton(
+                        if (play?.state == MediaSessionState.Playing) Icons.Rounded.Pause else Icons.Rounded.PlayArrow,
+                        play?.onClick,
+                        ink,
+                        40.dp,
+                    )
+                }
+                Box(slot, contentAlignment = Alignment.Center) {
+                    KompaktMediaButton(Icons.Rounded.SkipNext, (card.next as? MediaSecondaryActionViewModel.Action)?.onClick, ink, 32.dp)
+                }
+                Box(slot, contentAlignment = Alignment.Center) {
+                    KompaktMediaButton(Icons.Rounded.Stop, card.onStop, ink, 32.dp)
+                }
             }
         }
     }
-- 
2.43.0
