 .../spa/framework/compose/KompaktPaging.kt    | 37 ++++++++++++++----
 2 files changed, 59 insertions(+), 16 deletions(-)

diff --git a/packages/SettingsLib/CollapsingToolbarBaseActivity/src/com/android/settingslib/collapsingtoolbar/KompaktPaging.java b/packages/SettingsLib/CollapsingToolbarBaseActivity/src/com/android/settingslib/collapsingtoolbar/KompaktPaging.java
index 854029a9bcdf..14381dfb175c 100644
--- a/packages/SettingsLib/CollapsingToolbarBaseActivity/src/com/android/settingslib/collapsingtoolbar/KompaktPaging.java
+++ b/packages/SettingsLib/CollapsingToolbarBaseActivity/src/com/android/settingslib/collapsingtoolbar/KompaktPaging.java
@@ -21,6 +21,8 @@ import androidx.fragment.app.FragmentManager;
 import androidx.recyclerview.widget.LinearLayoutManager;
 import androidx.recyclerview.widget.RecyclerView;
 
+import java.util.ArrayDeque;
+
 /**
  * Kompakt: every vertical list on a SettingsLib page turns a page per swipe, as Settings'
  * own pages do (Settings' com.kompakt.eink.PagedScroll and PageGestureListener, copied).
@@ -96,10 +98,11 @@ final class KompaktPaging {
             final long before = mark(lm);
             for (int i = Math.abs(delta); i > 0; i--) {
                 if (delta > 0) {
-                    forward(rv, lm, viewport);
+                    final int moved = forward(rv, lm, viewport);
+                    // Remembered, so back returns to exactly this page.
+                    if (moved > 0) lm.pages.push(new long[] {moved, mark(lm)});
                 } else {
-                    rv.scrollBy(0, -viewport);
-                    snapTopRowWhole(rv, lm);
+                    back(rv, lm, viewport);
                 }
             }
             // At either end nothing moves.
@@ -110,32 +113,47 @@ final class KompaktPaging {
     }
 
     /** Forward one page: to the top of the first row the bottom edge cuts. */
-    private static void forward(RecyclerView rv, PagedLayoutManager lm, int viewport) {
+    private static int forward(RecyclerView rv, PagedLayoutManager lm, int viewport) {
         final int topEdge = rv.getPaddingTop();
         final int bottomEdge = rv.getHeight() - rv.getPaddingBottom();
         int next = Integer.MAX_VALUE;
+        View anchor = null;
         for (int i = 0, n = lm.getChildCount(); i < n; i++) {
             final View row = lm.getChildAt(i);
             if (row == null) continue;
             if (lm.getDecoratedBottom(row) > bottomEdge && lm.getDecoratedTop(row) < next) {
                 next = lm.getDecoratedTop(row);
+                anchor = row;
             }
         }
         int dy = (next == Integer.MAX_VALUE) ? viewport : next - topEdge;
         // A row taller than the whole page would stand still forever.
         if (dy <= 0) dy = viewport;
+        final int anchorPos = anchor == null ? RecyclerView.NO_POSITION : lm.getPosition(anchor);
         rv.scrollBy(0, dy);
+        // What the list really moved: less than dy at its end.
+        final View after = anchorPos == RecyclerView.NO_POSITION ? null
+                : lm.findViewByPosition(anchorPos);
+        return after == null ? dy : next - lm.getDecoratedTop(after);
     }
 
-    /** Pull the row under the top edge down until it is whole. */
-    private static void snapTopRowWhole(RecyclerView rv, PagedLayoutManager lm) {
+    /** Back one page: to where the last page turn came from, if the list has not moved since. */
+    private static void back(RecyclerView rv, PagedLayoutManager lm, int viewport) {
+        final long[] last = lm.pages.peek();
+        if (last != null && last[1] == mark(lm)) {
+            lm.pages.pop();
+            rv.scrollBy(0, (int) -last[0]);
+            return;
+        }
+        lm.pages.clear();
+        rv.scrollBy(0, -viewport);
+        // Otherwise the page whose bottom is the old top: a row cut at the top goes up.
         final int topEdge = rv.getPaddingTop();
         for (int i = 0, n = lm.getChildCount(); i < n; i++) {
             final View row = lm.getChildAt(i);
             if (row == null) continue;
-            if (lm.getDecoratedTop(row) <= topEdge && lm.getDecoratedBottom(row) > topEdge) {
-                final int dy = lm.getDecoratedTop(row) - topEdge;
-                if (dy < 0) rv.scrollBy(0, dy);
+            if (lm.getDecoratedTop(row) < topEdge && lm.getDecoratedBottom(row) > topEdge) {
+                rv.scrollBy(0, lm.getDecoratedBottom(row) - topEdge);
                 return;
             }
         }
@@ -153,6 +171,8 @@ final class KompaktPaging {
     /** Reports "cannot scroll vertically" to touch handling, so a finger never drags the list. */
     static final class PagedLayoutManager extends LinearLayoutManager {
         boolean allowProgrammaticScroll = false;
+        // Each forward page turn, {distance, where it landed}.
+        final ArrayDeque<long[]> pages = new ArrayDeque<>();
 
         PagedLayoutManager(Context context) {
             super(context);
diff --git a/packages/SettingsLib/Spa/spa/src/com/android/settingslib/spa/framework/compose/KompaktPaging.kt b/packages/SettingsLib/Spa/spa/src/com/android/settingslib/spa/framework/compose/KompaktPaging.kt
index 8a49182f211a..2a38c88f39ec 100644
--- a/packages/SettingsLib/Spa/spa/src/com/android/settingslib/spa/framework/compose/KompaktPaging.kt
+++ b/packages/SettingsLib/Spa/spa/src/com/android/settingslib/spa/framework/compose/KompaktPaging.kt
@@ -9,6 +9,7 @@ import androidx.compose.foundation.gestures.detectVerticalDragGestures
 import androidx.compose.foundation.gestures.scrollBy
 import androidx.compose.foundation.lazy.LazyListState
 import androidx.compose.runtime.Composable
+import androidx.compose.runtime.remember
 import androidx.compose.runtime.rememberCoroutineScope
 import androidx.compose.ui.Modifier
 import androidx.compose.ui.input.pointer.pointerInput
@@ -25,7 +26,11 @@ private val KompaktPageDrag = 56.dp
 fun Modifier.kompaktPaged(state: LazyListState): Modifier {
     val scope = rememberCoroutineScope()
     val threshold = with(LocalDensity.current) { KompaktPageDrag.toPx() }
-    return kompaktPageGesture(threshold) { forward -> scope.launch { state.kompaktPage(forward) } }
+    // Each forward page turn, distance to where it landed.
+    val pages = remember(state) { ArrayDeque<Pair<Float, Long>>() }
+    return kompaktPageGesture(threshold) { forward ->
+        scope.launch { state.kompaktPage(forward, pages) }
+    }
 }
 
 /** A drag turns pages of a scrolling column (pair with verticalScroll(state, enabled = false)). */
@@ -58,8 +63,11 @@ private fun Modifier.kompaktPageGesture(threshold: Float, page: (Boolean) -> Uni
         )
     }
 
-/** Forward: to the first row the bottom edge cuts. Back: a viewport up, the top row whole. */
-private suspend fun LazyListState.kompaktPage(forward: Boolean) {
+/** Forward: to the first row the bottom edge cuts. Back: to where that came from. */
+private suspend fun LazyListState.kompaktPage(
+    forward: Boolean,
+    pages: ArrayDeque<Pair<Float, Long>>,
+) {
     val info = layoutInfo
     val visible = info.visibleItemsInfo
     if (visible.isEmpty()) return
@@ -67,9 +75,24 @@ private suspend fun LazyListState.kompaktPage(forward: Boolean) {
     if (forward) {
         val end = info.viewportEndOffset - info.afterContentPadding
         val cut = visible.firstOrNull { it.offset + it.size > end && it.index > firstVisibleItemIndex }
-        if (cut != null) scrollToItem(cut.index) else scrollBy(viewport)
-    } else {
-        scrollBy(-viewport)
-        if (firstVisibleItemScrollOffset > 0) scrollToItem(firstVisibleItemIndex)
+        // Scrolled by pixels, so what the list really moved (less at its end) is known.
+        val moved = scrollBy(cut?.offset?.toFloat()?.takeIf { it > 0f } ?: viewport)
+        // Remembered, so back returns to exactly this page.
+        if (moved > 0f) pages.addLast(moved to kompaktMark())
+        return
     }
+    val last = pages.lastOrNull()
+    if (last != null && last.second == kompaktMark()) {
+        pages.removeLast()
+        scrollBy(-last.first)
+        return
+    }
+    pages.clear()
+    scrollBy(-viewport)
+    // Otherwise the page whose bottom is the old top: a row cut at the top goes up.
+    if (firstVisibleItemScrollOffset > 0) scrollToItem(firstVisibleItemIndex + 1)
 }
+
+/** Which row is at the top and how far into it the list is. */
+private fun LazyListState.kompaktMark(): Long =
+    (firstVisibleItemIndex.toLong() shl 32) or (firstVisibleItemScrollOffset.toLong() and 0xffffffffL)
