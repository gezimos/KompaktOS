From f78e386c322be2715948979f42b4bc1a5647c823 Mon Sep 17 00:00:00 2001
From: Gezim <25499045+gezimos@users.noreply.github.com>
Date: Sun, 18 Oct 2026 23:10:00 +0200
Subject: [PATCH] Kompakt: the PIN pad repaints only the dots

A tap on the PIN pad painted several frames: the key animated to a filled
primary colour and 24dp corners over 100 ms and back over 420 ms, the new digit
appeared as a shape morphing into a dot (an AVD) while the row widened over
250 ms, a deletion shrank its dot over 200 ms, and clear-all removed the dots
33 ms apart. On e-ink each frame is a refresh, so typing felt slow and quick
taps seemed lost. MuditaOS 1.6.1's PIN pad (KompaktPasswordTextView,
num_pad_key_background) has none of this: its keys are plain outlined shapes
with no ripple, so NumPadAnimator never starts, and a digit adds a drawn dot
in one invalidate. The keys now show nothing while pressed (no fill, corner
change or ripple), each slot shows its end state at once (a dot, or the hint
circle), entries take and give up their space at once, and clear-all removes
every dot in one frame.
---
 .../bouncer/ui/composable/PinBouncer.kt       |  9 ++++---
 .../bouncer/ui/composable/PinInputDisplay.kt  | 26 +++++++++----------
 2 files changed, 17 insertions(+), 18 deletions(-)

diff --git a/packages/SystemUI/compose/features/src/com/android/systemui/bouncer/ui/composable/PinBouncer.kt b/packages/SystemUI/compose/features/src/com/android/systemui/bouncer/ui/composable/PinBouncer.kt
index 48a44c7..28b5da4 100644
--- a/packages/SystemUI/compose/features/src/com/android/systemui/bouncer/ui/composable/PinBouncer.kt
+++ b/packages/SystemUI/compose/features/src/com/android/systemui/bouncer/ui/composable/PinBouncer.kt
@@ -25,11 +25,10 @@ import androidx.compose.animation.core.AnimationVector1D
 import androidx.compose.animation.core.animateDpAsState
 import androidx.compose.animation.core.animateFloatAsState
 import androidx.compose.animation.core.tween
-import androidx.compose.foundation.LocalIndication
+import androidx.compose.foundation.Indication
 import androidx.compose.foundation.combinedClickable
 import androidx.compose.foundation.focusable
 import androidx.compose.foundation.interaction.MutableInteractionSource
-import androidx.compose.foundation.interaction.collectIsPressedAsState
 import androidx.compose.foundation.layout.Box
 import androidx.compose.foundation.layout.aspectRatio
 import androidx.compose.foundation.layout.sizeIn
@@ -258,8 +257,10 @@ private fun PinPadButton(
     content: @Composable (contentColor: () -> Color) -> Unit,
 ) {
     val interactionSource = remember { MutableInteractionSource() }
-    val isPressed by interactionSource.collectIsPressedAsState()
-    val indication = LocalIndication.current.takeUnless { isPressed }
+    // Kompakt: a key shows nothing while pressed, as MuditaOS's: no fill, ripple or corner change,
+    // so a tap repaints the panel only where the PIN dots change.
+    val isPressed = false
+    val indication: Indication? = null
     val view = LocalView.current
 
     // Pin button animation specification is asymmetric: fast animation to the pressed state, and a
diff --git a/packages/SystemUI/compose/features/src/com/android/systemui/bouncer/ui/composable/PinInputDisplay.kt b/packages/SystemUI/compose/features/src/com/android/systemui/bouncer/ui/composable/PinInputDisplay.kt
index 24bb866..b90eb10 100644
--- a/packages/SystemUI/compose/features/src/com/android/systemui/bouncer/ui/composable/PinInputDisplay.kt
+++ b/packages/SystemUI/compose/features/src/com/android/systemui/bouncer/ui/composable/PinInputDisplay.kt
@@ -187,8 +187,8 @@ private fun HintingPinInputDisplay(
     // During the initial composition, do not play the [pinEntryDrawable] animations. This prevents
     // the dot (●) to circle (◦) animation when the empty display becomes first visible, and a
     // superfluous shape to dot (●)  animation after for example device rotation.
-    var playAnimation by remember { mutableStateOf(false) }
-    LaunchedEffect(Unit) { playAnimation = true }
+    // Kompakt: never; every slot shows its end state, a dot (●) or a circle (◦), at once.
+    val playAnimation = false
 
     val dotColor = MaterialTheme.colorScheme.onSurface
     Row(
@@ -478,8 +478,8 @@ private class PinInputEntry(val digit: Digit, val shapeAnimations: ShapeAnimatio
 
     /** Animate the shape appearance by growing the entry width from 0.dp to the intrinsic width. */
     suspend fun animateAppearance() = coroutineScope {
-        entryWidth.snapTo(0.dp)
-        entryWidth.animateTo(shapeAnimations.shapeSize, shapeAnimations.inputShiftAnimationSpec)
+        // Kompakt: the dot takes its place at once.
+        entryWidth.snapTo(shapeAnimations.shapeSize)
     }
 
     /**
@@ -488,16 +488,13 @@ private class PinInputEntry(val digit: Digit, val shapeAnimations: ShapeAnimatio
      * Once complete, [isUnused] will return `true`.
      */
     suspend fun animateRemoval() = coroutineScope {
-        awaitAll(
-            async { entryWidth.animateTo(0.dp, shapeAnimations.inputShiftAnimationSpec) },
-            async { shapeSize.animateTo(0.dp, shapeAnimations.deleteShapeSizeAnimationSpec) },
-        )
+        // Kompakt: the dot and its space go at once.
+        shapeSize.snapTo(0.dp)
+        entryWidth.snapTo(0.dp)
     }
 
     /** Collapses the shape in place, while still holding on to the horizontal space. */
-    suspend fun animateClearAllCollapse() = coroutineScope {
-        shapeSize.animateTo(0.dp, shapeAnimations.clearAllShapeSizeAnimationSpec)
-    }
+    suspend fun animateClearAllCollapse() = coroutineScope { shapeSize.snapTo(0.dp) }
 
     @Composable
     fun Content() {
@@ -506,8 +503,8 @@ private class PinInputEntry(val digit: Digit, val shapeAnimations: ShapeAnimatio
 
         val dotColor = MaterialTheme.colorScheme.onSurface
         val shapeHeight = shapeAnimations.shapeSize
-        var atEnd by remember { mutableStateOf(false) }
-        LaunchedEffect(Unit) { atEnd = true }
+        // Kompakt: the end state, a dot (●), not the shape that morphs into it.
+        val atEnd = true
         Image(
             painter = rememberAnimatedVectorPainter(shape, atEnd),
             contentDescription = null,
@@ -556,7 +553,8 @@ private class ShapeAnimations(
     }
 
     // spec: http://shortn/_DEhE3Xl2bi
-    val dismissStaggerDelay = 33.milliseconds
+    // Kompakt: clear-all removes every dot in one frame.
+    val dismissStaggerDelay = 0.milliseconds
     val inputShiftAnimationSpec = tween<Dp>(durationMillis = 250, easing = Easings.Standard)
     val deleteShapeSizeAnimationSpec =
         tween<Dp>(durationMillis = 200, easing = Easings.StandardDecelerate)
