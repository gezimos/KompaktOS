+/** Kompakt: the first session as a notification-sized card: controls on top, the track below. */
+@Composable
+private fun KompaktMediaCard(
+    viewModelFactory: MediaViewModel.Factory,
+    carouselVisibility: MediaCarouselVisibility,
+) {
+    val context = LocalContext.current
+    val media: MediaViewModel =
+        rememberViewModel("KompaktMediaCard") {
+            viewModelFactory.create(context = context, carouselVisibility = carouselVisibility)
+        }
+    val card = media.cards.firstOrNull() ?: return
+    val ink = colorResource(R.color.kompakt_notification_outline)
+    val paper = if (isSystemInDarkTheme()) Color.Black else Color.White
+    val line = with(LocalDensity.current) { 2.toDp() }
+    val shape = RoundedCornerShape(dimensionResource(R.dimen.notification_corner_radius))
+
+    Column(
+        modifier =
+            Modifier.fillMaxWidth()
+                .height(80.dp)
+                .clip(shape)
+                .background(paper)
+                .border(line, ink, shape)
+    ) {
+        Row(
+            horizontalArrangement = Arrangement.SpaceEvenly,
+            verticalAlignment = Alignment.CenterVertically,
+            modifier = Modifier.fillMaxWidth().weight(1f),
+        ) {
+            KompaktMediaControls(card, ink)
+        }
+        Box(Modifier.fillMaxWidth().height(line).background(ink))
+        Box(
+            contentAlignment = Alignment.Center,
+            modifier = Modifier.fillMaxWidth().height(32.dp).padding(horizontal = 16.dp),
+        ) {
+            Text(
+                text = listOf(card.title, card.subtitle).filter { it.isNotBlank() }.joinToString(" · "),
+                color = ink,
+                fontSize = 15.sp,
+                maxLines = 1,
+                overflow = TextOverflow.Ellipsis,
+            )
+        }
+    }
+}
+
+@Composable
+private fun KompaktMediaControls(card: MediaCardViewModel, ink: Color) {
+    if (card.actionButtonLayout == MediaCardActionButtonLayout.WithPlayPause) {
+        val nav = card.navigation as? MediaNavigationViewModel.Showing
+        KompaktMediaAction(nav?.left, ink, 28.dp)
+        card.playPauseAction?.let { play ->
+            play.icon?.let { KompaktMediaButton(it, play.onClick, ink, 36.dp) }
+        }
+        KompaktMediaAction(nav?.right, ink, 28.dp)
+    } else {
+        card.additionalActions.forEach { KompaktMediaAction(it, ink, 28.dp) }
+    }
+}
+
+@Composable
+private fun KompaktMediaAction(action: MediaSecondaryActionViewModel?, ink: Color, size: Dp) {
+    if (action is MediaSecondaryActionViewModel.Action) {
+        KompaktMediaButton(action.icon, action.onClick, ink, size)
+    }
+}
+
+@Composable
+private fun KompaktMediaButton(icon: Icon, onClick: (() -> Unit)?, ink: Color, size: Dp) {
+    Box(
+        contentAlignment = Alignment.Center,
+        modifier =
+            Modifier.fillMaxHeight()
+                .padding(horizontal = 8.dp)
+                .clickable(enabled = onClick != null) { onClick?.invoke() },
+    ) {
+        Icon(icon = icon, tint = ink, modifier = Modifier.size(size))
+    }
+}
