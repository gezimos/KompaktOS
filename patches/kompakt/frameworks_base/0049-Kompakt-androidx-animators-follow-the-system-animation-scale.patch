+package androidx.core.animation;
+
+/**
+ * Kompakt: androidx animators keep their own duration scale, which starts at 1 and is never
+ * told about the system's animator duration scale. Animations built on them ran at full
+ * length with animations off. This copies the system scale into them and follows changes.
+ * It lives in this package because the androidx setter is package private.
+ */
+public final class KompaktAnimatorScale {
+    private KompaktAnimatorScale() {}
+
+    /** Call once, on the main thread, when the process starts. */
+    public static void followSystemScale() {
+        ValueAnimator.setDurationScale(android.animation.ValueAnimator.getDurationScale());
+        android.animation.ValueAnimator.registerDurationScaleChangeListener(
+                ValueAnimator::setDurationScale);
+    }
+}
diff --git a/packages/SystemUI/src/com/android/systemui/application/impl/SystemUIApplicationImpl.java b/packages/SystemUI/src/com/android/systemui/application/impl/SystemUIApplicationImpl.java
index 00887f7b42a7..834bf502d60f 100644
--- a/packages/SystemUI/src/com/android/systemui/application/impl/SystemUIApplicationImpl.java
+++ b/packages/SystemUI/src/com/android/systemui/application/impl/SystemUIApplicationImpl.java
@@ -118,6 +118,8 @@ public class SystemUIApplicationImpl extends SystemUIApplication implements
     public void onCreate() {
         super.onCreate();
         Log.v(TAG, "SystemUIApplication created.");
+        // Kompakt: androidx animators follow the system animation scale, so off means off.
+        androidx.core.animation.KompaktAnimatorScale.followSystemScale();
         // This line is used to setup Dagger's dependency injection and should be kept at the
         // top of this method.
         TimingsTraceLog log = new TimingsTraceLog("SystemUIBootTiming",
