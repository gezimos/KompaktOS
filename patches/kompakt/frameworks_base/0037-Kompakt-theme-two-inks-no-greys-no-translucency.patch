@@ -591,10 +593,34 @@ public class SplashscreenContentDrawer {
         }
 
         SplashViewBuilder setWindowBGColor(@ColorInt int background) {
-            mThemeColor = background;
+            // Kompakt: the splash is paper, black in dark mode and white in light.
+            mThemeColor = kompaktNight() ? Color.BLACK : Color.WHITE;
             return this;
         }
 
+        private boolean kompaktNight() {
+            return (mContext.getResources().getConfiguration().uiMode
+                    & Configuration.UI_MODE_NIGHT_MASK) == Configuration.UI_MODE_NIGHT_YES;
+        }
+
+        // Kompakt: the themed icon in ink when the app has one, else the icon in greys.
+        private Drawable kompaktIcon(Drawable icon) {
+            if (icon instanceof AdaptiveIconDrawable) {
+                final Drawable mono = ((AdaptiveIconDrawable) icon).getMonochrome();
+                if (mono != null) {
+                    final Drawable ink = mono.mutate();
+                    ink.setTint(kompaktNight() ? Color.WHITE : Color.BLACK);
+                    return new AdaptiveIconDrawable(new ColorDrawable(mThemeColor), ink);
+                }
+            }
+            if (icon == null) return null;
+            final ColorMatrix grey = new ColorMatrix();
+            grey.setSaturation(0f);
+            final Drawable out = icon.mutate();
+            out.setColorFilter(new ColorMatrixColorFilter(grey));
+            return out;
+        }
+
         SplashViewBuilder overlayDrawable(Drawable overlay) {
             mOverlayDrawable = overlay;
             return this;
