@@ -0,0 +1,91 @@
+/* Kompakt: which ink the lockscreen needs. */
+package com.android.systemui.wallpapers
+
+import android.app.WallpaperColors
+import android.app.WallpaperManager
+import android.content.ComponentCallbacks
+import android.content.Context
+import android.content.res.Configuration
+import android.os.Handler
+import android.os.Looper
+import android.util.Log
+import java.util.concurrent.CopyOnWriteArraySet
+
+/** Whether the surface under the lockscreen is dark, so its ink should be white. */
+object KompaktInk {
+    private const val TAG = "KompaktInk"
+
+    private val listeners = CopyOnWriteArraySet<Runnable>()
+
+    @Volatile private var cached: Boolean? = null
+
+    private var registered = false
+
+    @JvmStatic
+    fun isDarkSurface(context: Context): Boolean {
+        cached?.let { return it }
+        return compute(context).also { cached = it }
+    }
+
+    /** Runs [listener] on the main thread whenever the answer changes. */
+    @JvmStatic
+    fun addListener(context: Context, listener: Runnable) {
+        listeners.add(listener)
+        ensureRegistered(context.applicationContext)
+    }
+
+    @JvmStatic
+    fun removeListener(listener: Runnable) {
+        listeners.remove(listener)
+    }
+
+    private fun compute(context: Context): Boolean {
+        val colors =
+            try {
+                val wm = context.getSystemService(WallpaperManager::class.java)
+                wm?.getWallpaperColors(WallpaperManager.FLAG_LOCK)
+                    ?: wm?.getWallpaperColors(WallpaperManager.FLAG_SYSTEM)
+            } catch (t: Throwable) {
+                Log.w(TAG, "no wallpaper colours", t)
+                null
+            }
+        if (colors != null) {
+            val hints = colors.colorHints
+            if ((hints and WallpaperColors.HINT_SUPPORTS_DARK_TEXT) != 0) return false
+            if ((hints and WallpaperColors.HINT_SUPPORTS_DARK_THEME) != 0) return true
+            return colors.primaryColor.luminance() < 0.5f
+        }
+        return (context.resources.configuration.uiMode and Configuration.UI_MODE_NIGHT_MASK) ==
+            Configuration.UI_MODE_NIGHT_YES
+    }
+
+    @Synchronized
+    private fun ensureRegistered(app: Context) {
+        if (registered) return
+        registered = true
+        val main = Handler(Looper.getMainLooper())
+        try {
+            app.getSystemService(WallpaperManager::class.java)
+                ?.addOnColorsChangedListener({ _, _ -> refresh(app) }, main)
+        } catch (t: Throwable) {
+            Log.w(TAG, "cannot watch wallpaper colours", t)
+        }
+        app.registerComponentCallbacks(
+            object : ComponentCallbacks {
+                override fun onConfigurationChanged(newConfig: Configuration) {
+                    main.post { refresh(app) }
+                }
+
+                @Deprecated("Deprecated in Java")
+                override fun onLowMemory() {}
+            }
+        )
+    }
+
+    private fun refresh(app: Context) {
+        val now = compute(app)
+        if (now == cached) return
+        cached = now
+        listeners.forEach { it.run() }
+    }
+}
