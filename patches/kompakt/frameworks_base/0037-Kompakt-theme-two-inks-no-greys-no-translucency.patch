+/* Kompakt: status bar slot order. */
+package com.android.systemui.statusbar.phone;
+
+import android.content.Context;
+
+import com.android.systemui.res.R;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+
+/** Places the Offline+ slot where the signal bars are. */
+public final class KompaktStatusSlots {
+
+    private KompaktStatusSlots() {}
+
+    public static String[] withOfflineSlot(Context context, String[] slots) {
+        final String offline = context.getString(R.string.kompakt_offline_slot);
+        final List<String> out = new ArrayList<>(Arrays.asList(slots));
+        if (out.contains(offline)) {
+            return slots;
+        }
+        final String stacked =
+                context.getString(com.android.internal.R.string.status_bar_stacked_mobile);
+        final String mobile = context.getString(com.android.internal.R.string.status_bar_mobile);
+        int at = -1;
+        for (int i = 0; i < out.size(); i++) {
+            final String s = out.get(i);
+            if (s.equals(stacked) || s.equals(mobile)) {
+                at = i;
+                break;
+            }
+        }
+        out.add(at < 0 ? 0 : at, offline);
+        return out.toArray(new String[0]);
+    }
+}
