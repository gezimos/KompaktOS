         private fun getAodColor(): Int {
-            return DOZE_COLOR
+            // Kompakt: the ink of the lock wallpaper, which AOD shows.
+            val colors =
+                try {
+                    val wm = ctx.getSystemService(android.app.WallpaperManager::class.java)
+                    wm?.getWallpaperColors(android.app.WallpaperManager.FLAG_LOCK)
+                        ?: wm?.getWallpaperColors(android.app.WallpaperManager.FLAG_SYSTEM)
+                } catch (t: Throwable) {
+                    null
+                }
+            val dark =
+                if (colors != null) {
+                    val hints = colors.colorHints
+                    when {
+                        (hints and
+                            android.app.WallpaperColors.HINT_SUPPORTS_DARK_TEXT) != 0 -> false
+                        (hints and
+                            android.app.WallpaperColors.HINT_SUPPORTS_DARK_THEME) != 0 -> true
+                        else -> colors.primaryColor.luminance() < 0.5f
+                    }
+                } else {
+                    (ctx.resources.configuration.uiMode and
+                        android.content.res.Configuration.UI_MODE_NIGHT_MASK) ==
+                        android.content.res.Configuration.UI_MODE_NIGHT_YES
+                }
+            return if (dark) Color.WHITE else DOZE_COLOR
         }
     }
 
