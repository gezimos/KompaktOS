@@ -0,0 +1,112 @@
+/* Kompakt: the card MuditaOS shows when the Offline+ switch moves. */
+package com.android.systemui.statusbar.phone;
+
+import android.app.Dialog;
+import android.content.Context;
+import android.graphics.Typeface;
+import android.os.Handler;
+import android.util.Log;
+import android.view.Gravity;
+import android.view.View;
+import android.view.Window;
+import android.view.WindowManager;
+import android.widget.ImageView;
+import android.widget.TextView;
+
+import com.android.systemui.res.R;
+
+final class KompaktOfflineCard {
+
+    private static final String TAG = "KompaktOfflineCard";
+
+    /** Stock dismisses after exactly this long, restarting on each flip. */
+    private static final long SHOW_MS = 1000L;
+
+    /** Stock's y offset, in pixels, which puts the card just under the status bar. */
+    private static final int Y_PX = 218;
+
+    private final Context mContext;
+    private final Handler mHandler;
+
+    private Dialog mDialog;
+    private ImageView mConnectedBar;
+    private TextView mConnectedText;
+    private ImageView mOfflineBar;
+    private TextView mOfflineText;
+    private Typeface mNormal;
+    private Typeface mBold;
+
+    private final Runnable mDismiss = () -> {
+        if (mDialog != null && mDialog.isShowing()) {
+            mDialog.dismiss();
+        }
+    };
+
+    KompaktOfflineCard(Context context, Handler handler) {
+        mContext = context;
+        mHandler = handler;
+    }
+
+    void show(boolean offline) {
+        try {
+            if (mDialog == null) {
+                create();
+            }
+            bind(offline);
+            if (!mDialog.isShowing()) {
+                mDialog.show();
+            }
+            mHandler.removeCallbacks(mDismiss);
+            mHandler.postDelayed(mDismiss, SHOW_MS);
+        } catch (RuntimeException e) {
+            // A card that fails to draw must never take SystemUI down with it.
+            Log.e(TAG, "could not show the Offline+ card", e);
+        }
+    }
+
+    private void create() {
+        final Dialog d = new Dialog(mContext);
+        final Window w = d.getWindow();
+        w.requestFeature(Window.FEATURE_NO_TITLE);
+        d.setContentView(R.layout.kompakt_offline_card);
+        w.setLayout(WindowManager.LayoutParams.WRAP_CONTENT,
+                WindowManager.LayoutParams.WRAP_CONTENT);
+        w.setGravity(Gravity.START | Gravity.TOP);
+        w.setType(WindowManager.LayoutParams.TYPE_VOLUME_OVERLAY);
+        w.addFlags(WindowManager.LayoutParams.FLAG_HARDWARE_ACCELERATED
+                | WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE
+                | WindowManager.LayoutParams.FLAG_NOT_TOUCH_MODAL);
+        // Stock clears exactly these.
+        w.clearFlags(WindowManager.LayoutParams.FLAG_DIM_BEHIND
+                | WindowManager.LayoutParams.FLAG_LAYOUT_IN_SCREEN
+                | WindowManager.LayoutParams.FLAG_LAYOUT_INSET_DECOR);
+        w.setWindowAnimations(0);
+        w.setBackgroundDrawableResource(android.R.color.transparent);
+        final WindowManager.LayoutParams lp = w.getAttributes();
+        lp.x = 0;
+        lp.y = Y_PX;
+        w.setAttributes(lp);
+        d.setCanceledOnTouchOutside(true);
+
+        mConnectedBar = d.findViewById(R.id.kompakt_offline_connected_bar);
+        mConnectedText = d.findViewById(R.id.kompakt_offline_connected_text);
+        mOfflineBar = d.findViewById(R.id.kompakt_offline_offline_bar);
+        mOfflineText = d.findViewById(R.id.kompakt_offline_offline_text);
+
+        final Typeface base = mConnectedText.getTypeface();
+        mNormal = Typeface.create(base, Typeface.NORMAL);
+        mBold = Typeface.create(base, Typeface.BOLD);
+        mDialog = d;
+    }
+
+    /** The active row gets the bar and bold; the other loses both. */
+    private void bind(boolean offline) {
+        style(mConnectedBar, mConnectedText, !offline);
+        style(mOfflineBar, mOfflineText, offline);
+    }
+
+    private void style(ImageView bar, TextView text, boolean active) {
+        bar.setVisibility(active ? View.VISIBLE : View.INVISIBLE);
+        text.setTypeface(active ? mBold : mNormal);
+    }
+}
