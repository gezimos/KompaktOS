                     mCallback.handleSwipeableViewTranslation((SwipeableView) v, translate);
@@ -413,6 +418,9 @@ class NotificationSwipeHelper extends SwipeHelper implements NotificationSwipeAc
 
     @Override
     public float getTranslation(View v) {
+        if (v instanceof ExpandableNotificationRow row) {
+            return row.getSwipeOffset();
+        }
         if (v instanceof SwipeableView) {
             return ((SwipeableView) v).getTranslation();
         }
