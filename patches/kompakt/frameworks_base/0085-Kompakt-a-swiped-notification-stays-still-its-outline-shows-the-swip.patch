+    // Kompakt: a swipe leaves the card still; its outline turns to dashes as it goes.
+    private float mSwipeOffset;
+
+    /** Kompakt: the swipe distance, which the swipe code reads in place of the translation. */
+    public void setSwipeOffset(float offset) {
+        mSwipeOffset = offset;
+        if (mBackgroundNormal != null && getWidth() > 0) {
+            mBackgroundNormal.setSwipeProgress(Math.abs(offset)
+                    / (getWidth() * SwipeHelper.SWIPED_FAR_ENOUGH_SIZE_FRACTION), offset >= 0);
+        }
+    }
+
+    public float getSwipeOffset() {
+        return mSwipeOffset;
+    }
+
     @Override
     public void setTranslation(float translationX) {
         invalidate();
diff --git a/packages/SystemUI/src/com/android/systemui/statusbar/notification/row/NotificationBackgroundView.java b/packages/SystemUI/src/com/android/systemui/statusbar/notification/row/NotificationBackgroundView.java
index a1987581fab3..7003f7cddd91 100644
--- a/packages/SystemUI/src/com/android/systemui/statusbar/notification/row/NotificationBackgroundView.java
+++ b/packages/SystemUI/src/com/android/systemui/statusbar/notification/row/NotificationBackgroundView.java
@@ -22,10 +22,13 @@ import static com.android.systemui.util.ColorUtilKt.hexColorString;
 import android.content.Context;
 import android.content.res.ColorStateList;
 import android.graphics.Canvas;
+import android.graphics.DashPathEffect;
+import android.graphics.Paint;
 import android.graphics.Path;
 import android.graphics.PorterDuff;
 import android.graphics.PorterDuffColorFilter;
 import android.graphics.Rect;
+import android.graphics.RectF;
 import android.graphics.drawable.Drawable;
 import android.graphics.drawable.GradientDrawable;
 import android.graphics.drawable.LayerDrawable;
@@ -80,6 +83,13 @@ public class NotificationBackgroundView extends View implements Dumpable,
     // True only if the dismiss button is visible.
     private boolean mDrawDismissButtonCutout = false;
 
+    // Kompakt: swipe progress in eight steps; the outline is dashed that far across, from the side the swipe leaves.
+    private static final int SWIPE_STEPS = 8;
+    private int mSwipeStep;
+    private boolean mSwipeRight;
+    private Paint mSwipePaint;
+    private DashPathEffect mSwipeDashes;
+
     public NotificationBackgroundView(Context context, AttributeSet attrs) {
         super(context, attrs);
         mDontModifyCorners = getResources().getBoolean(R.bool.config_clipNotificationsToOutline);
@@ -137,6 +147,7 @@ public class NotificationBackgroundView extends View implements Dumpable,
             if (mBackground != null) {
                 mBackground.setBounds(backgroundBounds);
                 mBackground.draw(canvas);
+                drawSwipeOutline(canvas, backgroundBounds);
             }
 
             canvas.restore();
@@ -231,7 +242,52 @@ public class NotificationBackgroundView extends View implements Dumpable,
             }
             drawable.setBounds(left, top, right, bottom);
             drawable.draw(canvas);
+            drawSwipeOutline(canvas, drawable.getBounds());
+        }
+    }
+
+    /** Kompakt: dashes the outline that share of the way across, 0 to 1, from the left for a right swipe. */
+    public void setSwipeProgress(float progress, boolean right) {
+        int step = Math.round(Math.min(1f, progress) * SWIPE_STEPS);
+        if (step == mSwipeStep && (step == 0 || right == mSwipeRight)) return;
+        mSwipeStep = step;
+        mSwipeRight = right;
+        invalidate();
+    }
+
+    private void drawSwipeOutline(Canvas canvas, Rect bounds) {
+        if (mSwipeStep == 0 || !(mBackground instanceof LayerDrawable)) return;
+        Drawable base = getBaseBackgroundLayer();
+        if (!(base instanceof GradientDrawable) || ((GradientDrawable) base).getColor() == null) {
+            return;
+        }
+        final float stroke = 2f;
+        if (mSwipePaint == null) {
+            mSwipePaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+            mSwipePaint.setStyle(Paint.Style.STROKE);
+            mSwipeDashes = new DashPathEffect(new float[] {10f, 8f}, 0f);
+        }
+        RectF r = new RectF(bounds);
+        r.inset(stroke / 2f, stroke / 2f);
+        Path dashed = new Path();
+        dashed.addRoundRect(r, mCornerRadii, Path.Direction.CW);
+        int reach = bounds.width() * mSwipeStep / SWIPE_STEPS;
+        canvas.save();
+        if (mSwipeRight) {
+            canvas.clipRect(bounds.left, bounds.top, bounds.left + reach, bounds.bottom);
+        } else {
+            canvas.clipRect(bounds.right - reach, bounds.top, bounds.right, bounds.bottom);
         }
+        // Paint over the solid outline with the card colour, then draw the dashes.
+        mSwipePaint.setPathEffect(null);
+        mSwipePaint.setStrokeWidth(stroke + 2f);
+        mSwipePaint.setColor(((GradientDrawable) base).getColor().getDefaultColor());
+        canvas.drawPath(dashed, mSwipePaint);
+        mSwipePaint.setPathEffect(mSwipeDashes);
+        mSwipePaint.setStrokeWidth(stroke);
+        mSwipePaint.setColor(mContext.getColor(R.color.kompakt_notification_outline));
+        canvas.drawPath(dashed, mSwipePaint);
+        canvas.restore();
     }
 
     @Override
diff --git a/packages/SystemUI/src/com/android/systemui/statusbar/notification/stack/NotificationStackScrollLayout.java b/packages/SystemUI/src/com/android/systemui/statusbar/notification/stack/NotificationStackScrollLayout.java
index 8ce2b5f637a1..20b5d3ebbc29 100644
--- a/packages/SystemUI/src/com/android/systemui/statusbar/notification/stack/NotificationStackScrollLayout.java
+++ b/packages/SystemUI/src/com/android/systemui/statusbar/notification/stack/NotificationStackScrollLayout.java
@@ -3286,7 +3286,10 @@ public class NotificationStackScrollLayout
      * Has this view been fully swiped out such that it's not visible anymore.
      */
     public boolean isFullySwipedOut(ExpandableView child) {
-        return Math.abs(child.getTranslation()) >= Math.abs(getTotalTranslationLength(child));
+        // Kompakt: a swiped row does not move; its swipe offset says how far it went.
+        float swiped = child instanceof ExpandableNotificationRow row
+                ? row.getSwipeOffset() : child.getTranslation();
+        return Math.abs(swiped) >= Math.abs(getTotalTranslationLength(child));
     }
 
     private void focusNextViewIfFocused(View view) {
