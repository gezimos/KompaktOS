@@ -402,6 +402,11 @@ class NotificationSwipeHelper extends SwipeHelper implements NotificationSwipeAc
 
     @Override
     public void setTranslation(View v, float translate) {
+        // Kompakt: a row keeps still; the swipe only moves its offset.
+        if (v instanceof ExpandableNotificationRow row) {
+            row.setSwipeOffset(translate);
