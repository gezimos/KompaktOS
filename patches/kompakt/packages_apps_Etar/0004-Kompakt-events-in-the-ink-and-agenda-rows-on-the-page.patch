Subject: [PATCH 1/1] Kompakt: events in the ink and agenda rows on the page

---
diff --git a/app/src/main/java/com/android/calendar/Utils.java b/app/src/main/java/com/android/calendar/Utils.java
--- a/app/src/main/java/com/android/calendar/Utils.java
+++ b/app/src/main/java/com/android/calendar/Utils.java
@@ -889,6 +889,10 @@
      * @param color
      */
     public static int getDisplayColorFromColor(Context context, int color) {
+        // Kompakt: every event is drawn in the ink.
+        if (context != null) {
+            return context.getColor(R.color.kompakt_event_ink);
+        }
         if (!Utils.getSharedPreference(context, GeneralPreferences.KEY_REAL_EVENT_COLORS, false)) {
             float[] hsv = new float[3];
             Color.colorToHSV(color, hsv);
