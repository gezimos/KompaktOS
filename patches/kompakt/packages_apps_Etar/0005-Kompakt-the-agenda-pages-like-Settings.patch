diff --git a/app/src/main/java/com/kompakt/eink/PageGestureListener.java b/app/src/main/java/com/kompakt/eink/PageGestureListener.java
new file mode 100644
--- /dev/null
+++ b/app/src/main/java/com/kompakt/eink/PageGestureListener.java
@@ -0,0 +1,84 @@
+package com.kompakt.eink;
+
+import android.content.Context;
+import android.view.GestureDetector;
+import android.view.MotionEvent;
+
+/** Turns touch into page moves, matching inkOS (ui/compose/GestureHelper.kt). */
+final class PageGestureListener extends GestureDetector.SimpleOnGestureListener {
+
+    /** What to do with a page move; delta is +1 (down/forward) or -1 (up/back). */
+    interface Pager {
+        boolean page(int delta);
+    }
+
+    /** Drag distance before a page turns. */
+    private static final float THRESHOLD_DP = 56f;
+    private static final long COOLDOWN_MS = 200L;
+
+    /** Minimum vertical fling speed, dp/s. */
+    private static final float MIN_FLING_DP_PER_S = 600f;
+
+    /** How many pages the hardest flick may cover. */
+    private static final int MAX_FLING_PAGES = 5;
+
+    private final Pager pager;
+    private final float thresholdPx;
+    private final float minFlingPxPerS;
+
+    private float lastPageMoveY;
+    private long lastPageMoveTime;
+    /** inkOS's scrollPageMoveTriggered: did this gesture already page while dragging? */
+    private boolean pagedDuringDrag;
+
+    PageGestureListener(Context context, Pager pager) {
+        this.pager = pager;
+        final float density = context.getResources().getDisplayMetrics().density;
+        this.thresholdPx = Math.max(8f, THRESHOLD_DP * density);
+        this.minFlingPxPerS = MIN_FLING_DP_PER_S * density;
+    }
+
+    @Override
+    public boolean onDown(MotionEvent e) {
+        // Measure the next drag from here, not from the previous gesture.
+        lastPageMoveY = e.getY();
+        pagedDuringDrag = false;
+        return true;
+    }
+
+    @Override
+    public boolean onScroll(MotionEvent down, MotionEvent now, float dx, float dy) {
+        if (down == null) return false;
+
+        // Vertical-dominant only.
+        if (Math.abs(now.getX() - down.getX()) > Math.abs(now.getY() - down.getY())) return false;
+
+        final float travelled = now.getY() - lastPageMoveY;
+        if (Math.abs(travelled) <= thresholdPx) return false;
+
+        final long t = android.os.SystemClock.uptimeMillis();
+        if (t - lastPageMoveTime < COOLDOWN_MS) return false;
+
+        // Dragging content up (negative) means "go down a page".
+        if (!pager.page(travelled < 0 ? 1 : -1)) return false;
+        lastPageMoveTime = t;
+        lastPageMoveY = now.getY();
+        pagedDuringDrag = true;
+        return true;
+    }
+
+    @Override
+    public boolean onFling(MotionEvent down, MotionEvent up, float vx, float vy) {
+        // A drag that already paged must not page again on lift.
+        if (pagedDuringDrag) return false;
+        // Vertical-dominant, and fast enough to be a deliberate flick.
+        if (Math.abs(vy) < Math.abs(vx)) return false;
+        if (Math.abs(vy) < minFlingPxPerS) return false;
+        // ...and far enough.
+        if (down != null && up != null
+                && Math.abs(up.getY() - down.getY()) < thresholdPx) return false;
+        final int pages = Math.max(1,
+                Math.min(MAX_FLING_PAGES, (int) (Math.abs(vy) / minFlingPxPerS)));
+        return pager.page(vy < 0 ? pages : -pages);
+    }
+}
diff --git a/app/src/main/java/com/kompakt/eink/PagedList.java b/app/src/main/java/com/kompakt/eink/PagedList.java
new file mode 100644
--- /dev/null
+++ b/app/src/main/java/com/kompakt/eink/PagedList.java
@@ -0,0 +1,83 @@
+package com.kompakt.eink;
+
+import android.os.SystemClock;
+import android.view.GestureDetector;
+import android.view.MotionEvent;
+import android.view.View;
+import android.view.ViewConfiguration;
+import android.widget.ListView;
+
+/** Paged scrolling for a ListView, as PagedScroll does it for a RecyclerView in Settings. */
+public final class PagedList {
+
+    private PagedList() {}
+
+    public static void attach(final ListView list) {
+        if (list == null) return;
+        final int slop = ViewConfiguration.get(list.getContext()).getScaledTouchSlop();
+        final boolean[] cancelled = new boolean[1];
+        final float[] downY = new float[1];
+
+        final GestureDetector detector = new GestureDetector(list.getContext(),
+                new PageGestureListener(list.getContext(), delta -> {
+                    // A swipe that turns a page is not a tap or a long press on a row.
+                    cancelRow(list, cancelled);
+                    return page(list, delta);
+                }));
+
+        list.setOnTouchListener((View v, MotionEvent e) -> {
+            detector.onTouchEvent(e);
+            switch (e.getActionMasked()) {
+                case MotionEvent.ACTION_DOWN:
+                    cancelled[0] = false;
+                    downY[0] = e.getY();
+                    return false;
+                case MotionEvent.ACTION_MOVE:
+                    // The list never drags; past the slop the row under the finger lets go.
+                    if (Math.abs(e.getY() - downY[0]) > slop) cancelRow(list, cancelled);
+                    return true;
+                case MotionEvent.ACTION_UP:
+                case MotionEvent.ACTION_CANCEL:
+                    return cancelled[0];
+                default:
+                    return false;
+            }
+        });
+    }
+
+    private static void cancelRow(ListView list, boolean[] cancelled) {
+        if (cancelled[0]) return;
+        cancelled[0] = true;
+        final long t = SystemClock.uptimeMillis();
+        final MotionEvent cancel = MotionEvent.obtain(t, t, MotionEvent.ACTION_CANCEL, 0, 0, 0);
+        list.onTouchEvent(cancel);
+        cancel.recycle();
+    }
+
+    /** One page: forward to the first row the bottom edge cuts, back by a screen. */
+    private static boolean page(ListView list, int delta) {
+        if (delta == 0 || list.getChildCount() == 0) return false;
+        if (!list.canScrollList(delta > 0 ? 1 : -1)) return false;
+        final int topEdge = list.getPaddingTop();
+        final int bottomEdge = list.getHeight() - list.getPaddingBottom();
+        final int viewport = bottomEdge - topEdge;
+        if (viewport <= 0) return false;
+        if (delta > 0) {
+            for (int c = 1, n = list.getChildCount(); c < n; c++) {
+                if (list.getChildAt(c).getBottom() > bottomEdge) {
+                    list.setSelectionFromTop(list.getFirstVisiblePosition() + c, topEdge);
+                    return true;
+                }
+            }
+            list.scrollListBy(viewport);
+        } else {
+            list.scrollListBy(-viewport);
+            final View top = list.getChildAt(0);
+            if (top != null && top.getTop() < topEdge) {
+                list.setSelectionFromTop(list.getFirstVisiblePosition(), topEdge);
+            }
+        }
+        return true;
+    }
+
+}
