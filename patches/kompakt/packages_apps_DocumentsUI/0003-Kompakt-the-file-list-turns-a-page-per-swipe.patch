From: Gezim <gezimos@users.noreply.github.com>
Date: Sun, 11 Oct 2026 19:00:00 +0200
Subject: [PATCH 1/1] Kompakt: the file list turns a page per swipe

Files scrolled with the finger like any list, a run of repaints on e-ink,
while Settings, Music and the shade turn pages. DirectoryFragment builds
its grid as PagedScroll.PagedLayoutManager (Twelve PagedScroll, taking no
drag) and attaches the same gesture: a drag or fling turns one page,
breaking at the top of the first row the bottom edge cuts. The header
above the list (path, filter chips) no longer scrolls with it, so it is
held as Twelve holds a cover: the first page forward hides it in one step,
a page back from the top brings it back, a swipe on it does the same, and
it cannot be dragged. It is looked up on the first touch, since the list
is built before it is placed under the header.

---
diff --git a/src/com/android/documentsui/dirlist/DirectoryFragment.java b/src/com/android/documentsui/dirlist/DirectoryFragment.java
--- a/src/com/android/documentsui/dirlist/DirectoryFragment.java
+++ b/src/com/android/documentsui/dirlist/DirectoryFragment.java
@@ -83,6 +83,8 @@ import androidx.recyclerview.widget.GridLayoutManager.SpanSizeLookup;
 import androidx.recyclerview.widget.RecyclerView;
 import androidx.recyclerview.widget.RecyclerView.RecyclerListener;
 import androidx.recyclerview.widget.RecyclerView.ViewHolder;
+
+import com.kompakt.eink.PagedScroll;
 import androidx.swiperefreshlayout.widget.SwipeRefreshLayout;
 
 import com.android.documentsui.ActionHandler;
@@ -576,7 +578,8 @@ public class DirectoryFragment extends Fragment implements SwipeRefreshLayout.On
 
         mRecView.setAdapter(mAdapter);
 
-        mLayout = new GridLayoutManager(getContext(), mColumnCount) {
+        // Kompakt: the list turns a page per swipe, as Settings and Music do.
+        mLayout = new PagedScroll.PagedLayoutManager(getContext(), mColumnCount) {
             @Override
             public void onLayoutCompleted(RecyclerView.State state) {
                 super.onLayoutCompleted(state);
@@ -589,6 +592,7 @@ public class DirectoryFragment extends Fragment implements SwipeRefreshLayout.On
             mLayout.setSpanSizeLookup(lookup);
         }
         mRecView.setLayoutManager(mLayout);
+        PagedScroll.attach(mRecView, (PagedScroll.PagedLayoutManager) mLayout);
 
         mModel.addUpdateListener(mAdapter.getModelUpdateListener());
         mModel.addUpdateListener(mModelUpdateListener);
diff --git a/src/com/kompakt/eink/PageGestureListener.java b/src/com/kompakt/eink/PageGestureListener.java
new file mode 100755
--- /dev/null
+++ b/src/com/kompakt/eink/PageGestureListener.java
@@ -0,0 +1,84 @@
+package com.kompakt.eink;
+
+import android.content.Context;
+import android.view.GestureDetector;
+import android.view.MotionEvent;
+
+/** Turns touch into page moves, matching inkOS (ui/compose/GestureHelper.kt). */
+final class PageGestureListener extends GestureDetector.SimpleOnGestureListener {
+
+    /** What to do with a page move; delta is +1 (down/forward) or -1 (up/back). */
+    interface Pager {
+        boolean page(int delta);
+    }
+
+    /** Drag distance before a page turns. */
+    private static final float THRESHOLD_DP = 56f;
+    private static final long COOLDOWN_MS = 200L;
+
+    /** Minimum vertical fling speed, dp/s. */
+    private static final float MIN_FLING_DP_PER_S = 600f;
+
+    /** How many pages the hardest flick may cover. */
+    private static final int MAX_FLING_PAGES = 5;
+
+    private final Pager pager;
+    private final float thresholdPx;
+    private final float minFlingPxPerS;
+
+    private float lastPageMoveY;
+    private long lastPageMoveTime;
+    /** inkOS's scrollPageMoveTriggered: did this gesture already page while dragging? */
+    private boolean pagedDuringDrag;
+
+    PageGestureListener(Context context, Pager pager) {
+        this.pager = pager;
+        final float density = context.getResources().getDisplayMetrics().density;
+        this.thresholdPx = Math.max(8f, THRESHOLD_DP * density);
+        this.minFlingPxPerS = MIN_FLING_DP_PER_S * density;
+    }
+
+    @Override
+    public boolean onDown(MotionEvent e) {
+        // Measure the next drag from here, not from the previous gesture.
+        lastPageMoveY = e.getY();
+        pagedDuringDrag = false;
+        return true;
+    }
+
+    @Override
+    public boolean onScroll(MotionEvent down, MotionEvent now, float dx, float dy) {
+        if (down == null) return false;
+
+        // Vertical-dominant only.
+        if (Math.abs(now.getX() - down.getX()) > Math.abs(now.getY() - down.getY())) return false;
+
+        final float travelled = now.getY() - lastPageMoveY;
+        if (Math.abs(travelled) <= thresholdPx) return false;
+
+        final long t = android.os.SystemClock.uptimeMillis();
+        if (t - lastPageMoveTime < COOLDOWN_MS) return false;
+
+        // Dragging content up (negative) means "go down a page".
+        if (!pager.page(travelled < 0 ? 1 : -1)) return false;
+        lastPageMoveTime = t;
+        lastPageMoveY = now.getY();
+        pagedDuringDrag = true;
+        return true;
+    }
+
+    @Override
+    public boolean onFling(MotionEvent down, MotionEvent up, float vx, float vy) {
+        // A drag that already paged must not page again on lift.
+        if (pagedDuringDrag) return false;
+        // Vertical-dominant, and fast enough to be a deliberate flick.
+        if (Math.abs(vy) < Math.abs(vx)) return false;
+        if (Math.abs(vy) < minFlingPxPerS) return false;
+        // ...and far enough.
+        if (down != null && up != null
+                && Math.abs(up.getY() - down.getY()) < thresholdPx) return false;
+        final int pages = Math.max(1,
+                Math.min(MAX_FLING_PAGES, (int) (Math.abs(vy) / minFlingPxPerS)));
+        return pager.page(vy < 0 ? pages : -pages);
+    }
+}
diff --git a/src/com/kompakt/eink/PagedScroll.java b/src/com/kompakt/eink/PagedScroll.java
new file mode 100644
--- /dev/null
+++ b/src/com/kompakt/eink/PagedScroll.java
@@ -0,0 +1,220 @@
+package com.kompakt.eink;
+
+import android.view.GestureDetector;
+import android.view.MotionEvent;
+import android.view.View;
+import android.view.ViewGroup;
+import android.view.ViewParent;
+
+import androidx.annotation.NonNull;
+import androidx.coordinatorlayout.widget.CoordinatorLayout;
+import androidx.recyclerview.widget.GridLayoutManager;
+import androidx.recyclerview.widget.RecyclerView;
+
+import com.google.android.material.appbar.AppBarLayout;
+
+/** Paged scrolling for the Files list: Twelve's PagedScroll, on the grid DirectoryFragment builds. */
+public final class PagedScroll {
+
+    private PagedScroll() {}
+
+    /** Pages the list on its PagedLayoutManager, which DirectoryFragment builds and keeps. */
+    public static void attach(final RecyclerView rv, final PagedLayoutManager lm) {
+        if (rv == null || lm == null) return;
+        // Kompakt: rows scrolled past the top must not draw above the list.
+        rv.setOutlineProvider(android.view.ViewOutlineProvider.BOUNDS);
+        rv.setClipToOutline(true);
+
+        // The list is made before it is placed under the header, so find the header on first touch.
+        final AppBarLayout[] bar = {null};
+        final boolean[] looked = {false};
+
+        // fling = one page; dragging keeps paging as the finger travels (inkOS behaviour)
+        final GestureDetector detector = new GestureDetector(rv.getContext(),
+                new PageGestureListener(rv.getContext(), new PageGestureListener.Pager() {
+                    @Override
+                    public boolean page(int delta) {
+                        return PagedScroll.page(rv, lm, bar[0], delta);
+                    }
+                }));
+
+        rv.addOnItemTouchListener(new RecyclerView.OnItemTouchListener() {
+            @Override
+            public boolean onInterceptTouchEvent(@NonNull RecyclerView r, @NonNull MotionEvent e) {
+                if (!looked[0]) {
+                    looked[0] = true;
+                    bar[0] = holdHeader(rv);
+                }
+                detector.onTouchEvent(e);
+                return false; // let taps through to the rows themselves
+            }
+
+            @Override
+            public void onTouchEvent(@NonNull RecyclerView r, @NonNull MotionEvent e) {
+            }
+
+            @Override
+            public void onRequestDisallowInterceptTouchEvent(boolean disallow) {
+            }
+        });
+    }
+
+    /** Kompakt: the header (path, filter chips) hides on the first page forward and returns past the top, in one step. */
+    private static boolean page(RecyclerView rv, PagedLayoutManager lm, AppBarLayout bar,
+            int delta) {
+        if (bar != null && delta > 0 && !collapsed(bar)) {
+            bar.setExpanded(false, false);
+            return true;
+        }
+        final boolean moved = page(rv, lm, delta);
+        if (!moved && bar != null && delta < 0 && collapsed(bar)) {
+            bar.setExpanded(true, false);
+            return true;
+        }
+        return moved;
+    }
+
+    private static boolean collapsed(AppBarLayout bar) {
+        return bar.getTop() <= -bar.getTotalScrollRange();
+    }
+
+    /** The list's collapsing header, made to jump instead of following the finger; null if none. */
+    private static AppBarLayout holdHeader(final RecyclerView rv) {
+        ViewParent p = rv.getParent();
+        while (p != null && !(p instanceof CoordinatorLayout)) p = p.getParent();
+        if (p == null) return null;
+        final ViewGroup coordinator = (ViewGroup) p;
+        AppBarLayout found = null;
+        for (int i = 0; i < coordinator.getChildCount(); i++) {
+            if (coordinator.getChildAt(i) instanceof AppBarLayout) {
+                found = (AppBarLayout) coordinator.getChildAt(i);
+            }
+        }
+        if (found == null || found.getChildCount() == 0) return null;
+        // Only a header that collapses: the first child carries the scroll flag.
+        final ViewGroup.LayoutParams first = found.getChildAt(0).getLayoutParams();
+        if (!(first instanceof AppBarLayout.LayoutParams) || (((AppBarLayout.LayoutParams) first)
+                .getScrollFlags() & AppBarLayout.LayoutParams.SCROLL_FLAG_SCROLL) == 0) {
+            return null;
+        }
+        final AppBarLayout bar = found;
+        // No drag: on e-ink a header that follows the finger is a smear of repaints.
+        // Its own behaviour if it has one: a new one would forget the current offset.
+        final CoordinatorLayout.LayoutParams lp = (CoordinatorLayout.LayoutParams) bar.getLayoutParams();
+        final AppBarLayout.Behavior behavior = lp.getBehavior() instanceof AppBarLayout.Behavior
+                ? (AppBarLayout.Behavior) lp.getBehavior() : new AppBarLayout.Behavior();
+        behavior.setDragCallback(new AppBarLayout.Behavior.DragCallback() {
+            @Override
+            public boolean canDrag(@NonNull AppBarLayout appBarLayout) {
+                return false;
+            }
+        });
+        lp.setBehavior(behavior);
+        // A swipe on the header itself pages too.
+        final GestureDetector detector = new GestureDetector(rv.getContext(),
+                new PageGestureListener(rv.getContext(), new PageGestureListener.Pager() {
+                    @Override
+                    public boolean page(int delta) {
+                        final boolean hide = delta > 0;
+                        if (hide == collapsed(bar)) return false;
+                        bar.setExpanded(!hide, false);
+                        return true;
+                    }
+                }));
+        bar.setOnTouchListener((v, e) -> {
+            detector.onTouchEvent(e);
+            return true;
+        });
+        return bar;
+    }
+
+    /** Move by whole pages, in pixels, measured off the rows that are on screen. */
+    private static boolean page(RecyclerView rv, PagedLayoutManager lm, int delta) {
+        if (delta == 0) return false;
+        final int viewport = rv.getHeight() - rv.getPaddingTop() - rv.getPaddingBottom();
+        if (viewport <= 0) return false;
+
+        // scrollBy() is a no-op while the LayoutManager refuses vertical scrolling, so open the gate.
+        lm.allowProgrammaticScroll = true;
+        try {
+            final long before = mark(rv, lm);
+            for (int i = Math.abs(delta); i > 0; i--) {
+                if (delta > 0) {
+                    forward(rv, lm, viewport);
+                } else {
+                    rv.scrollBy(0, -viewport);
+                    snapTopRowWhole(rv, lm);
+                }
+            }
+            // Ask the screen whether anything moved; at either end nothing does.
+            return mark(rv, lm) != before;
+        } finally {
+            lm.allowProgrammaticScroll = false;
+        }
+    }
+
+    /** Forward one page: to the top of the first row the bottom edge cuts. */
+    private static void forward(RecyclerView rv, PagedLayoutManager lm, int viewport) {
+        final int topEdge = rv.getPaddingTop();
+        final int bottomEdge = rv.getHeight() - rv.getPaddingBottom();
+
+        // Child order is not guaranteed, so take the smallest qualifying top rather than the first one found.
+        int next = Integer.MAX_VALUE;
+        for (int i = 0, n = lm.getChildCount(); i < n; i++) {
+            final View row = lm.getChildAt(i);
+            if (row == null) continue;
+            if (lm.getDecoratedBottom(row) > bottomEdge && lm.getDecoratedTop(row) < next) {
+                next = lm.getDecoratedTop(row);
+            }
+        }
+
+        int dy = (next == Integer.MAX_VALUE) ? viewport : next - topEdge;
+        // A row taller than the whole page would stand still forever.
+        if (dy <= 0) dy = viewport;
+        rv.scrollBy(0, dy);
+    }
+
+    /** Pull the row under the top edge down until it is whole. */
+    private static void snapTopRowWhole(RecyclerView rv, PagedLayoutManager lm) {
+        final int topEdge = rv.getPaddingTop();
+        for (int i = 0, n = lm.getChildCount(); i < n; i++) {
+            final View row = lm.getChildAt(i);
+            if (row == null) continue;
+            if (lm.getDecoratedTop(row) <= topEdge && lm.getDecoratedBottom(row) > topEdge) {
+                final int dy = lm.getDecoratedTop(row) - topEdge;
+                if (dy < 0) rv.scrollBy(0, dy);
+                return;
+            }
+        }
+    }
+
+    /** Where the list is, exactly: which row is at the top and how far into it we are. */
+    private static long mark(RecyclerView rv, PagedLayoutManager lm) {
+        final int first = lm.findFirstVisibleItemPosition();
+        if (first == RecyclerView.NO_POSITION) return Long.MIN_VALUE;
+        final View row = lm.findViewByPosition(first);
+        final int top = (row == null) ? 0 : lm.getDecoratedTop(row);
+        return ((long) first << 32) | (top & 0xffffffffL);
+    }
+
+    /** Reports "cannot scroll vertically" to touch handling, which is what stops the finger dragging the list at all. */
+    public static class PagedLayoutManager extends GridLayoutManager {
+        boolean allowProgrammaticScroll = false;
+
+        public PagedLayoutManager(android.content.Context context, int span) {
+            super(context, span);
+        }
+
+        @Override
+        public boolean canScrollVertically() {
+            return allowProgrammaticScroll;
+        }
+
+        /** A requested position lands at the top of the page; the gate above would stop a smooth scroll. */
+        @Override
+        public void smoothScrollToPosition(RecyclerView recyclerView, RecyclerView.State state,
+                int position) {
+            scrollToPositionWithOffset(position, 0);
+        }
+    }
+}
-- 
