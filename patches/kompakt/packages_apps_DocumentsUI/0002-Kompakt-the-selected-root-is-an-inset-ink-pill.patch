From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Gezim <gezimos@users.noreply.github.com>
Date: Mon, 5 Oct 2026 23:55:00 +0200
Subject: [PATCH 1/1] Kompakt: the selected root is an inset ink pill

---
diff --git a/res/drawable/root_list_selector.xml b/res/drawable/root_list_selector.xml
--- a/res/drawable/root_list_selector.xml
+++ b/res/drawable/root_list_selector.xml
@@ -15,16 +15,11 @@
 -->
 
 <inset xmlns:android="http://schemas.android.com/apk/res/android"
-       android:inset="8dp">
+       android:insetLeft="12dp" android:insetRight="12dp">
     <shape
-        xmlns:android="http://schemas.android.com/apk/res/android"
         android:shape="rectangle">
-        <corners
-            android:topLeftRadius="2dp"
-            android:topRightRadius="2dp"
-            android:bottomLeftRadius="2dp"
-            android:bottomRightRadius="2dp"/>
-        <solid
-            android:color="?android:attr/colorSecondary"/>
+        <!-- Kompakt: the selected root is an ink pill, as in Calendar. -->
+        <corners android:radius="24dp"/>
+        <solid android:color="@color/kompakt_ink"/>
     </shape>
 </inset>
\ No newline at end of file
diff --git a/res/layout/item_root.xml b/res/layout/item_root.xml
--- a/res/layout/item_root.xml
+++ b/res/layout/item_root.xml
@@ -18,8 +18,8 @@
     xmlns:android="http://schemas.android.com/apk/res/android"
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
-    android:minHeight="52dp"
-    android:paddingStart="24dp"
+    android:minHeight="48dp"
+    android:paddingStart="28dp"
     android:gravity="center_vertical"
     android:orientation="horizontal"
     android:baselineAligned="false"
@@ -43,9 +43,9 @@
     <LinearLayout
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
-        android:paddingStart="16dp"
-        android:paddingTop="8dp"
-        android:paddingBottom="8dp"
+        android:paddingStart="12dp"
+        android:paddingTop="4dp"
+        android:paddingBottom="4dp"
         android:orientation="vertical"
         android:layout_weight="1">
 
-- 
2.43.0

