diff --git a/res/color/kompakt_doc_title.xml b/res/color/kompakt_doc_title.xml
new file mode 100644
index 000000000..8859b5ce8
--- /dev/null
+++ b/res/color/kompakt_doc_title.xml
@@ -0,0 +1,7 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- Kompakt: text on a selected (activated) row flips to the ground colour, because the row itself fills with the ink. -->
+<selector xmlns:android="http://schemas.android.com/apk/res/android">
+    <item android:state_activated="true" android:color="@color/kompakt_ground" />
+    <item android:state_enabled="false" android:alpha="0.5" android:color="@color/kompakt_ink" />
+    <item android:color="@color/kompakt_ink" />
+</selector>
