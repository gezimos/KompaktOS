diff --git a/app/src/main/java/org/lineageos/updater/updatescheck/UpdatesCheck.kt b/app/src/main/java/org/lineageos/updater/updatescheck/UpdatesCheck.kt
--- a/app/src/main/java/org/lineageos/updater/updatescheck/UpdatesCheck.kt
+++ b/app/src/main/java/org/lineageos/updater/updatescheck/UpdatesCheck.kt
@@ -17,7 +17,8 @@
 import androidx.compose.foundation.layout.padding
 import androidx.compose.foundation.layout.size
 import androidx.compose.material3.ButtonDefaults
-import androidx.compose.material3.FilledTonalButton
+import androidx.compose.foundation.BorderStroke
+import androidx.compose.material3.OutlinedButton
 import androidx.compose.material3.MaterialTheme
 import androidx.compose.material3.Text
 import androidx.compose.runtime.Composable
@@ -131,11 +132,13 @@
     onClick: () -> Unit,
     modifier: Modifier = Modifier,
 ) {
-    FilledTonalButton(
+    // Kompakt: outlined, a tonal fill is the page colour here
+    OutlinedButton(
         onClick = onClick,
         modifier = modifier.fillMaxWidth(),
-        colors = ButtonDefaults.filledTonalButtonColors(
-            containerColor = MaterialTheme.colorScheme.surfaceContainerHighest,
+        border = BorderStroke(2.dp, MaterialTheme.colorScheme.onSurface),
+        colors = ButtonDefaults.outlinedButtonColors(
+            contentColor = MaterialTheme.colorScheme.onSurface,
         ),
     ) {
         Text(text = stringResource(R.string.check_for_updates))
diff --git a/app/src/main/java/org/lineageos/updater/updates/action/UpdateAction.kt b/app/src/main/java/org/lineageos/updater/updates/action/UpdateAction.kt
--- a/app/src/main/java/org/lineageos/updater/updates/action/UpdateAction.kt
+++ b/app/src/main/java/org/lineageos/updater/updates/action/UpdateAction.kt
@@ -26,10 +26,8 @@
 
     DELETE(R.string.menu_delete_update),
     EXPORT(R.string.menu_export_update),
-    VIEW_DOWNLOADS(R.string.menu_view_downloads) {
-        override fun title(context: Context) =
-            context.getString(titleRes, context.getString(R.string.brand_name))
-    };
+    // Kompakt: our releases on GitHub, not LineageOS Downloads
+    VIEW_DOWNLOADS(R.string.menu_view_releases);
 
     open fun title(context: Context) = context.getString(titleRes)
 }
