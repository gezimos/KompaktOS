diff --git a/src/com/android/messaging/datamodel/media/AvatarRequest.java b/src/com/android/messaging/datamodel/media/AvatarRequest.java
index d3915fe..586de12 100644
--- a/src/com/android/messaging/datamodel/media/AvatarRequest.java
+++ b/src/com/android/messaging/datamodel/media/AvatarRequest.java
@@ -119,10 +119,22 @@ public class AvatarRequest extends UriImageRequest<AvatarRequestDescriptor> {
         return new DecodedImageResource(getKey(), bitmap, orientation);
     }
 
+    /** A ring around the avatar, in the same ink as the glyph inside it. */
+    private void drawKompaktRing(final Canvas canvas, final int width, final int height) {
+        final float stroke = mContext.getResources().getDisplayMetrics().density;
+        final Paint ring = new Paint(Paint.ANTI_ALIAS_FLAG);
+        ring.setStyle(Paint.Style.STROKE);
+        ring.setStrokeWidth(stroke);
+        ring.setColor(mContext.getResources().getColor(R.color.letter_tile_font_color));
+        canvas.drawCircle(width / 2f, height / 2f,
+                Math.min(width, height) / 2f - stroke / 2f, ring);
+    }
+
     private Bitmap renderDefaultAvatar(final int width, final int height) {
         final Bitmap bitmap = getBitmapPool().createOrReuseBitmap(width, height,
                 getBackgroundColor(AvatarUriUtil.getIdentifier(mDescriptor.uri)));
         final Canvas canvas = new Canvas(bitmap);
+        drawKompaktRing(canvas, width, height);
         final VectorDrawable defaultPerson = (VectorDrawable) ResourcesCompat.getDrawable(
                 mContext.getResources(), R.drawable.ic_person_light, mContext.getTheme());
         float dstWidth = Math.min(defaultPerson.getIntrinsicWidth() * SCALING_FACTOR, width);
@@ -153,6 +165,7 @@ public class AvatarRequest extends UriImageRequest<AvatarRequestDescriptor> {
         paint.getTextBounds(firstCharString, 0, 1, textBound);
 
         final Canvas canvas = new Canvas(bitmap);
+        drawKompaktRing(canvas, width, height);
         final float xOffset = halfWidth - textBound.centerX();
         final float yOffset = halfHeight - textBound.centerY();
         canvas.drawText(firstCharString, xOffset, yOffset, paint);
