     private var animator: AnimatorSet? = null
 
     private val multiValueAlpha: MultiValueAlpha =
@@ -220,9 +232,30 @@ constructor(
 
     override fun draw(canvas: Canvas) {
         super.draw(canvas)
+        drawKompaktOutline(canvas)
         focusBorderAnimator.drawBorder(canvas)
     }
 
+    /** Kompakt: trace the chip's edge, every frame. */
+    private fun drawKompaktOutline(canvas: Canvas) {
+        val bounds = backgroundRelativeLtrLocation
+        if (bounds.isEmpty) return
+        if (isLayoutRtl) {
+            kompaktOutlineBounds.set(
+                (width - bounds.right).toFloat(),
+                bounds.top.toFloat(),
+                (width - bounds.left).toFloat(),
+                bounds.bottom.toFloat(),
+            )
+        } else {
+            kompaktOutlineBounds.set(bounds)
+        }
+        val half = kompaktOutlinePaint.strokeWidth / 2f
+        kompaktOutlineBounds.inset(half, half)
+        val radius = cornerRadius - half
+        canvas.drawRoundRect(kompaktOutlineBounds, radius, radius, kompaktOutlinePaint)
+    }
+
     override fun onFinishInflate() {
         super.onFinishInflate()
         iconView = findViewById(R.id.icon_view)
@@ -335,12 +368,12 @@ constructor(
         )
     }
 
+    @Suppress("UNUSED_PARAMETER")
     private fun enableMarquee(isEnabled: Boolean) {
-        // Marquee should not be enabled when is running test harness.
-        val isMarqueeEnabled = isEnabled && !Utilities.isRunningInTestHarness()
+        // Kompakt: never, whatever the caller asks for.
         appTitle?.let {
-            it.ellipsize = if (isMarqueeEnabled) TruncateAt.MARQUEE else null
-            it.isSelected = isMarqueeEnabled
+            it.ellipsize = null
+            it.isSelected = false
         }
     }
 
