+    /** Kompakt: take the status bar while Overview is up, and give it back after. */
+    private void kompaktClaimStatusBar(boolean enabled) {
+        SystemUiController controller = mContainer.getSystemUiController();
+        if (controller == null) {
+            return;
+        }
+        if (!enabled) {
+            controller.updateUiState(SystemUiController.UI_STATE_OVERVIEW, 0);
+            return;
+        }
+        int scrim = Themes.getAttrColor(getContext(), R.attr.overviewScrimColorBlur);
+        if (Color.alpha(scrim) < 230) {
+            controller.updateUiState(SystemUiController.UI_STATE_OVERVIEW, 0);
+            return;
+        }
+        controller.updateUiState(SystemUiController.UI_STATE_OVERVIEW,
+                Color.luminance(scrim) > 0.5f);
+    }
+
     public void setOverviewStateEnabled(boolean enabled) {
         mOverviewStateEnabled = enabled;
+        kompaktClaimStatusBar(enabled);
         updateTaskStackListenerState();
         mOrientationState.setRotationWatcherEnabled(enabled);
         if (!enabled) {
@@ -4569,7 +4592,14 @@ public abstract class RecentsView<
