+    private val kompaktOutlinePaint =
+        Paint(Paint.ANTI_ALIAS_FLAG).apply {
+            style = Paint.Style.STROKE
+            // A resource, not Color.BLACK: the edge flips with the mode.
+            color = resources.getColor(R.color.kompakt_task_outline, context.theme)
