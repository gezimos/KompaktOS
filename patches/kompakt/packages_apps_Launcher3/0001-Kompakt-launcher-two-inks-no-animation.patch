index 0000000000..1f2812a96f
--- /dev/null
+++ b/src/com/kompakt/eink/IconInk.java
@@ -0,0 +1,39 @@
+package com.kompakt.eink;
+
+import android.content.Context;
+import android.graphics.ColorFilter;
+import android.graphics.ColorMatrix;
+import android.graphics.ColorMatrixColorFilter;
+
+/** Reduces an app icon to a single ink silhouette. */
+public final class IconInk {
+
+    private static final float BOOST = 1.5f;
+    private static final float ALPHA_GAIN = 2f;
+
+    private static ColorFilter sLight;
+    private static ColorFilter sDark;
+
+    private IconInk() {}
+
+    /** The filter for the current mode: black glyphs in light, white in dark. */
+    public static ColorFilter get(Context context) {
+        final boolean night = context.getResources().getConfiguration().isNightModeActive();
+        if (night) {
+            if (sDark == null) sDark = build(255f);
+            return sDark;
+        }
+        if (sLight == null) sLight = build(0f);
+        return sLight;
+    }
+
+    private static ColorFilter build(float inkOffset) {
+        return new ColorMatrixColorFilter(new ColorMatrix(new float[] {
+                0f, 0f, 0f, 0f, inkOffset,
+                0f, 0f, 0f, 0f, inkOffset,
+                0f, 0f, 0f, 0f, inkOffset,
+                -0.2126f * BOOST, -0.7152f * BOOST, -0.0722f * BOOST,
+                ALPHA_GAIN, 255f * BOOST - ALPHA_GAIN * 255f,
+        }));
+    }
+}
