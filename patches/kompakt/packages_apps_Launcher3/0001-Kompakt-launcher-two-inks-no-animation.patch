+    /** Kompakt: the chip's own edge. */
+    private val kompaktOutlinePaint =
+        Paint(Paint.ANTI_ALIAS_FLAG).apply {
+            style = Paint.Style.STROKE
+            strokeWidth = resources.getDimension(R.dimen.kompakt_task_outline_width)
