+
     private val focusBorderAnimator: BorderAnimator? =
         focusBorderAnimator
             ?: createSimpleBorderAnimator(
@@ -712,6 +725,27 @@ constructor(
         focusBorderAnimator?.drawBorder(canvas)
         hoverBorderAnimator?.drawBorder(canvas)
         super.draw(canvas)
+        // Kompakt: AFTER super.draw(), which is what draws the children.
+        kompaktDrawOutline(canvas)
+    }
+
+    /** Strokes the thumbnail's own rounded rect. */
+    private fun kompaktDrawOutline(canvas: Canvas) {
+        // Kompakt: only once this is actually a card.
+        if (fullscreenProgress > 0f) return
+        getThumbnailBounds(kompaktOutlineBounds)
+        if (kompaktOutlineBounds.isEmpty) return
+        val half = kompaktOutlinePaint.strokeWidth / 2f
+        val radius = (TaskCornerRadius.get(context) - half).coerceAtLeast(0f)
+        canvas.drawRoundRect(
+            kompaktOutlineBounds.left + half,
+            kompaktOutlineBounds.top + half,
+            kompaktOutlineBounds.right - half,
+            kompaktOutlineBounds.bottom - half,
+            radius,
+            radius,
+            kompaktOutlinePaint,
+        )
     }
 
