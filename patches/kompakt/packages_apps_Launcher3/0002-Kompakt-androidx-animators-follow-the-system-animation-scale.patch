+ * limitations under the License.
+ */
+
+package androidx.core.animation;
+
+/**
+ * Kompakt: androidx animators keep their own duration scale, which starts at 1 and is never
+ * told about the system's animator duration scale. Animations built on them ran at full
+ * length with animations off. This copies the system scale into them and follows changes.
+ * It lives in this package because the androidx setter is package private.
+ */
+public final class KompaktAnimatorScale {
+    private KompaktAnimatorScale() {}
+
+    /** Call once, on the main thread, when the process starts. */
+    public static void followSystemScale() {
+        ValueAnimator.setDurationScale(android.animation.ValueAnimator.getDurationScale());
+        android.animation.ValueAnimator.registerDurationScaleChangeListener(
+                ValueAnimator::setDurationScale);
+    }
+}
diff --git a/quickstep/src/com/android/quickstep/QuickstepProcessInitializer.java b/quickstep/src/com/android/quickstep/QuickstepProcessInitializer.java
--- a/quickstep/src/com/android/quickstep/QuickstepProcessInitializer.java
+++ b/quickstep/src/com/android/quickstep/QuickstepProcessInitializer.java
@@ -64,6 +64,9 @@
 
         super.init(context);
 
+        // Kompakt: androidx animators (Recents task views) follow the system animation scale.
+        androidx.core.animation.KompaktAnimatorScale.followSystemScale();
+
         // Elevate GPU priority for Quickstep and Remote animations.
         ThreadedRenderer.setContextPriority(
                 ThreadedRenderer.EGL_CONTEXT_PRIORITY_HIGH_IMG);
