Subject: [PATCH 1/1] Kompakt: androidx animators follow the system animation scale

---
diff --git a/quickstep/src/androidx/core/animation/KompaktAnimatorScale.java b/quickstep/src/androidx/core/animation/KompaktAnimatorScale.java
new file mode 100644
--- /dev/null
+++ b/quickstep/src/androidx/core/animation/KompaktAnimatorScale.java
@@ -0,0 +1,34 @@
