From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Gezim <gezimos@users.noreply.github.com>
Date: Wed, 7 Oct 2026 12:00:00 +0000
Subject: [PATCH] Kompakt: no widget hub on the lockscreen

---
diff --git a/overlay/common/frameworks/base/core/res/res/values/config.xml b/overlay/common/frameworks/base/core/res/res/values/config.xml
--- a/overlay/common/frameworks/base/core/res/res/values/config.xml
+++ b/overlay/common/frameworks/base/core/res/res/values/config.xml
@@ -173,9 +173,10 @@
     <!-- Name of the font family to use in the default lockscreen clock -->
     <string name="config_clockFontFamily" translatable="false" />
 
-    <!-- Whether to enable glanceable hub features on this device. -->
-    <bool name="config_glanceableHubEnabled">true</bool>
+    <!-- Whether to enable glanceable hub features on this device.
+         Kompakt: off; its Add widgets button did nothing here, and the hub is a tablet feature. -->
+    <bool name="config_glanceableHubEnabled">false</bool>
 
     <!-- Whether glanceable hub is enabled by default. -->
-    <bool name="config_glanceableHubEnabledByDefault">true</bool>
+    <bool name="config_glanceableHubEnabledByDefault">false</bool>
 </resources>
-- 
2.43.0

