+package com.kompakt.eink;
+
+import android.graphics.Rect;
+import android.view.MotionEvent;
+import android.view.View;
+import android.view.ViewGroup;
+import android.view.ViewParent;
+import android.widget.CompoundButton;
+
+import androidx.recyclerview.widget.RecyclerView;
+
+/** A preference row with a switch toggles only from the switch. */
+public final class SwitchOnlyTouch {
+
+    private SwitchOnlyTouch() {}
+
+    public static void attach(final RecyclerView rv) {
+        if (rv == null) return;
+        rv.addOnChildAttachStateChangeListener(new RecyclerView.OnChildAttachStateChangeListener() {
+            @Override
+            public void onChildViewAttachedToWindow(@androidx.annotation.NonNull View view) {
+                apply(view);
+            }
+
+            @Override
+            public void onChildViewDetachedFromWindow(@androidx.annotation.NonNull View view) {
+            }
+        });
+    }
+
+    private static void apply(final View row) {
+        final CompoundButton control = findControl(row);
+        if (control == null || isMainSwitch(control, row)) {
+            // Rows are recycled, so a row that no longer has a switch has to be handed back its own touch handling.
+            row.setOnTouchListener(null);
+            return;
+        }
+        final View target = widgetFrame(control, row);
+        row.setOnTouchListener(new View.OnTouchListener() {
+            private boolean pass;
+
+            @Override
+            public boolean onTouch(View v, MotionEvent e) {
+                if (e.getActionMasked() == MotionEvent.ACTION_DOWN) {
+                    pass = hits(target, row, e);
+                }
+                // true swallows the gesture: the row never sees a down, so it never clicks.
+                return !pass;
+            }
+        });
+    }
+
+    private static boolean hits(View target, View row, MotionEvent e) {
+        if (target == null) return true;
+        final Rect r = new Rect();
+        target.getHitRect(r);
+        ViewParent parent = target.getParent();
+        while (parent instanceof View && parent != row) {
+            final View p = (View) parent;
+            r.offset(p.getLeft(), p.getTop());
+            parent = p.getParent();
+        }
+        // Horizontal position is the whole point; vertical aim is not.
+        r.top = 0;
+        r.bottom = row.getHeight();
+        return r.contains((int) e.getX(), (int) e.getY());
+    }
+
+    private static CompoundButton findControl(View v) {
+        if (v instanceof CompoundButton) return (CompoundButton) v;
+        if (!(v instanceof ViewGroup)) return null;
+        final ViewGroup g = (ViewGroup) v;
+        for (int i = 0; i < g.getChildCount(); i++) {
+            final CompoundButton found = findControl(g.getChildAt(i));
+            if (found != null) return found;
+        }
+        return null;
+    }
+
+    /** The widget frame the control sits in, which is the region a user aims at. */
+    private static View widgetFrame(View control, View row) {
+        View at = control;
+        while (at != null && at != row) {
+            if (at.getId() == android.R.id.widget_frame) return at;
+            final ViewParent parent = at.getParent();
+            at = (parent instanceof View) ? (View) parent : null;
+        }
+        return control;
+    }
+
+    /** True for the full-width switch banner, where the row is the control. */
+    private static boolean isMainSwitch(View control, View row) {
+        View at = control;
+        while (at != null) {
+            final int id = at.getId();
+            if (id != View.NO_ID) {
+                try {
+                    if (at.getResources().getResourceEntryName(id).contains("main_switch")) {
+                        return true;
+                    }
+                } catch (android.content.res.Resources.NotFoundException ignored) {
+                    // an id with no name is not one of ours to recognise
+                }
+            }
+            if (at == row) break;
+            final ViewParent parent = at.getParent();
+            at = (parent instanceof View) ? (View) parent : null;
+        }
+        return false;
+    }
+}
