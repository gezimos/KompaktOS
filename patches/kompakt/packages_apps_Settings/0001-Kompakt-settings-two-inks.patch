+/** Slot 2 on the Kompakt is one physical line, muxed between tray and eUICC. */
+private const val KOMPAKT_MUXED_SLOT = 1
+
+/** The mux itself. */
+private const val KOMPAKT_MUX_NODE =
+    "/sys/devices/virtual/nvrom_class/nvrom_write/nvrom_write"
+
+private fun kompaktSlotIsEsim(): Boolean =
+    try {
+        java.io.File(KOMPAKT_MUX_NODE).readText().trim().startsWith("****esim***")
+    } catch (t: Throwable) {
+        false
+    }
+
+/** Switches slot 2 between the SIM tray and the eUICC. */
+@Composable
+private fun KompaktSimSlotSwitch(subscriptionInfoList: List<SubscriptionInfo>) {
+    val context = LocalContext.current
+    val traySimOn = subscriptionInfoList.any {
+        it.simSlotIndex == KOMPAKT_MUXED_SLOT &&
+            !it.isEmbedded &&
+            it.areUiccApplicationsEnabled()
+    }
+    SwitchPreference(
+        object : SwitchPreferenceModel {
+            override val title = "SIM 2 slot as eSIM"
+            override val summary = {
+                (when {
+                    traySimOn -> "Turn SIM 2 off first"
+                    kompaktSlotIsEsim() -> "Slot 2 is using the eSIM"
+                    else -> "Slot 2 is using the SIM tray"
+                }) as CharSequence
+            }
+            override val checked = { kompaktSlotIsEsim() }
+            override val changeable = { !traySimOn }
+            override val onCheckedChange: (Boolean) -> Unit = {
+                context.startActivity(
+                    Intent("com.kompakt.service.action.SIM_MODE")
+                        .setPackage("com.kompakt.service")
+                        .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
+                )
+            }
+        }
+    )
+}
+
+/** Kompakt: "SIM 1" or "SIM 2" for a subscription, or null when it is not in a slot. */
+private fun kompaktSlotLabel(subInfo: SubscriptionInfo): String? =
+    when (subInfo.simSlotIndex) {
+        0 -> "SIM 1"
+        KOMPAKT_MUXED_SLOT -> "SIM 2"
+        else -> null
+    }
+
 @Composable
