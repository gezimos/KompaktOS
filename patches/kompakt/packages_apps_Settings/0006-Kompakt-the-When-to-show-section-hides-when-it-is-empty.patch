From: Gezim <gezimos@users.noreply.github.com>
Date: Sat, 17 Oct 2026 23:00:00 +0200
Subject: [PATCH] Kompakt: the When to show section hides when it is empty

The Lock screen page showed the "When to show" heading with nothing under
it: the section is available whenever an ambient display exists, but every
row in it checks for a sensor or a doze feature this phone does not have.
The section now hides itself when none of its rows is visible.

---
diff --git a/src/com/android/settings/display/AmbientDisplayWhenToShowPreferenceController.java b/src/com/android/settings/display/AmbientDisplayWhenToShowPreferenceController.java
--- a/src/com/android/settings/display/AmbientDisplayWhenToShowPreferenceController.java
+++ b/src/com/android/settings/display/AmbientDisplayWhenToShowPreferenceController.java
@@ -18,6 +18,9 @@
 import android.content.Context;
 import android.hardware.display.AmbientDisplayConfiguration;
 
+import androidx.preference.Preference;
+import androidx.preference.PreferenceGroup;
+
 import com.android.settings.core.BasePreferenceController;
 import com.android.settings.core.PreferenceControllerMixin;
 import com.android.settings.display.AmbientDisplaySettingsController;
@@ -34,7 +37,24 @@
         mConfig = new AmbientDisplayConfiguration(context);
     }
 
+    /** Kompakt: no heading over an empty section; hides when none of its rows are available. */
     @Override
+    public void updateState(Preference preference) {
+        super.updateState(preference);
+        if (preference instanceof PreferenceGroup) {
+            final PreferenceGroup group = (PreferenceGroup) preference;
+            boolean any = false;
+            for (int i = 0; i < group.getPreferenceCount(); i++) {
+                if (group.getPreference(i).isVisible()) {
+                    any = true;
+                    break;
+                }
+            }
+            preference.setVisible(any);
+        }
+    }
+
+    @Override
     public int getAvailabilityStatus() {
         if (AmbientDisplaySettingsController.isExternallyManaged(mContext)) {
             if (!mConfig.doubleTapSensorAvailable() && !mConfig.tapSensorAvailable()) {
