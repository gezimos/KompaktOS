From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: gezimos <>
Date: Wed, 07 Oct 2026 23:51:42 +0300
Subject: [PATCH] Kompakt: emoji pages do not jump, tabs in full ink

---
diff --git a/java/src/com/android/inputmethod/keyboard/emoji/EmojiPalettesView.java b/java/src/com/android/inputmethod/keyboard/emoji/EmojiPalettesView.java
index fae442c18..a966a354f 100644
--- a/java/src/com/android/inputmethod/keyboard/emoji/EmojiPalettesView.java
+++ b/java/src/com/android/inputmethod/keyboard/emoji/EmojiPalettesView.java
@@ -20,9 +20,16 @@ package com.android.inputmethod.keyboard.emoji;
 import static com.android.inputmethod.latin.common.Constants.NOT_A_COORDINATE;
 
 import android.content.Context;
+import android.content.res.ColorStateList;
 import android.content.res.Resources;
 import android.content.res.TypedArray;
 import android.graphics.Color;
+import android.graphics.PorterDuff;
+import android.graphics.drawable.ColorDrawable;
+import android.graphics.drawable.Drawable;
+import android.graphics.drawable.GradientDrawable;
+import android.graphics.drawable.InsetDrawable;
+import android.graphics.drawable.StateListDrawable;
 import android.os.Handler;
 import android.os.Looper;
 import android.preference.PreferenceManager;
@@ -146,6 +153,29 @@ public final class EmojiPalettesView extends LinearLayout implements OnTabChange
         setMeasuredDimension(width, height);
     }
 
+    /** Kompakt: every tab in full ink; the selected one is an outlined inverted pill. */
+    private void kompaktTabIcon(final ImageView iconView, final int iconId) {
+        final Drawable icon = getContext().getDrawable(iconId).mutate();
+        icon.setState(new int[] { android.R.attr.state_selected });
+        final Drawable full = icon.getCurrent().mutate();
+        final int paper = mCategoryPageIndicatorBackground;
+        final int ink = Color.luminance(paper) > 0.5f ? Color.BLACK : Color.WHITE;
+        final int[][] states = { { android.R.attr.state_selected }, {} };
+        iconView.setImageDrawable(full);
+        iconView.setImageTintList(new ColorStateList(states, new int[] { paper, ink }));
+        iconView.setImageTintMode(PorterDuff.Mode.SRC_IN);
+        final float dp = getResources().getDisplayMetrics().density;
+        final GradientDrawable pill = new GradientDrawable();
+        pill.setCornerRadius(100 * dp);
+        pill.setColor(ink);
+        pill.setStroke(Math.round(2 * dp), ink);
+        final StateListDrawable bg = new StateListDrawable();
+        bg.addState(states[0], new InsetDrawable(pill, Math.round(4 * dp), Math.round(3 * dp),
+                Math.round(4 * dp), Math.round(3 * dp)));
+        bg.addState(states[1], new ColorDrawable(paper));
+        iconView.setBackground(bg);
+    }
+
     private void addTab(final TabHost host, final int categoryId) {
         final String tabId = EmojiCategory.getCategoryName(categoryId, 0 /* categoryPageId */);
         final TabHost.TabSpec tspec = host.newTabSpec(tabId);
@@ -155,7 +185,7 @@ public final class EmojiPalettesView extends LinearLayout implements OnTabChange
         // TODO: Replace background color with its own setting rather than using the
         //       category page indicator background as a workaround.
         iconView.setBackgroundColor(mCategoryPageIndicatorBackground);
-        iconView.setImageResource(mEmojiCategory.getCategoryTabIcon(categoryId));
+        kompaktTabIcon(iconView, mEmojiCategory.getCategoryTabIcon(categoryId));
         iconView.setContentDescription(mEmojiCategory.getAccessibilityDescription(categoryId));
         tspec.setIndicator(iconView);
         host.addTab(tspec);
@@ -224,7 +254,8 @@ public final class EmojiPalettesView extends LinearLayout implements OnTabChange
                 }
             }
         });
-        mEmojiPager.setOffscreenPageLimit(ViewPager2.OFFSCREEN_PAGE_LIMIT_DEFAULT);
+        // Kompakt: neighbours laid out, so a swipe finds its page; with scrolls instant a search overshoots.
+        mEmojiPager.setOffscreenPageLimit(1);
 
         mEmojiPager.setPersistentDrawingCache(PERSISTENT_NO_CACHE);
         mEmojiLayoutParams.setPagerProperties(mEmojiPager);
