diff --git a/app/src/main/java/com/kompakt/camera/Storage.java b/app/src/main/java/com/kompakt/camera/Storage.java
new file mode 100644
index 0000000..a79a99d
--- /dev/null
+++ b/app/src/main/java/com/kompakt/camera/Storage.java
@@ -0,0 +1,78 @@
+/*
+ * SPDX-FileCopyrightText: KompaktOS
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.kompakt.camera;
+
+import android.content.Context;
+import android.content.res.Resources;
+import android.os.Environment;
+import android.os.storage.StorageManager;
+import android.os.storage.StorageVolume;
+import android.provider.MediaStore;
+
+import androidx.preference.PreferenceManager;
+
+/**
+ * Kompakt: where a new photo or video goes. With Save to SD card on and a card mounted, the
+ * card's DCIM/Camera; otherwise the phone's, as before, so a capture is never lost to a missing
+ * card. Media on either volume is found by the same "external" queries, so nothing reading
+ * captures changes.
+ */
+public final class Storage {
+    public static final String SAVE_TO_SD_KEY = "kompakt_save_to_sd";
+
+    private Storage() {}
+
+    /** The MediaStore volume for the next capture. */
+    public static String volume(Context context) {
+        if (PreferenceManager.getDefaultSharedPreferences(context).getBoolean(SAVE_TO_SD_KEY, false)) {
+            String card = cardVolume(context);
+            if (card != null) return card;
+        }
+        // "external" saves to the phone, exactly as Aperture always did.
+        return MediaStore.VOLUME_EXTERNAL;
+    }
+
+    /** Whether a portable SD card is in, so the setting is worth showing. */
+    public static boolean hasCard(Context context) {
+        return cardVolume(context) != null;
+    }
+
+    /**
+     * A mounted portable SD card's MediaStore volume name, or null. A card set up as internal
+     * storage is part of the phone's storage, not a volume of its own, and a USB drive is skipped.
+     */
+    private static String cardVolume(Context context) {
+        StorageManager storage = context.getSystemService(StorageManager.class);
+        if (storage == null) return null;
+        for (StorageVolume v : storage.getStorageVolumes()) {
+            if (v.isPrimary() || !v.isRemovable()) continue;
+            if (!Environment.MEDIA_MOUNTED.equals(v.getState())) continue;
+            if (isUsbDrive(v.getDescription(context))) continue;
+            String name = v.getMediaStoreVolumeName();
+            if (name != null) return name;
+        }
+        return null;
+    }
+
+    /** Android names a USB drive "USB drive" or "<label> USB drive", in the phone's language. */
+    private static boolean isUsbDrive(String description) {
+        if (description == null) return false;
+        Resources system = Resources.getSystem();
+        int plain = system.getIdentifier("storage_usb_drive", "string", "android");
+        int labelled = system.getIdentifier("storage_usb_drive_label", "string", "android");
+        if (plain != 0 && description.equals(system.getString(plain))) return true;
+        if (labelled != 0) {
+            String format = system.getString(labelled);
+            int at = format.indexOf("%s");
+            if (at >= 0) {
+                String before = format.substring(0, at);
+                String after = format.substring(at + 2);
+                return description.startsWith(before) && description.endsWith(after);
+            }
+        }
+        return false;
+    }
+}
