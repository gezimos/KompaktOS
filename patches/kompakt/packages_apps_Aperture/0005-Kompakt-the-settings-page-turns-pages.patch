diff --git a/app/src/main/java/com/kompakt/eink/PageGestureListener.java b/app/src/main/java/com/kompakt/eink/PageGestureListener.java
new file mode 100755
index 0000000..5ed20d4
--- /dev/null
+++ b/app/src/main/java/com/kompakt/eink/PageGestureListener.java
@@ -0,0 +1,100 @@
+package com.kompakt.eink;
+
+import android.content.Context;
+import android.view.GestureDetector;
+import android.view.MotionEvent;
+
+/** Turns touch into page moves, matching inkOS (ui/compose/GestureHelper.kt). */
+final class PageGestureListener extends GestureDetector.SimpleOnGestureListener {
+
+    /** What to do with a page move; delta is +1 (down/forward) or -1 (up/back). */
+    interface Pager {
+        boolean page(int delta);
+    }
+
+    /** Drag distance before a page turns. */
+    private static final float THRESHOLD_DP = 56f;
+    private static final long COOLDOWN_MS = 200L;
+
+    /** Minimum vertical fling speed, dp/s. */
+    private static final float MIN_FLING_DP_PER_S = 600f;
+
+    /** How many pages the hardest flick may cover. */
+    private static final int MAX_FLING_PAGES = 5;
+
+    private final Pager pager;
+    /** Kompakt: page along x instead of y, for a sideways row. */
+    private final boolean horizontal;
+    private final float thresholdPx;
+    private final float minFlingPxPerS;
+
+    private float lastPageMoveY;
+    private long lastPageMoveTime;
+    /** inkOS's scrollPageMoveTriggered: did this gesture already page while dragging? */
+    private boolean pagedDuringDrag;
+
+    PageGestureListener(Context context, Pager pager) {
+        this(context, pager, false);
+    }
+
+    PageGestureListener(Context context, Pager pager, boolean horizontal) {
+        this.pager = pager;
+        this.horizontal = horizontal;
+        final float density = context.getResources().getDisplayMetrics().density;
+        this.thresholdPx = Math.max(8f, THRESHOLD_DP * density);
+        this.minFlingPxPerS = MIN_FLING_DP_PER_S * density;
+    }
+
+    @Override
+    public boolean onDown(MotionEvent e) {
+        // Measure the next drag from here, not from the previous gesture.
+        lastPageMoveY = along(e);
+        pagedDuringDrag = false;
+        return true;
+    }
+
+    @Override
+    public boolean onScroll(MotionEvent down, MotionEvent now, float dx, float dy) {
+        if (down == null) return false;
+
+        // Dominant along the paging axis only.
+        if (Math.abs(across(now) - across(down)) > Math.abs(along(now) - along(down))) return false;
+
+        final float travelled = along(now) - lastPageMoveY;
+        if (Math.abs(travelled) <= thresholdPx) return false;
+
+        final long t = android.os.SystemClock.uptimeMillis();
+        if (t - lastPageMoveTime < COOLDOWN_MS) return false;
+
+        // Dragging content up (negative) means "go down a page".
+        if (!pager.page(travelled < 0 ? 1 : -1)) return false;
+        lastPageMoveTime = t;
+        lastPageMoveY = along(now);
+        pagedDuringDrag = true;
+        return true;
+    }
+
+    @Override
+    public boolean onFling(MotionEvent down, MotionEvent up, float vx, float vy) {
+        // A drag that already paged must not page again on lift.
+        if (pagedDuringDrag) return false;
+        final float v = horizontal ? vx : vy;
+        // Dominant along the paging axis, and fast enough to be a deliberate flick.
+        if (Math.abs(v) < Math.abs(horizontal ? vy : vx)) return false;
+        if (Math.abs(v) < minFlingPxPerS) return false;
+        // ...and far enough.
+        if (down != null && up != null
+                && Math.abs(along(up) - along(down)) < thresholdPx) return false;
+        final int pages = Math.max(1,
+                Math.min(MAX_FLING_PAGES, (int) (Math.abs(v) / minFlingPxPerS)));
+        return pager.page(v < 0 ? pages : -pages);
+    }
+
+    private float along(MotionEvent e) {
+        return horizontal ? e.getX() : e.getY();
+    }
+
+    private float across(MotionEvent e) {
+        return horizontal ? e.getY() : e.getX();
+    }
+}
diff --git a/app/src/main/java/com/kompakt/eink/PagedScroll.java b/app/src/main/java/com/kompakt/eink/PagedScroll.java
new file mode 100644
index 0000000..751aa37
--- /dev/null
+++ b/app/src/main/java/com/kompakt/eink/PagedScroll.java
@@ -0,0 +1,144 @@
+package com.kompakt.eink;
+
+import android.view.GestureDetector;
+import android.view.MotionEvent;
+import android.view.View;
+
+import androidx.annotation.NonNull;
+import androidx.recyclerview.widget.LinearLayoutManager;
+import androidx.recyclerview.widget.RecyclerView;
+
+/** Paged scrolling for the camera's settings: Twelve's PagedScroll, vertical lists only. */
+public final class PagedScroll {
+
+    private PagedScroll() {}
+
+    /** Pages a vertical list; anything else, or one already paged, is left alone. */
+    public static void attach(final RecyclerView rv) {
+        if (rv == null) return;
+        final RecyclerView.LayoutManager current = rv.getLayoutManager();
+        if (current instanceof PagedLayoutManager) return;
+        if (current instanceof LinearLayoutManager
+                && ((LinearLayoutManager) current).getOrientation() != RecyclerView.VERTICAL) {
+            return;
+        }
+        // Kompakt: rows scrolled past the top must not draw above the list.
+        rv.setOutlineProvider(android.view.ViewOutlineProvider.BOUNDS);
+        rv.setClipToOutline(true);
+
+        final PagedLayoutManager lm = new PagedLayoutManager(rv.getContext());
+        rv.setLayoutManager(lm);
+
+        // fling = one page; dragging keeps paging as the finger travels (inkOS behaviour)
+        final GestureDetector detector = new GestureDetector(rv.getContext(),
+                new PageGestureListener(rv.getContext(), new PageGestureListener.Pager() {
+                    @Override
+                    public boolean page(int delta) {
+                        return PagedScroll.page(rv, lm, delta);
+                    }
+                }));
+
+        rv.addOnItemTouchListener(new RecyclerView.OnItemTouchListener() {
+            @Override
+            public boolean onInterceptTouchEvent(@NonNull RecyclerView r, @NonNull MotionEvent e) {
+                detector.onTouchEvent(e);
+                return false; // let taps through to the rows themselves
+            }
+
+            @Override
+            public void onTouchEvent(@NonNull RecyclerView r, @NonNull MotionEvent e) {
+            }
+
+            @Override
+            public void onRequestDisallowInterceptTouchEvent(boolean disallow) {
+            }
+        });
+    }
+
+    /** Move by whole pages, in pixels, measured off the rows that are on screen. */
+    private static boolean page(RecyclerView rv, PagedLayoutManager lm, int delta) {
+        if (delta == 0) return false;
+        final int viewport = rv.getHeight() - rv.getPaddingTop() - rv.getPaddingBottom();
+        if (viewport <= 0) return false;
+
+        // scrollBy() is a no-op while the LayoutManager refuses vertical scrolling, so open the gate.
+        lm.allowProgrammaticScroll = true;
+        try {
+            final long before = mark(lm);
+            for (int i = Math.abs(delta); i > 0; i--) {
+                if (delta > 0) {
+                    forward(rv, lm, viewport);
+                } else {
+                    rv.scrollBy(0, -viewport);
+                    snapTopRowWhole(rv, lm);
+                }
+            }
+            // Ask the screen whether anything moved; at either end nothing does.
+            return mark(lm) != before;
+        } finally {
+            lm.allowProgrammaticScroll = false;
+        }
+    }
+
+    /** Forward one page: to the top of the first row the bottom edge cuts. */
+    private static void forward(RecyclerView rv, PagedLayoutManager lm, int viewport) {
+        final int topEdge = rv.getPaddingTop();
+        final int bottomEdge = rv.getHeight() - rv.getPaddingBottom();
+        int next = Integer.MAX_VALUE;
+        for (int i = 0, n = lm.getChildCount(); i < n; i++) {
+            final View row = lm.getChildAt(i);
+            if (row == null) continue;
+            if (lm.getDecoratedBottom(row) > bottomEdge && lm.getDecoratedTop(row) < next) {
+                next = lm.getDecoratedTop(row);
+            }
+        }
+        int dy = (next == Integer.MAX_VALUE) ? viewport : next - topEdge;
+        // A row taller than the whole page would stand still forever.
+        if (dy <= 0) dy = viewport;
+        rv.scrollBy(0, dy);
+    }
+
+    /** Pull the row under the top edge down until it is whole. */
+    private static void snapTopRowWhole(RecyclerView rv, PagedLayoutManager lm) {
+        final int topEdge = rv.getPaddingTop();
+        for (int i = 0, n = lm.getChildCount(); i < n; i++) {
+            final View row = lm.getChildAt(i);
+            if (row == null) continue;
+            if (lm.getDecoratedTop(row) <= topEdge && lm.getDecoratedBottom(row) > topEdge) {
+                final int dy = lm.getDecoratedTop(row) - topEdge;
+                if (dy < 0) rv.scrollBy(0, dy);
+                return;
+            }
+        }
+    }
+
+    /** Where the list is, exactly: which row is at the top and how far into it we are. */
+    private static long mark(PagedLayoutManager lm) {
+        final int first = lm.findFirstVisibleItemPosition();
+        if (first == RecyclerView.NO_POSITION) return Long.MIN_VALUE;
+        final View row = lm.findViewByPosition(first);
+        final int top = (row == null) ? 0 : lm.getDecoratedTop(row);
+        return ((long) first << 32) | (top & 0xffffffffL);
+    }
+
+    /** Reports "cannot scroll vertically" to touch handling, which is what stops the finger dragging the list at all. */
+    static final class PagedLayoutManager extends LinearLayoutManager {
+        boolean allowProgrammaticScroll = false;
+
+        PagedLayoutManager(android.content.Context context) {
+            super(context);
+        }
+
+        @Override
+        public boolean canScrollVertically() {
+            return allowProgrammaticScroll;
+        }
+
+        /** A requested position lands at the top of the page; the gate above would stop a smooth scroll. */
+        @Override
+        public void smoothScrollToPosition(RecyclerView recyclerView, RecyclerView.State state,
+                int position) {
+            scrollToPositionWithOffset(position, 0);
+        }
+    }
+}
