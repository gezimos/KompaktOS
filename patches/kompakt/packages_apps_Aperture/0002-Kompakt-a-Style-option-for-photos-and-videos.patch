diff --git a/app/src/main/java/com/kompakt/camera/GrainFilter.java b/app/src/main/java/com/kompakt/camera/GrainFilter.java
new file mode 100644
index 0000000..0233bce
--- /dev/null
+++ b/app/src/main/java/com/kompakt/camera/GrainFilter.java
@@ -0,0 +1,149 @@
+/*
+ * SPDX-FileCopyrightText: KompaktOS
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.kompakt.camera;
+
+import android.graphics.Bitmap;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import java.util.concurrent.Future;
+
+/** Film grain for a photo, mono (B&W) or colour (Film), applied in place in bands of rows. */
+final class GrainFilter {
+    private static final int BAND_ROWS = 64;
+    private static final float SPARSITY = 0.76f; // fraction of the lattice left blank between grains
+
+    private final boolean mono;
+    private final int seed;
+    private final int speckCell;
+    private final int coarseCell;
+    private final float strength;
+    private final int[] curve = new int[256];
+    private final float[] weight = new float[256];
+
+    /** {@code width} is the photo's width as shown, which sets the grain size. */
+    GrainFilter(long seed, boolean mono, int width) {
+        this.mono = mono;
+        this.seed = (int) (seed ^ (seed >>> 32));
+        // individual silver grains are small and hard edged; only their clumping comes from a smooth field
+        this.speckCell = Math.max(2, Math.round(width / 1200.0f));
+        this.coarseCell = speckCell * 14;
+        this.strength = mono ? 0.40f : 0.32f;
+        float sCurve = mono ? 0.70f : 0.30f;
+        for (int i = 0; i < 256; i++) {
+            float x = i / 255.0f;
+            float s = x * x * (3.0f - 2.0f * x);
+            float v = (1.0f - sCurve) * x + sCurve * s;
+            if (mono) v = v * 0.985f + 0.006f;
+            curve[i] = Math.max(0, Math.min(255, Math.round(v * 255.0f)));
+            // silver density peaks in the midtones, so grain fades out towards black and white
+            float t = 4.0f * x * (1.0f - x);
+            weight[i] = t <= 0.0f ? 0.0f : (float) Math.pow(t, 0.7);
+        }
+    }
+
+    /** Applies the grain to a mutable ARGB bitmap, using every core. */
+    void apply(final Bitmap bitmap) throws Exception {
+        final int w = bitmap.getWidth();
+        final int h = bitmap.getHeight();
+        int threads = Math.max(1, Runtime.getRuntime().availableProcessors());
+        ExecutorService pool = Executors.newFixedThreadPool(threads);
+        try {
+            List<Future<?>> bands = new ArrayList<>();
+            for (int top = 0; top < h; top += BAND_ROWS) {
+                final int y0 = top;
+                final int rows = Math.min(BAND_ROWS, h - top);
+                bands.add(pool.submit(() -> {
+                    int[] px = new int[w * rows];
+                    synchronized (bitmap) {
+                        bitmap.getPixels(px, 0, w, 0, y0, w, rows);
+                    }
+                    band(px, w, y0, rows);
+                    synchronized (bitmap) {
+                        bitmap.setPixels(px, 0, w, 0, y0, w, rows);
+                    }
+                }));
+            }
+            for (Future<?> band : bands) band.get();
+        } finally {
+            pool.shutdown();
+        }
+    }
+
+    private void band(int[] px, int w, int y0, int rows) {
+        for (int y = y0, c = 0; y < y0 + rows; y++) {
+            for (int x = 0; x < w; x++, c++) {
+                int color = px[c];
+                int r = (color >> 16) & 0xFF;
+                int g = (color >> 8) & 0xFF;
+                int b = color & 0xFF;
+                float gm = grain(x, y);
+                if (mono) {
+                    int luma = curve[(r * 77 + g * 150 + b * 29) >> 8];
+                    float amount = gm * weight[luma] * strength;
+                    int v = softLight(luma, 0.5f + amount * 0.5f);
+                    px[c] = 0xff000000 | (v << 16) | (v << 8) | v;
+                } else {
+                    // near achromatic grain: independent per-channel noise reads as digital chroma noise
+                    float jitter = unit(hash(x, y, seed ^ 0x1b873593)) - 0.5f;
+                    float wt = weight[(r * 77 + g * 150 + b * 29) >> 8] * strength;
+                    int nr = softLight(curve[r], 0.5f + (gm + jitter * 0.10f) * wt * 0.5f);
+                    int ng = softLight(curve[g], 0.5f + (gm - jitter * 0.06f) * wt * 0.5f);
+                    int nb = softLight(curve[b], 0.5f + (gm + jitter * 0.09f) * wt * 0.5f);
+                    px[c] = 0xff000000 | (nr << 16) | (ng << 8) | nb;
+                }
+            }
+        }
+    }
+
+    private static int hash(int x, int y, int seed) {
+        int h = x * 0x27d4eb2d ^ y * 0x9e3779b9 ^ seed;
+        h ^= h >>> 15;
+        h *= 0x85ebca6b;
+        h ^= h >>> 13;
+        return h;
+    }
+
+    private static float unit(int h) {
+        return (h & 0xFFFF) / 65535.0f;
+    }
+
+    private static float lattice(int x, int y, int cell, int seed) {
+        int gx = Math.floorDiv(x, cell);
+        int gy = Math.floorDiv(y, cell);
+        float fx = (x - gx * cell) / (float) cell;
+        float fy = (y - gy * cell) / (float) cell;
+        fx = fx * fx * (3.0f - 2.0f * fx);
+        fy = fy * fy * (3.0f - 2.0f * fy);
+        float a = unit(hash(gx, gy, seed));
+        float b = unit(hash(gx + 1, gy, seed));
+        float c = unit(hash(gx, gy + 1, seed));
+        float d = unit(hash(gx + 1, gy + 1, seed));
+        float top = a + (b - a) * fx;
+        float bottom = c + (d - c) * fx;
+        return top + (bottom - top) * fy;
+    }
+
+    private float grain(int x, int y) {
+        float g = unit(hash(Math.floorDiv(x, speckCell), Math.floorDiv(y, speckCell), seed)) * 2.0f - 1.0f;
+        // a slow field decides where grains cluster, so density varies across the frame
+        float density = lattice(x, y, coarseCell, seed ^ 0x5bd1e995);
+        float threshold = SPARSITY - 0.40f * (density - 0.5f);
+        float a = Math.abs(g);
+        if (a <= threshold) return 0.0f;
+        float mag = Math.min(1.0f, (a - threshold) / Math.max(1.0e-3f, 1.0f - threshold));
+        return g < 0.0f ? -mag : mag;
+    }
+
+    private static int softLight(int base, float blend) {
+        float a = base / 255.0f;
+        float v = (1.0f - 2.0f * blend) * a * a + 2.0f * blend * a;
+        int out = Math.round(v * 255.0f);
+        return out < 0 ? 0 : Math.min(out, 255);
+    }
+}
diff --git a/app/src/main/java/com/kompakt/camera/Styles.java b/app/src/main/java/com/kompakt/camera/Styles.java
new file mode 100644
index 0000000..51512b3
--- /dev/null
+++ b/app/src/main/java/com/kompakt/camera/Styles.java
@@ -0,0 +1,244 @@
+/*
+ * SPDX-FileCopyrightText: KompaktOS
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.kompakt.camera;
+
+import android.content.Context;
+import android.graphics.Bitmap;
+import android.graphics.BitmapFactory;
+import android.media.MediaExtractor;
+import android.media.MediaMuxer;
+import android.net.Uri;
+import android.os.Handler;
+import android.os.Looper;
+import android.os.ParcelFileDescriptor;
+import android.util.Log;
+import android.widget.Toast;
+
+import androidx.exifinterface.media.ExifInterface;
+import androidx.preference.PreferenceManager;
+
+import org.lineageos.aperture.R;
+
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.FileOutputStream;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+
+/**
+ * Kompakt: the Style option. Photos: Normal, B&W, Film; videos: Normal, B&W, VHS. A style is
+ * applied to the saved file in the background and written back over it, so the gallery entry,
+ * its date and its place stay the same; if anything fails the original is kept.
+ */
+public final class Styles {
+    private static final String TAG = "KompaktStyles";
+
+    public static final int NORMAL = 0;
+    public static final int BW = 1;
+    public static final int FILM = 2;
+    public static final int VHS = 3;
+
+    private static final String PHOTO_KEY = "kompakt_photo_style";
+    private static final String VIDEO_KEY = "kompakt_video_style";
+    private static final int JPEG_QUALITY = 95;
+
+    // One file at a time, outside any screen's lifetime, so leaving the camera does not cancel it.
+    private static final ExecutorService WORKER = Executors.newSingleThreadExecutor(r -> {
+        Thread thread = new Thread(r, "KompaktStyle");
+        thread.setPriority(Thread.MIN_PRIORITY);
+        return thread;
+    });
+
+    private Styles() {}
+
+    public static int get(Context context, boolean video) {
+        int style = PreferenceManager.getDefaultSharedPreferences(context)
+                .getInt(video ? VIDEO_KEY : PHOTO_KEY, NORMAL);
+        return video ? (style == BW || style == VHS ? style : NORMAL)
+                : (style == BW || style == FILM ? style : NORMAL);
+    }
+
+    /** Normal, B&W, then Film for photos or VHS for videos. */
+    public static int cycle(Context context, boolean video) {
+        int current = get(context, video);
+        int next = current == NORMAL ? BW : current == BW ? (video ? VHS : FILM) : NORMAL;
+        PreferenceManager.getDefaultSharedPreferences(context).edit()
+                .putInt(video ? VIDEO_KEY : PHOTO_KEY, next).apply();
+        return next;
+    }
+
+    public static int label(int style) {
+        switch (style) {
+            case BW: return R.string.kompakt_style_bw;
+            case FILM: return R.string.kompakt_style_film;
+            case VHS: return R.string.kompakt_style_vhs;
+            default: return R.string.kompakt_style_normal;
+        }
+    }
+
+    public static int icon(int style, boolean video) {
+        switch (style) {
+            case BW: return video ? R.drawable.ic_style_bw_video : R.drawable.ic_style_bw_photo;
+            case FILM: return R.drawable.ic_style_film;
+            case VHS: return R.drawable.ic_style_vhs;
+            default: return R.drawable.ic_style_normal;
+        }
+    }
+
+    /** Grains a saved JPEG in place, then runs {@code done} on the main thread either way. */
+    public static void applyToPhoto(Context context, Uri uri, int style, Runnable done) {
+        final Context app = context.getApplicationContext();
+        final Handler main = new Handler(Looper.getMainLooper());
+        WORKER.execute(() -> {
+            try {
+                filterPhoto(app, uri, style == BW);
+            } catch (Throwable t) {
+                Log.e(TAG, "photo style failed, original kept", t);
+            }
+            main.post(done);
+        });
+    }
+
+    private static void filterPhoto(Context app, Uri uri, boolean mono) throws Exception {
+        byte[] original;
+        try (InputStream in = app.getContentResolver().openInputStream(uri)) {
+            original = readAll(in);
+        }
+        ExifInterface exif = new ExifInterface(new ByteArrayInputStream(original));
+        BitmapFactory.Options options = new BitmapFactory.Options();
+        options.inMutable = true;
+        options.inPreferredConfig = Bitmap.Config.ARGB_8888;
+        Bitmap bitmap = BitmapFactory.decodeByteArray(original, 0, original.length, options);
+        if (bitmap == null) throw new IllegalStateException("cannot decode " + uri);
+        byte[] graded;
+        try {
+            // grain is the same in every direction, so it goes on before the EXIF rotation
+            int degrees = exif.getRotationDegrees();
+            int shownWidth = degrees % 180 == 0 ? bitmap.getWidth() : bitmap.getHeight();
+            new GrainFilter(System.currentTimeMillis(), mono, shownWidth).apply(bitmap);
+            ByteArrayOutputStream out = new ByteArrayOutputStream(original.length);
+            bitmap.compress(Bitmap.CompressFormat.JPEG, JPEG_QUALITY, out);
+            graded = out.toByteArray();
+        } finally {
+            bitmap.recycle();
+        }
+        // EXIF goes onto a copy in the cache, then the finished file replaces the original
+        File temp = File.createTempFile("style", ".jpg", app.getCacheDir());
+        try {
+            try (OutputStream out = new FileOutputStream(temp)) {
+                out.write(graded);
+            }
+            ExifInterface target = new ExifInterface(temp.getAbsolutePath());
+            for (String tag : EXIF_TAGS) {
+                String value = exif.getAttribute(tag);
+                if (value != null) target.setAttribute(tag, value);
+            }
+            target.saveAttributes();
+            try (InputStream in = new FileInputStream(temp);
+                 OutputStream out = app.getContentResolver().openOutputStream(uri, "wt")) {
+                copy(in, out);
+            }
+        } finally {
+            temp.delete();
+        }
+    }
+
+    /** Re-encodes a saved video in place; a message says when it starts and how it ended. */
+    public static void applyToVideo(Context context, Uri uri, int style, Runnable done) {
+        final Context app = context.getApplicationContext();
+        final Handler main = new Handler(Looper.getMainLooper());
+        final String name = app.getString(label(style));
+        // recording events arrive on the camera executor, so the message goes through the main thread
+        main.post(() -> Toast.makeText(app, app.getString(R.string.kompakt_style_applying, name),
+                Toast.LENGTH_SHORT).show());
+        WORKER.execute(() -> {
+            boolean ok = false;
+            try {
+                ok = filterVideo(app, uri, style == VHS ? VideoStyleProcessor.MODE_VHS
+                        : VideoStyleProcessor.MODE_BW);
+            } catch (Throwable t) {
+                Log.e(TAG, "video style failed, original kept", t);
+            }
+            final boolean success = ok;
+            main.post(() -> {
+                Toast.makeText(app, app.getString(success ? R.string.kompakt_style_done
+                        : R.string.kompakt_style_failed, name), Toast.LENGTH_SHORT).show();
+                done.run();
+            });
+        });
+    }
+
+    private static boolean filterVideo(Context app, Uri uri, int mode) throws Exception {
+        File temp = File.createTempFile("style", ".mp4", app.getCacheDir());
+        try {
+            boolean ok;
+            MediaExtractor extractor = new MediaExtractor();
+            MediaMuxer muxer = null;
+            try (ParcelFileDescriptor in = app.getContentResolver().openFileDescriptor(uri, "r")) {
+                extractor.setDataSource(in.getFileDescriptor());
+                muxer = new MediaMuxer(temp.getAbsolutePath(), MediaMuxer.OutputFormat.MUXER_OUTPUT_MPEG_4);
+                ok = VideoStyleProcessor.process(app, extractor, muxer, mode, System.currentTimeMillis());
+            } finally {
+                extractor.release();
+                if (muxer != null) {
+                    try {
+                        muxer.release();
+                    } catch (Exception e) {
+                        Log.e(TAG, "muxer release", e);
+                    }
+                }
+            }
+            if (!ok || temp.length() == 0) return false;
+            try (InputStream in = new FileInputStream(temp);
+                 OutputStream out = app.getContentResolver().openOutputStream(uri, "wt")) {
+                copy(in, out);
+            }
+            return true;
+        } finally {
+            temp.delete();
+        }
+    }
+
+    private static byte[] readAll(InputStream in) throws Exception {
+        ByteArrayOutputStream out = new ByteArrayOutputStream();
+        copy(in, out);
+        return out.toByteArray();
+    }
+
+    private static void copy(InputStream in, OutputStream out) throws Exception {
+        byte[] buffer = new byte[1 << 16];
+        int n;
+        while ((n = in.read(buffer)) > 0) out.write(buffer, 0, n);
+    }
+
+    // What the camera wrote that still describes the graded photo (sizes come from the new JPEG).
+    private static final String[] EXIF_TAGS = {
+            ExifInterface.TAG_ORIENTATION,
+            ExifInterface.TAG_DATETIME, ExifInterface.TAG_DATETIME_ORIGINAL,
+            ExifInterface.TAG_DATETIME_DIGITIZED, ExifInterface.TAG_SUBSEC_TIME,
+            ExifInterface.TAG_SUBSEC_TIME_ORIGINAL, ExifInterface.TAG_SUBSEC_TIME_DIGITIZED,
+            ExifInterface.TAG_OFFSET_TIME, ExifInterface.TAG_OFFSET_TIME_ORIGINAL,
+            ExifInterface.TAG_OFFSET_TIME_DIGITIZED,
+            ExifInterface.TAG_MAKE, ExifInterface.TAG_MODEL,
+            ExifInterface.TAG_EXPOSURE_TIME, ExifInterface.TAG_F_NUMBER,
+            ExifInterface.TAG_PHOTOGRAPHIC_SENSITIVITY, ExifInterface.TAG_FOCAL_LENGTH,
+            ExifInterface.TAG_FOCAL_LENGTH_IN_35MM_FILM, ExifInterface.TAG_APERTURE_VALUE,
+            ExifInterface.TAG_SHUTTER_SPEED_VALUE, ExifInterface.TAG_BRIGHTNESS_VALUE,
+            ExifInterface.TAG_EXPOSURE_BIAS_VALUE, ExifInterface.TAG_EXPOSURE_PROGRAM,
+            ExifInterface.TAG_EXPOSURE_MODE, ExifInterface.TAG_METERING_MODE,
+            ExifInterface.TAG_WHITE_BALANCE, ExifInterface.TAG_FLASH,
+            ExifInterface.TAG_SCENE_CAPTURE_TYPE,
+            ExifInterface.TAG_GPS_LATITUDE, ExifInterface.TAG_GPS_LATITUDE_REF,
+            ExifInterface.TAG_GPS_LONGITUDE, ExifInterface.TAG_GPS_LONGITUDE_REF,
+            ExifInterface.TAG_GPS_ALTITUDE, ExifInterface.TAG_GPS_ALTITUDE_REF,
+            ExifInterface.TAG_GPS_TIMESTAMP, ExifInterface.TAG_GPS_DATESTAMP,
+            ExifInterface.TAG_GPS_PROCESSING_METHOD,
+    };
+}
diff --git a/app/src/main/java/com/kompakt/camera/VhsOsd.java b/app/src/main/java/com/kompakt/camera/VhsOsd.java
new file mode 100644
index 0000000..aaa19b3
--- /dev/null
+++ b/app/src/main/java/com/kompakt/camera/VhsOsd.java
@@ -0,0 +1,66 @@
+/*
+ * SPDX-FileCopyrightText: KompaktOS
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.kompakt.camera;
+
+import android.content.Context;
+import android.graphics.Bitmap;
+import android.graphics.Canvas;
+import android.graphics.Color;
+import android.graphics.Paint;
+import android.graphics.Typeface;
+import android.util.Log;
+
+import org.lineageos.aperture.R;
+
+import java.util.Calendar;
+import java.util.Locale;
+
+/** The camcorder clock burned into a VHS video: date over time, bottom left, in the VCR font. */
+final class VhsOsd {
+    private static final String[] MONTHS = {"JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG",
+            "SEP", "OCT", "NOV", "DEC"};
+
+    private VhsOsd() {}
+
+    static Typeface font(Context context) {
+        try {
+            Typeface typeface = context.getResources().getFont(R.font.vcr_osd_mono);
+            if (typeface != null) return typeface;
+        } catch (Exception e) {
+            Log.e("KompaktVhsOsd", "osd font", e);
+        }
+        return Typeface.MONOSPACE;
+    }
+
+    /** A transparent frame-sized overlay with the clock at {@code timeMs}, in white. */
+    static Bitmap render(Typeface typeface, int width, int height, long timeMs) {
+        Bitmap bitmap = Bitmap.createBitmap(width, height, Bitmap.Config.ARGB_8888);
+        Canvas canvas = new Canvas(bitmap);
+        float shortEdge = Math.min(width, height);
+        float margin = shortEdge * 0.06f;
+        Paint paint = new Paint(Paint.ANTI_ALIAS_FLAG);
+        paint.setTypeface(typeface);
+        paint.setTextSize(shortEdge * 0.055f);
+        paint.setColor(Color.WHITE);
+        Paint.FontMetrics metrics = paint.getFontMetrics();
+
+        Calendar calendar = Calendar.getInstance();
+        calendar.setTimeInMillis(timeMs);
+        int hour = calendar.get(Calendar.HOUR);
+        if (hour == 0) hour = 12;
+        String time = String.format(Locale.US, "%2d:%02d:%02d %s", hour,
+                calendar.get(Calendar.MINUTE), calendar.get(Calendar.SECOND),
+                calendar.get(Calendar.AM_PM) == Calendar.AM ? "AM" : "PM");
+        String date = String.format(Locale.US, "%s %2d %d", MONTHS[calendar.get(Calendar.MONTH)],
+                calendar.get(Calendar.DAY_OF_MONTH), calendar.get(Calendar.YEAR));
+
+        float lineH = (metrics.descent - metrics.ascent) * 1.08f;
+        float baseline = height - margin - metrics.descent;
+        canvas.drawText(time, margin, baseline, paint);
+        canvas.drawText(date, margin, baseline - lineH, paint);
+        return bitmap;
+    }
+}
