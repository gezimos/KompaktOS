+/** Re-encodes a video through the Style shader: VHS (4:3, 480 lines), B&W or Film grain (full size). */
+final class VideoStyleProcessor {
+    private static final String TAG = "KompaktVideoStyle";
+
+    static final int MODE_VHS = 1;
+    static final int MODE_BW = 2;
+    static final int MODE_FILM = 3;
+
+    private static final int TARGET_SHORT_EDGE = 480;
+    private static final int BIT_RATE = 2500000;
+    private static final long FRAME_TIMEOUT_MS = 5000;
+    private static final long CODEC_TIMEOUT_US = 10000;
+    private static final long DRAIN_TIMEOUT_MS = 20000;
+
+    private static final String VERTEX_SHADER =
+            "attribute vec2 a_pos;\n" +
+            "attribute vec2 a_uv;\n" +
+            "varying vec2 v_uv;\n" +
+            "void main() {\n" +
+            "    gl_Position = vec4(a_pos, 0.0, 1.0);\n" +
+            "    v_uv = a_uv;\n" +
+            "}\n";
+
+    private static final String FRAGMENT_SHADER =
+            "#extension GL_OES_EGL_image_external : require\n" +
+            "precision highp float;\n" +
+            "uniform samplerExternalOES u_tex;\n" +
+            "uniform vec2 u_step;\n" +
+            "uniform vec2 u_vstep;\n" +
+            "uniform vec2 u_size;\n" +
+            "uniform vec2 u_dsize;\n" +
+            "uniform int u_rot;\n" +
+            "uniform sampler2D u_osd;\n" +
+            "uniform int u_osd_on;\n" +
+            "uniform float u_frame;\n" +
+            "uniform int u_mode;\n" +
+            "varying vec2 v_uv;\n" +
+            "float hash(vec2 p) {\n" +
+            "    return fract(sin(dot(p, vec2(12.9898, 78.233))) * 43758.5453);\n" +
+            "}\n" +
+            "float vnoise(vec2 p) {\n" +
+            "    vec2 i = floor(p);\n" +
+            "    vec2 f = fract(p);\n" +
+            "    f = f * f * (3.0 - 2.0 * f);\n" +
+            "    float a = hash(i);\n" +
+            "    float b = hash(i + vec2(1.0, 0.0));\n" +
+            "    float c = hash(i + vec2(0.0, 1.0));\n" +
+            "    float d = hash(i + vec2(1.0, 1.0));\n" +
+            "    return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);\n" +
+            "}\n" +
+            "float fbm(vec2 p) {\n" +
+            "    return vnoise(p) * 0.65 + vnoise(p * 2.17) * 0.35;\n" +
+            "}\n" +
+            "float grain(vec2 p, float t) {\n" +
+            "    float a = vnoise(p + vec2(t * 11.7, t * 5.3));\n" +
+            "    float b = vnoise(p * 0.34 + vec2(-t * 3.1, t * 7.9));\n" +
+            "    return (0.60 * a + 0.40 * b - 0.5) * 2.0;\n" +
+            "}\n" +
+            "float soft_light(float a, float b) {\n" +
+            "    return (1.0 - 2.0 * b) * a * a + 2.0 * b * a;\n" +
+            "}\n" +
+            "vec3 to_yiq(vec3 c) {\n" +
+            "    return vec3(dot(c, vec3(0.299, 0.587, 0.114)), dot(c, vec3(0.596, -0.274, -0.322)), dot(c, vec3(0.211, -0.523, 0.312)));\n" +
+            "}\n" +
+            "vec3 to_rgb(vec3 y) {\n" +
+            "    return vec3(y.x + 0.956*y.y + 0.621*y.z, y.x - 0.272*y.y - 0.647*y.z, y.x - 1.106*y.y + 1.703*y.z);\n" +
+            "}\n" +
+            "void main() {\n" +
+            "    vec2 uv = v_uv;\n" +
+            "    vec2 fc = gl_FragCoord.xy;\n" +
+            "    vec2 dc = fc;\n" +
+            "    if( u_rot == 90 ) dc = vec2(fc.y, u_size.x - fc.x);\n" +
+            "    else if( u_rot == 180 ) dc = vec2(u_size.x - fc.x, u_size.y - fc.y);\n" +
+            "    else if( u_rot == 270 ) dc = vec2(u_size.y - fc.y, fc.x);\n" +
+            "    if( u_mode == 1 ) {\n" +
+            "        float row = floor(dc.y);\n" +
+            "        float t = mod(u_frame, 1024.0);\n" +
+            "        float off = (fbm(vec2(row * 0.05, t * 0.13)) - 0.5) * 1.0;\n" +
+            "        uv += u_step * off;\n" +
+            "        float y0 = to_yiq(texture2D(u_tex, uv).rgb).x;\n" +
+            "        float ym1 = to_yiq(texture2D(u_tex, uv - u_step).rgb).x;\n" +
+            "        float ym2 = to_yiq(texture2D(u_tex, uv - 2.0 * u_step).rgb).x;\n" +
+            "        float ym3 = to_yiq(texture2D(u_tex, uv - 3.0 * u_step).rgb).x;\n" +
+            "        float yp1 = to_yiq(texture2D(u_tex, uv + u_step).rgb).x;\n" +
+            "        float y = mix(y0, ym1 * 0.5 + ym2 * 0.33 + ym3 * 0.17, 0.22);\n" +
+            "        y += (y0 - (ym1 + yp1) * 0.5) * 0.25;\n" +
+            "        y += ((ym1 - y0) * 0.30 - (ym2 - y0) * 0.18 + (ym3 - y0) * 0.10) * 0.55;\n" +
+            "        vec2 chroma = vec2(0.0);\n" +
+            "        float wsum = 0.0;\n" +
+            "        for(int k=0;k<8;k++) {\n" +
+            "            float w = 1.0 - float(k) / 9.0;\n" +
+            "            vec2 o = uv - (float(k) + 1.5) * u_step;\n" +
+            "            chroma += w * 0.5 * (to_yiq(texture2D(u_tex, o).rgb).yz + to_yiq(texture2D(u_tex, o + u_vstep).rgb).yz);\n" +
+            "            wsum += w;\n" +
+            "        }\n" +
+            "        chroma /= wsum;\n" +
+            "        float mid = 0.35 + 2.6 * y0 * (1.0 - y0);\n" +
+            "        chroma += (vec2(fbm(vec2(dc.x * 0.05, row * 0.4 + t * 0.9)), fbm(vec2(dc.x * 0.05 + 37.0, row * 0.4 - t * 0.7))) - 0.5) * 0.2 * mid;\n" +
+            "        y += ((fbm(vec2(dc.x * 0.5, row * 0.9 + t * 11.0)) - 0.5) * 0.10 + (vnoise(vec2(dc.x * 1.7, row * 1.3 + t * 23.0)) - 0.5) * 0.02) * mid;\n" +
+            "        y += length(chroma) * 0.035 * cos(dc.x * 1.848 + (row + t) * 3.14159265);\n" +
+            "        vec3 rgb = clamp(to_rgb(vec3(y, chroma)), 0.0, 1.0);\n" +
+            "        if( u_osd_on == 1 ) {\n" +
+            "            float a = texture2D(u_osd, vec2(dc.x / u_dsize.x, 1.0 - dc.y / u_dsize.y)).a;\n" +
+            "            rgb = mix(rgb, vec3(1.0), a);\n" +
+            "        }\n" +
+            "        gl_FragColor = vec4(rgb, 1.0);\n" +
+            "    }\n" +
+            "    else if( u_mode == 2 || u_mode == 3 ) {\n" +
+            "        vec3 c = clamp(texture2D(u_tex, uv).rgb, 0.0, 1.0);\n" +
+            "        float t = mod(u_frame, 1024.0);\n" +
+            "        float gs = max(1.0, u_dsize.y / 300.0);\n" +
+            "        float g = grain(dc / gs, t);\n" +
+            "        vec2 vv = dc / u_dsize - 0.5;\n" +
+            "        float vig = 1.0 - 0.30 * dot(vv, vv);\n" +
+            "        if( u_mode == 2 ) {\n" +
+            "            float y = dot(c, vec3(0.21, 0.72, 0.07));\n" +
+            "            vec3 blur = texture2D(u_tex, uv + u_step * 2.0).rgb + texture2D(u_tex, uv - u_step * 2.0).rgb;\n" +
+            "            float halo = max(dot(blur * 0.5, vec3(0.21, 0.72, 0.07)) - 0.75, 0.0);\n" +
+            "            float s = y * y * (3.0 - 2.0 * y);\n" +
+            "            y = mix(y, s, 0.70);\n" +
+            "            y = 0.006 + 0.985 * y;\n" +
+            "            y = clamp(y + halo * 0.18, 0.0, 1.0);\n" +
+            "            y = soft_light(y, 0.5 + g * 0.17);\n" +
+            "            gl_FragColor = vec4(vec3(clamp(y * vig, 0.0, 1.0)), 1.0);\n" +
+            "        }\n" +
+            "        else {\n" +
+            "            vec3 s = c * c * (3.0 - 2.0 * c);\n" +
+            "            c = mix(c, s, 0.30);\n" +
+            "            float j = vnoise(dc * 0.9 + vec2(t * 13.0, t * 6.0)) - 0.5;\n" +
+            "            vec3 b = vec3(0.5) + vec3(g + j * 0.35, g - j * 0.20, g + j * 0.28) * 0.12;\n" +
+            "            c = vec3(soft_light(c.r, b.r), soft_light(c.g, b.g), soft_light(c.b, b.b));\n" +
+            "            gl_FragColor = vec4(clamp(c * vig, 0.0, 1.0), 1.0);\n" +
+            "        }\n" +
+            "    }\n" +
+            "    else {\n" +
+            "        gl_FragColor = vec4(texture2D(u_tex, uv).rgb, 1.0);\n" +
+            "    }\n" +
+            "}\n";
+
+    private final Object frame_lock = new Object();
+    private boolean frame_available;
+
+    static boolean process(Context context, MediaExtractor extractor, MediaMuxer muxer, int filter, long seed) {
+        try {
+            return new VideoStyleProcessor().run(context, extractor, muxer, filter, seed);
+        }
+        catch(Exception e) {
+            Log.e(TAG, "video filter failed", e);
+            return false;
+        }
+    }
+
+    private boolean run(Context context, MediaExtractor extractor, MediaMuxer muxer, int filter, long seed) throws Exception {
+        int video_track = -1, audio_track = -1;
+        MediaFormat video_format = null, audio_format = null;
+        for(int i=0;i<extractor.getTrackCount();i++) {
+            MediaFormat format = extractor.getTrackFormat(i);
+            String mime = format.getString(MediaFormat.KEY_MIME);
+            if( mime == null )
+                continue;
+            if( video_track == -1 && mime.startsWith("video/") ) {
+                video_track = i;
+                video_format = format;
+            }
+            else if( audio_track == -1 && mime.startsWith("audio/") ) {
+                audio_track = i;
+                audio_format = format;
+            }
+        }
+        if( video_track == -1 )
+            return false;
+
+        int src_w = video_format.getInteger(MediaFormat.KEY_WIDTH);
+        int src_h = video_format.getInteger(MediaFormat.KEY_HEIGHT);
+        int rotation = video_format.containsKey(MediaFormat.KEY_ROTATION) ? video_format.getInteger(MediaFormat.KEY_ROTATION) : 0;
+        rotation = ((rotation % 360) + 360) % 360;
+        // Kompakt: VHS is a tape frame, 4:3 (3:4 held upright) at 480 lines, cut from the centre;
+        // B&W and Film keep the source frame. keep_x and keep_y are the source fractions kept.
+        float keep_x = 1.0f, keep_y = 1.0f;
+        int out_w = src_w, out_h = src_h;
+        if( filter == MODE_VHS ) {
+            boolean upright = rotation % 180 == 0;
+            float shown_w = upright ? src_w : src_h;
+            float shown_h = upright ? src_h : src_w;
+            boolean landscape = shown_w >= shown_h;
+            float target = landscape ? 4.0f / 3.0f : 3.0f / 4.0f;
+            float keep_sw = Math.min(1.0f, target * shown_h / shown_w);
+            float keep_sh = Math.min(1.0f, shown_w / (target * shown_h));
+            keep_x = upright ? keep_sw : keep_sh;
+            keep_y = upright ? keep_sh : keep_sw;
+            int long_edge = TARGET_SHORT_EDGE * 4 / 3;
+            int sw = landscape ? long_edge : TARGET_SHORT_EDGE;
+            int sh = landscape ? TARGET_SHORT_EDGE : long_edge;
+            out_w = upright ? sw : sh;
+            out_h = upright ? sh : sw;
+        }
+        int fps = video_format.containsKey(MediaFormat.KEY_FRAME_RATE) ? video_format.getInteger(MediaFormat.KEY_FRAME_RATE) : 30;
+        Log.d(TAG, "src " + src_w + "x" + src_h + " rot " + rotation + " -> out " + out_w + "x" + out_h + " fps " + fps);
+
+        extractor.selectTrack(video_track);
+
+        MediaFormat encoder_format = MediaFormat.createVideoFormat(MediaFormat.MIMETYPE_VIDEO_AVC, out_w, out_h);
+        encoder_format.setInteger(MediaFormat.KEY_COLOR_FORMAT, MediaCodecInfo.CodecCapabilities.COLOR_FormatSurface);
+        encoder_format.setInteger(MediaFormat.KEY_BIT_RATE, filter == MODE_VHS ? BIT_RATE : fullBitRate(out_w, out_h, fps));
+        encoder_format.setInteger(MediaFormat.KEY_FRAME_RATE, fps);
+        encoder_format.setInteger(MediaFormat.KEY_I_FRAME_INTERVAL, 1);
+
+        MediaCodec encoder = null, decoder = null;
+        EGLDisplay egl_display = EGL14.EGL_NO_DISPLAY;
+        EGLContext egl_context = EGL14.EGL_NO_CONTEXT;
+        EGLSurface egl_surface = EGL14.EGL_NO_SURFACE;
+        Surface encoder_surface = null, decoder_surface = null;
+        SurfaceTexture surface_texture = null;
+        HandlerThread frame_thread = null;
+        boolean muxer_started = false;
+        boolean success = false;
+
+        try {
+            encoder = MediaCodec.createEncoderByType(MediaFormat.MIMETYPE_VIDEO_AVC);
+            encoder.configure(encoder_format, null, null, MediaCodec.CONFIGURE_FLAG_ENCODE);
+            encoder_surface = encoder.createInputSurface();
+            encoder.start();
+
+            egl_display = EGL14.eglGetDisplay(EGL14.EGL_DEFAULT_DISPLAY);
+            int [] egl_version = new int[2];
+            if( !EGL14.eglInitialize(egl_display, egl_version, 0, egl_version, 1) )
+                throw new RuntimeException("eglInitialize failed");
+            int [] config_attribs = {
+                    EGL14.EGL_RED_SIZE, 8, EGL14.EGL_GREEN_SIZE, 8, EGL14.EGL_BLUE_SIZE, 8,
+                    EGL14.EGL_RENDERABLE_TYPE, EGL14.EGL_OPENGL_ES2_BIT,
+                    EGLExt.EGL_RECORDABLE_ANDROID, 1,
+                    EGL14.EGL_NONE};
+            EGLConfig [] configs = new EGLConfig[1];
+            int [] n_configs = new int[1];
+            if( !EGL14.eglChooseConfig(egl_display, config_attribs, 0, configs, 0, 1, n_configs, 0) || n_configs[0] == 0 )
+                throw new RuntimeException("eglChooseConfig failed");
+            egl_context = EGL14.eglCreateContext(egl_display, configs[0], EGL14.EGL_NO_CONTEXT,
+                    new int[]{EGL14.EGL_CONTEXT_CLIENT_VERSION, 2, EGL14.EGL_NONE}, 0);
+            egl_surface = EGL14.eglCreateWindowSurface(egl_display, configs[0], encoder_surface, new int[]{EGL14.EGL_NONE}, 0);
+            if( !EGL14.eglMakeCurrent(egl_display, egl_surface, egl_surface, egl_context) )
+                throw new RuntimeException("eglMakeCurrent failed");
+            GLES20.glViewport(0, 0, out_w, out_h);
+
+            int program = buildProgram();
+            int a_pos = GLES20.glGetAttribLocation(program, "a_pos");
+            int a_uv = GLES20.glGetAttribLocation(program, "a_uv");
+            int u_tex = GLES20.glGetUniformLocation(program, "u_tex");
+            int u_step = GLES20.glGetUniformLocation(program, "u_step");
+            int u_vstep = GLES20.glGetUniformLocation(program, "u_vstep");
+            int u_size = GLES20.glGetUniformLocation(program, "u_size");
+            int u_dsize = GLES20.glGetUniformLocation(program, "u_dsize");
+            int u_rot = GLES20.glGetUniformLocation(program, "u_rot");
+            int u_frame = GLES20.glGetUniformLocation(program, "u_frame");
+            int u_mode = GLES20.glGetUniformLocation(program, "u_mode");
+
+            int u_osd = GLES20.glGetUniformLocation(program, "u_osd");
+            int u_osd_on = GLES20.glGetUniformLocation(program, "u_osd_on");
+
+            int disp_w = rotation % 180 == 0 ? out_w : out_h;
+            int disp_h = rotation % 180 == 0 ? out_h : out_w;
+            boolean osd_on = filter == MODE_VHS;
+            Typeface osd_font = osd_on ? VhsOsd.font(context) : null;
+            long osd_base_ms = seed - (video_format.containsKey(MediaFormat.KEY_DURATION)
+                    ? video_format.getLong(MediaFormat.KEY_DURATION)/1000 : 0);
+            long osd_second = Long.MIN_VALUE;
+            int [] osd_tex = new int[1];
+            if( osd_on ) {
+                GLES20.glGenTextures(1, osd_tex, 0);
+                GLES20.glBindTexture(GLES20.GL_TEXTURE_2D, osd_tex[0]);
+                GLES20.glTexParameteri(GLES20.GL_TEXTURE_2D, GLES20.GL_TEXTURE_MIN_FILTER, GLES20.GL_LINEAR);
+                GLES20.glTexParameteri(GLES20.GL_TEXTURE_2D, GLES20.GL_TEXTURE_MAG_FILTER, GLES20.GL_LINEAR);
+                GLES20.glTexParameteri(GLES20.GL_TEXTURE_2D, GLES20.GL_TEXTURE_WRAP_S, GLES20.GL_CLAMP_TO_EDGE);
+                GLES20.glTexParameteri(GLES20.GL_TEXTURE_2D, GLES20.GL_TEXTURE_WRAP_T, GLES20.GL_CLAMP_TO_EDGE);
+            }
+
+            int [] tex = new int[1];
+            GLES20.glGenTextures(1, tex, 0);
+            GLES20.glBindTexture(GLES11Ext.GL_TEXTURE_EXTERNAL_OES, tex[0]);
+            GLES20.glTexParameteri(GLES11Ext.GL_TEXTURE_EXTERNAL_OES, GLES20.GL_TEXTURE_MIN_FILTER, GLES20.GL_LINEAR);
+            GLES20.glTexParameteri(GLES11Ext.GL_TEXTURE_EXTERNAL_OES, GLES20.GL_TEXTURE_MAG_FILTER, GLES20.GL_LINEAR);
+            GLES20.glTexParameteri(GLES11Ext.GL_TEXTURE_EXTERNAL_OES, GLES20.GL_TEXTURE_WRAP_S, GLES20.GL_CLAMP_TO_EDGE);
+            GLES20.glTexParameteri(GLES11Ext.GL_TEXTURE_EXTERNAL_OES, GLES20.GL_TEXTURE_WRAP_T, GLES20.GL_CLAMP_TO_EDGE);
+
+            surface_texture = new SurfaceTexture(tex[0]);
+            surface_texture.setDefaultBufferSize(src_w, src_h);
+            frame_thread = new HandlerThread("VHSVideoFrames");
+            frame_thread.start();
+            surface_texture.setOnFrameAvailableListener(new SurfaceTexture.OnFrameAvailableListener() {
+                @Override
+                public void onFrameAvailable(SurfaceTexture st) {
+                    synchronized(frame_lock) {
+                        frame_available = true;
+                        frame_lock.notifyAll();
+                    }
+                }
+            }, new Handler(frame_thread.getLooper()));
+            decoder_surface = new Surface(surface_texture);
+
+            decoder = MediaCodec.createDecoderByType(video_format.getString(MediaFormat.KEY_MIME));
+            if( video_format.containsKey(MediaFormat.KEY_ROTATION) )
+                video_format.setInteger(MediaFormat.KEY_ROTATION, 0);
+            decoder.configure(video_format, decoder_surface, null, 0);
+            decoder.start();
+
+            float [] positions = {-1, -1, 1, -1, -1, 1, 1, 1};
+            FloatBuffer position_buffer = ByteBuffer.allocateDirect(positions.length * 4).order(ByteOrder.nativeOrder()).asFloatBuffer();
+            position_buffer.put(positions).position(0);
+            float crop_x0 = (1.0f - keep_x) / 2.0f, crop_x1 = (1.0f + keep_x) / 2.0f;
+            float crop_y0 = (1.0f - keep_y) / 2.0f, crop_y1 = (1.0f + keep_y) / 2.0f;
+            float [][] base_uv = {{crop_x0, crop_y0}, {crop_x1, crop_y0}, {crop_x0, crop_y1}, {crop_x1, crop_y1}};
+            float [] st_matrix = new float[16];
+            float [] uvs = new float[8];
+            FloatBuffer uv_buffer = ByteBuffer.allocateDirect(uvs.length * 4).order(ByteOrder.nativeOrder()).asFloatBuffer();
+
+            MediaCodec.BufferInfo decoder_info = new MediaCodec.BufferInfo();
+            MediaCodec.BufferInfo encoder_info = new MediaCodec.BufferInfo();
+            boolean input_done = false, decoder_done = false;
+            MuxerState muxer_state = new MuxerState();
+            muxer_state.muxer = muxer;
+            muxer_state.audio_format = audio_format;
+            muxer.setOrientationHint(rotation);
+
+            boolean encoder_done = false;
+            int frame_index = 0;
+            while( !encoder_done ) {
+                if( !input_done ) {
+                    int in_index = decoder.dequeueInputBuffer(CODEC_TIMEOUT_US);
+                    if( in_index >= 0 ) {
+                        ByteBuffer in_buffer = decoder.getInputBuffer(in_index);
+                        int size = extractor.readSampleData(in_buffer, 0);
+                        if( size < 0 ) {
+                            decoder.queueInputBuffer(in_index, 0, 0, 0, MediaCodec.BUFFER_FLAG_END_OF_STREAM);
+                            input_done = true;
+                        }
+                        else {
+                            decoder.queueInputBuffer(in_index, 0, size, extractor.getSampleTime(), 0);
+                            extractor.advance();
+                        }
+                    }
+                }
+
+                if( !decoder_done ) {
+                    int out_index = decoder.dequeueOutputBuffer(decoder_info, CODEC_TIMEOUT_US);
+                    if( out_index >= 0 ) {
+                        boolean eos = (decoder_info.flags & MediaCodec.BUFFER_FLAG_END_OF_STREAM) != 0;
+                        boolean render = decoder_info.size > 0;
+                        decoder.releaseOutputBuffer(out_index, render);
+                        if( render && awaitFrame() ) {
+                            surface_texture.updateTexImage();
+                            surface_texture.getTransformMatrix(st_matrix);
+                            for(int corner=0;corner<4;corner++) {
+                                float u = base_uv[corner][0];
+                                float v = base_uv[corner][1];
+                                uvs[corner*2] = st_matrix[0]*u + st_matrix[4]*v + st_matrix[12];
+                                uvs[corner*2+1] = st_matrix[1]*u + st_matrix[5]*v + st_matrix[13];
+                            }
+                            uv_buffer.put(uvs).position(0);
+                            float cx_u = (uvs[2] - uvs[0]) / out_w;
+                            float cx_v = (uvs[3] - uvs[1]) / out_w;
+                            float cy_u = (uvs[4] - uvs[0]) / out_h;
+                            float cy_v = (uvs[5] - uvs[1]) / out_h;
+                            float step_x, step_y, vstep_x, vstep_y;
+                            switch( rotation ) {
+                                case 90:
+                                    step_x = cy_u;   step_y = cy_v;
+                                    vstep_x = -cx_u; vstep_y = -cx_v;
+                                    break;
+                                case 180:
+                                    step_x = -cx_u;  step_y = -cx_v;
+                                    vstep_x = -cy_u; vstep_y = -cy_v;
+                                    break;
+                                case 270:
+                                    step_x = -cy_u;  step_y = -cy_v;
+                                    vstep_x = cx_u;  vstep_y = cx_v;
+                                    break;
+                                default:
+                                    step_x = cx_u;   step_y = cx_v;
+                                    vstep_x = cy_u;  vstep_y = cy_v;
+                                    break;
+                            }
+
+                            GLES20.glUseProgram(program);
+                            if( osd_on ) {
+                                long second = (osd_base_ms + decoder_info.presentationTimeUs/1000)/1000;
+                                GLES20.glActiveTexture(GLES20.GL_TEXTURE1);
+                                GLES20.glBindTexture(GLES20.GL_TEXTURE_2D, osd_tex[0]);
+                                if( second != osd_second ) {
+                                    osd_second = second;
+                                    Bitmap overlay = VhsOsd.render(osd_font, disp_w, disp_h, second*1000);
+                                    GLUtils.texImage2D(GLES20.GL_TEXTURE_2D, 0, overlay, 0);
+                                    overlay.recycle();
+                                }
+                            }
+                            GLES20.glActiveTexture(GLES20.GL_TEXTURE0);
+                            GLES20.glBindTexture(GLES11Ext.GL_TEXTURE_EXTERNAL_OES, tex[0]);
+                            GLES20.glUniform1i(u_tex, 0);
+                            GLES20.glUniform1i(u_osd, 1);
+                            GLES20.glUniform1i(u_osd_on, osd_on ? 1 : 0);
+                            GLES20.glUniform2f(u_step, step_x, step_y);
+                            GLES20.glUniform2f(u_vstep, vstep_x, vstep_y);
+                            GLES20.glUniform2f(u_size, out_w, out_h);
+                            GLES20.glUniform2f(u_dsize, rotation % 180 == 0 ? out_w : out_h, rotation % 180 == 0 ? out_h : out_w);
+                            GLES20.glUniform1i(u_rot, rotation);
+                            GLES20.glUniform1f(u_frame, (frame_index + (int)(seed % 1000)) % 100000);
+                            GLES20.glUniform1i(u_mode, filter == MODE_BW ? 2 : filter == MODE_FILM ? 3 : 1);
+                            GLES20.glEnableVertexAttribArray(a_pos);
+                            GLES20.glVertexAttribPointer(a_pos, 2, GLES20.GL_FLOAT, false, 0, position_buffer);
+                            GLES20.glEnableVertexAttribArray(a_uv);
+                            GLES20.glVertexAttribPointer(a_uv, 2, GLES20.GL_FLOAT, false, 0, uv_buffer);
+                            GLES20.glDrawArrays(GLES20.GL_TRIANGLE_STRIP, 0, 4);
+                            GLES20.glDisableVertexAttribArray(a_pos);
+                            GLES20.glDisableVertexAttribArray(a_uv);
+                            EGLExt.eglPresentationTimeANDROID(egl_display, egl_surface, decoder_info.presentationTimeUs * 1000);
+                            EGL14.eglSwapBuffers(egl_display, egl_surface);
+                            frame_index++;
+                        }
+                        if( eos ) {
+                            decoder_done = true;
+                            encoder.signalEndOfInputStream();
+                        }
+                    }
+                }
+
+                encoder_done = drainEncoder(encoder, encoder_info, muxer_state, decoder_done);
+            }
+            muxer_started = muxer_state.started;
+
+            if( audio_track != -1 && muxer_state.audio_track_index != -1 ) {
+                extractor.unselectTrack(video_track);
+                extractor.selectTrack(audio_track);
+                extractor.seekTo(0, MediaExtractor.SEEK_TO_CLOSEST_SYNC);
+                int max_size = audio_format.containsKey(MediaFormat.KEY_MAX_INPUT_SIZE) ? audio_format.getInteger(MediaFormat.KEY_MAX_INPUT_SIZE) : 262144;
+                ByteBuffer audio_buffer = ByteBuffer.allocateDirect(Math.max(max_size, 4096));
+                MediaCodec.BufferInfo audio_info = new MediaCodec.BufferInfo();
+                while( true ) {
+                    int size = extractor.readSampleData(audio_buffer, 0);
+                    if( size < 0 )
+                        break;
+                    audio_info.offset = 0;
+                    audio_info.size = size;
+                    audio_info.presentationTimeUs = extractor.getSampleTime();
+                    audio_info.flags = (extractor.getSampleFlags() & MediaExtractor.SAMPLE_FLAG_SYNC) != 0 ? MediaCodec.BUFFER_FLAG_KEY_FRAME : 0;
+                    muxer.writeSampleData(muxer_state.audio_track_index, audio_buffer, audio_info);
+                    extractor.advance();
+                }
+            }
+
+            if( !muxer_state.started || muxer_state.frames_written == 0 || !input_done || !decoder_done )
+                throw new RuntimeException("incomplete transcode: frames=" + muxer_state.frames_written + " input_done=" + input_done + " decoder_done=" + decoder_done);
+            success = true;
+        }
+        finally {
+            if( egl_display != EGL14.EGL_NO_DISPLAY ) {
+                EGL14.eglMakeCurrent(egl_display, EGL14.EGL_NO_SURFACE, EGL14.EGL_NO_SURFACE, EGL14.EGL_NO_CONTEXT);
+                if( egl_surface != EGL14.EGL_NO_SURFACE )
+                    EGL14.eglDestroySurface(egl_display, egl_surface);
+                if( egl_context != EGL14.EGL_NO_CONTEXT )
+                    EGL14.eglDestroyContext(egl_display, egl_context);
+                EGL14.eglReleaseThread();
+                EGL14.eglTerminate(egl_display);
+            }
+            try {
+                if( decoder != null ) {
+                    decoder.stop();
+                    decoder.release();
+                }
+            }
+            catch(Exception e) {
+                Log.e(TAG, "decoder cleanup", e);
+            }
+            try {
+                if( encoder != null ) {
+                    encoder.stop();
+                    encoder.release();
+                }
+            }
+            catch(Exception e) {
+                Log.e(TAG, "encoder cleanup", e);
+            }
+            if( decoder_surface != null )
+                decoder_surface.release();
+            if( surface_texture != null )
+                surface_texture.release();
+            if( encoder_surface != null )
+                encoder_surface.release();
+            if( frame_thread != null )
+                frame_thread.quitSafely();
+            try {
+                if( muxer_started )
+                    muxer.stop();
+            }
+            catch(Exception e) {
+                Log.e(TAG, "muxer stop", e);
+                success = false;
+            }
+        }
+        return success;
+    }
+
+    /** About 0.12 bits a pixel a frame, as camera recordings run: 1080p30 is 7.5 Mbit/s. */
+    private static int fullBitRate(int w, int h, int fps) {
+        long rate = (long) (w * (long) h * Math.max(fps, 1) * 0.12);
+        return (int) Math.max(BIT_RATE, Math.min(rate, 20000000L));
+    }
+
+    private static class MuxerState {
+        MediaMuxer muxer;
+        MediaFormat audio_format;
+        boolean started;
+        int video_track_index = -1;
+        int audio_track_index = -1;
+        int frames_written;
+    }
+
+    private static boolean drainEncoder(MediaCodec encoder, MediaCodec.BufferInfo info, MuxerState state, boolean until_eos) {
+        long deadline = System.currentTimeMillis() + DRAIN_TIMEOUT_MS;
+        while( true ) {
+            if( until_eos && System.currentTimeMillis() > deadline )
+                throw new RuntimeException("timed out waiting for encoder end of stream");
+            int index = encoder.dequeueOutputBuffer(info, until_eos ? CODEC_TIMEOUT_US : 0);
+            if( index == MediaCodec.INFO_TRY_AGAIN_LATER ) {
+                if( !until_eos )
+                    return false;
+            }
+            else if( index == MediaCodec.INFO_OUTPUT_FORMAT_CHANGED ) {
+                state.video_track_index = state.muxer.addTrack(encoder.getOutputFormat());
+                if( state.audio_format != null ) {
+                    try {
+                        state.audio_track_index = state.muxer.addTrack(state.audio_format);
+                    }
+                    catch(Exception e) {
+                        Log.e(TAG, "audio track not muxable, dropping audio", e);
+                        state.audio_track_index = -1;
+                    }
+                }
+                state.muxer.start();
+                state.started = true;
+            }
+            else if( index >= 0 ) {
+                if( (info.flags & MediaCodec.BUFFER_FLAG_CODEC_CONFIG) != 0 )
+                    info.size = 0;
+                if( info.size > 0 && state.started ) {
+                    ByteBuffer buffer = encoder.getOutputBuffer(index);
+                    buffer.position(info.offset);
+                    buffer.limit(info.offset + info.size);
+                    state.muxer.writeSampleData(state.video_track_index, buffer, info);
+                    state.frames_written++;
+                }
+                boolean eos = (info.flags & MediaCodec.BUFFER_FLAG_END_OF_STREAM) != 0;
+                encoder.releaseOutputBuffer(index, false);
+                if( eos )
+                    return true;
+            }
+        }
+    }
+
+
+
+    private boolean awaitFrame() {
+        synchronized(frame_lock) {
+            long deadline = System.currentTimeMillis() + FRAME_TIMEOUT_MS;
+            while( !frame_available ) {
+                long wait = deadline - System.currentTimeMillis();
+                if( wait <= 0 ) {
+                    Log.e(TAG, "timed out waiting for frame");
+                    return false;
+                }
+                try {
+                    frame_lock.wait(wait);
+                }
+                catch(InterruptedException e) {
+                    Log.e(TAG, "interrupted", e);
+                }
+            }
+            frame_available = false;
+        }
+        return true;
+    }
+
+    private static int buildProgram() {
+        int vertex = compileShader(GLES20.GL_VERTEX_SHADER, VERTEX_SHADER);
+        int fragment = compileShader(GLES20.GL_FRAGMENT_SHADER, FRAGMENT_SHADER);
+        int program = GLES20.glCreateProgram();
+        GLES20.glAttachShader(program, vertex);
+        GLES20.glAttachShader(program, fragment);
+        GLES20.glLinkProgram(program);
+        int [] status = new int[1];
+        GLES20.glGetProgramiv(program, GLES20.GL_LINK_STATUS, status, 0);
+        if( status[0] == 0 )
+            throw new RuntimeException("program link failed: " + GLES20.glGetProgramInfoLog(program));
+        return program;
+    }
+
+    private static int compileShader(int type, String source) {
+        int shader = GLES20.glCreateShader(type);
+        GLES20.glShaderSource(shader, source);
+        GLES20.glCompileShader(shader);
+        int [] status = new int[1];
+        GLES20.glGetShaderiv(shader, GLES20.GL_COMPILE_STATUS, status, 0);
+        if( status[0] == 0 )
+            throw new RuntimeException("shader compile failed: " + GLES20.glGetShaderInfoLog(shader));
+        return shader;
+    }
+}
