From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Gezim <gezimos@users.noreply.github.com>
Date: Mon, 28 Sep 2026 21:00:00 +0200
Subject: [PATCH 1/1] Kompakt: the bottom bar says which camera is in use

---
diff --git a/app/src/main/java/org/lineageos/aperture/CameraActivity.kt b/app/src/main/java/org/lineageos/aperture/CameraActivity.kt
index edae6e0..e72cd1d 100644
--- a/app/src/main/java/org/lineageos/aperture/CameraActivity.kt
+++ b/app/src/main/java/org/lineageos/aperture/CameraActivity.kt
@@ -5,6 +5,7 @@
 
 package org.lineageos.aperture
 
+import android.widget.TextView
 import android.animation.ValueAnimator
 import android.app.KeyguardManager
 import android.content.ClipData
@@ -166,6 +167,7 @@ open class CameraActivity : AppCompatActivity(R.layout.activity_camera) {
     private val gridView by lazy { findViewById<GridView>(R.id.gridView) }
     private val islandView by lazy { findViewById<IslandView>(R.id.islandView) }
     private val lensSelectorLayout by lazy { findViewById<LensSelectorLayout>(R.id.lensSelectorLayout) }
+    private val cameraFacingText by lazy { findViewById<TextView>(R.id.cameraFacingText) }
     private val levelerView by lazy { findViewById<LevelerView>(R.id.levelerView) }
     private val mainLayout by lazy { findViewById<ConstraintLayout>(R.id.mainLayout) }
     private val micButton by lazy { findViewById<Button>(R.id.micButton) }
@@ -768,6 +770,14 @@ open class CameraActivity : AppCompatActivity(R.layout.activity_camera) {
                         it,
                         availableCameras,
                     )
+
+                    // Kompakt: show which camera is in use where the lens selector was.
+                    cameraFacingText.setText(
+                        when (it.cameraFacing) {
+                            CameraFacing.FRONT -> R.string.kompakt_camera_front
+                            else -> R.string.kompakt_camera_back
+                        }
+                    )
                 }
             }
         }
diff --git a/app/src/main/res/values/kompakt_strings.xml b/app/src/main/res/values/kompakt_strings.xml
new file mode 100644
index 0000000..6ae9c0a
--- /dev/null
+++ b/app/src/main/res/values/kompakt_strings.xml
@@ -0,0 +1,6 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- Kompakt: the camera in use, shown in the bottom bar. -->
+<resources>
+    <string name="kompakt_camera_front">Front</string>
+    <string name="kompakt_camera_back">Back</string>
+</resources>
