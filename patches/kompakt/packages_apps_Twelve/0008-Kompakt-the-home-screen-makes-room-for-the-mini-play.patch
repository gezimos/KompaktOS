     // Views
     private val navigationBarView by getViewProperty<NavigationBarView>(R.id.navigationBarView)
@@ -397,6 +400,16 @@ class MainFragment : Fragment(R.layout.fragment_main) {
 
         viewLifecycleOwner.lifecycleScope.launch {
             viewLifecycleOwner.repeatOnLifecycle(Lifecycle.State.STARTED) {
+                // Kompakt: with the mini player up, no Play random and tabs without labels.
+                launch {
+                    nowPlayingViewModel.mediaItem.collectLatest {
+                        playRandomSongsExtendedFloatingActionButton.isVisible = it == null
+                        navigationBarView.labelVisibilityMode = if (it == null)
+                            NavigationBarView.LABEL_VISIBILITY_LABELED
+                        else NavigationBarView.LABEL_VISIBILITY_UNLABELED
+                    }
+                }
+
