+
+package org.lineageos.twelve.ui.coil
+
+import android.content.Context
+import android.graphics.Bitmap
+import android.graphics.Color
+import androidx.preference.PreferenceManager
+import coil3.intercept.Interceptor
+import coil3.request.ImageResult
+import coil3.request.allowHardware
+import coil3.request.transformations
+import coil3.size.Size
+import coil3.transform.Transformation
+import org.lineageos.twelve.ext.ditherCovers
+
+/** Kompakt: with the setting on, every cover is drawn in black and white with a Bayer dither. */
+class KompaktDitherInterceptor(private val context: Context) : Interceptor {
+    override suspend fun intercept(chain: Interceptor.Chain): ImageResult {
+        if (!PreferenceManager.getDefaultSharedPreferences(context).ditherCovers) {
+            return chain.proceed()
+        }
+        val request = chain.request.newBuilder()
+            .transformations(chain.request.transformations + BayerDitherTransformation)
+            .allowHardware(false)
+            .build()
+        return chain.withRequest(request).proceed()
+    }
+}
+
+/** An 8x8 ordered dither to the two inks, on the luminance. */
+object BayerDitherTransformation : Transformation() {
+    private val matrix = intArrayOf(
+        0, 32, 8, 40, 2, 34, 10, 42,
+        48, 16, 56, 24, 50, 18, 58, 26,
+        12, 44, 4, 36, 14, 46, 6, 38,
+        60, 28, 52, 20, 62, 30, 54, 22,
+        3, 35, 11, 43, 1, 33, 9, 41,
+        51, 19, 59, 27, 49, 17, 57, 25,
+        15, 47, 7, 39, 13, 45, 5, 37,
+        63, 31, 55, 23, 61, 29, 53, 21,
+    )
+
+    override val cacheKey = "kompakt_bayer8"
+
+    override suspend fun transform(input: Bitmap, size: Size): Bitmap {
+        val source = if (input.config == Bitmap.Config.HARDWARE) {
+            input.copy(Bitmap.Config.ARGB_8888, false)
+        } else input
+        val width = source.width
+        val height = source.height
+        val pixels = IntArray(width * height)
+        source.getPixels(pixels, 0, width, 0, 0, width, height)
+        for (y in 0 until height) {
+            val row = (y and 7) * 8
+            for (x in 0 until width) {
+                val i = y * width + x
+                val c = pixels[i]
+                val luminance = (299 * Color.red(c) + 587 * Color.green(c) + 114 * Color.blue(c)) / 1000
+                pixels[i] = if (luminance > matrix[row + (x and 7)] * 4 + 2) Color.WHITE else Color.BLACK
+            }
+        }
+        return Bitmap.createBitmap(pixels, width, height, Bitmap.Config.ARGB_8888)
+    }
+}
