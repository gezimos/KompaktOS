+    private fun isKompaktBarWanted() = nowPlayingViewModel.mediaItem.value != null &&
+            kompaktBarRoute !in nowPlayingRelatedRouteIds
+
+    /**
+     * Kompakt: a page is held until it is built (no page part still loading, its pager showing a
+     * page), at most KOMPAKT_SETTLE_MS; e-ink would paint every step of its building.
+     */
+    private fun holdPageUntilReady(f: Fragment, v: View) {
+        f.postponeEnterTransition()
+        var shown = false
+        val show = {
+            if (!shown) {
+                shown = true
+                f.startPostponedEnterTransition()
+            }
+        }
+        val check = object : android.view.ViewTreeObserver.OnPreDrawListener {
+            override fun onPreDraw(): Boolean {
+                if (shown) {
+                    v.viewTreeObserver.removeOnPreDrawListener(this)
+                } else if (isKompaktPageBuilt(v)) {
+                    v.viewTreeObserver.removeOnPreDrawListener(this)
+                    show()
+                }
+                return true
+            }
+        }
+        v.viewTreeObserver.addOnPreDrawListener(check)
+        v.postDelayed({ show() }, KOMPAKT_SETTLE_MS)
+    }
+
+    private fun isKompaktPageBuilt(v: View): Boolean = when (v) {
+        is com.google.android.material.progressindicator.LinearProgressIndicator ->
+            v.getTag(R.id.linearProgressIndicator) == true
+        is androidx.viewpager2.widget.ViewPager2 ->
+            ((v.getChildAt(0) as? ViewGroup)?.childCount ?: 0) > 0 &&
+                    isKompaktChildrenBuilt(v)
+        is ViewGroup -> isKompaktChildrenBuilt(v)
+        else -> true
+    }
+
+    private fun isKompaktChildrenBuilt(g: ViewGroup): Boolean {
+        for (i in 0 until g.childCount) {
+            if (!isKompaktPageBuilt(g.getChildAt(i))) return false
+        }
+        return true
+    }
+
+    /** Kompakt: show or hide the mini player; a new page other than home puts it at the bottom. */
+    private fun applyKompaktBar(page: Fragment?) {
+        if (page != null) {
+            if (!kompaktBarPending) return
+            if (page !is org.lineageos.twelve.fragments.MainFragment) nowPlayingBar.translationY = 0f
+        }
+        kompaktBarPending = false
+        when (kompaktBarWanted) {
+            true -> nowPlayingBar.slideUp()
+            false -> nowPlayingBar.slideDown()
+        }
+        frameLayout.requestApplyInsets()
+    }
