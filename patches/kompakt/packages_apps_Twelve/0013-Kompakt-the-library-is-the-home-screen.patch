+package com.kompakt.eink;
+
+import android.content.Context;
+import android.util.AttributeSet;
+import android.view.GestureDetector;
+import android.view.MotionEvent;
+
+import androidx.core.widget.NestedScrollView;
+
+/** Kompakt: a scroll view that turns a page per swipe instead of scrolling with the finger. */
+public class PagedNestedScrollView extends NestedScrollView {
+
+    private final GestureDetector detector;
+    /** This gesture turned a page, so the rows under it get a cancel instead of a tap. */
+    private boolean paged;
+
+    public PagedNestedScrollView(Context context, AttributeSet attrs) {
+        super(context, attrs);
+        detector = new GestureDetector(context, new PageGestureListener(context, this::pageSelf));
+        setVerticalScrollBarEnabled(false);
+    }
+
+    /** One viewport, clamped at either end; true if it moved. */
+    private boolean pageSelf(int delta) {
+        final int before = getScrollY();
+        scrollBy(0, delta * (getHeight() - getPaddingTop() - getPaddingBottom()));
+        final boolean moved = getScrollY() != before;
+        paged |= moved;
+        return moved;
+    }
+
+    @Override
+    public boolean dispatchTouchEvent(MotionEvent ev) {
+        if (ev.getActionMasked() == MotionEvent.ACTION_DOWN) paged = false;
+        detector.onTouchEvent(ev);
+        return super.dispatchTouchEvent(ev);
+    }
+
+    @Override
+    public boolean onInterceptTouchEvent(MotionEvent ev) {
+        return paged;
+    }
+
+    @Override
+    public boolean onTouchEvent(MotionEvent ev) {
+        return true;
+    }
+}
