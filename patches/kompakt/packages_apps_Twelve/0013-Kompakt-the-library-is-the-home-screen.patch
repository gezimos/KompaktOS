+        // Kompakt: a pager's own list is not a row; a new layout manager would reset it to page 0.
+        if (rv.getParent() instanceof ViewPager2) return;
+        // Kompakt: rows appear, move and change in one step; no item animations.
+        rv.setItemAnimator(null);
         final RecyclerView.LayoutManager current = rv.getLayoutManager();
         if (current instanceof PagedLayoutManager || current instanceof PagedRowLayoutManager) return;
         int span = 1;
