---
 .../java/org/lineageos/twelve/ext/SharedPreferences.kt    | 6 ++++++
 .../java/org/lineageos/twelve/fragments/AlbumFragment.kt  | 6 ++++++
 .../java/org/lineageos/twelve/fragments/MainFragment.kt   | 8 ++++++--
 .../org/lineageos/twelve/fragments/PlaylistFragment.kt    | 6 ++++++
 app/src/main/res/values/kompakt_strings.xml               | 6 ++++++
 app/src/main/res/xml/root_preferences.xml                 | 8 ++++++++
 6 files changed, 38 insertions(+), 2 deletions(-)
 create mode 100644 app/src/main/res/values/kompakt_strings.xml

diff --git a/app/src/main/java/org/lineageos/twelve/ext/SharedPreferences.kt b/app/src/main/java/org/lineageos/twelve/ext/SharedPreferences.kt
index 4270b9d..960580b 100644
--- a/app/src/main/java/org/lineageos/twelve/ext/SharedPreferences.kt
+++ b/app/src/main/java/org/lineageos/twelve/ext/SharedPreferences.kt
@@ -75,6 +75,12 @@ private const val SKIP_SILENCE_DEFAULT = false
 val SharedPreferences.skipSilence: Boolean
     get() = getBoolean(SKIP_SILENCE_KEY, SKIP_SILENCE_DEFAULT)
 
+// Kompakt: Play random on the home screen and the album and playlist play buttons.
+private const val FLOATING_BUTTONS_KEY = "floating_buttons"
+private const val FLOATING_BUTTONS_DEFAULT = true
+val SharedPreferences.floatingButtons: Boolean
+    get() = getBoolean(FLOATING_BUTTONS_KEY, FLOATING_BUTTONS_DEFAULT)
+
 const val DEFAULT_PROVIDER_KEY = "default_provider"
 var SharedPreferences.defaultProvider: ProviderIdentifier?
     get() = getString(DEFAULT_PROVIDER_KEY, null)?.let {
diff --git a/app/src/main/java/org/lineageos/twelve/fragments/AlbumFragment.kt b/app/src/main/java/org/lineageos/twelve/fragments/AlbumFragment.kt
index 9659a92..1c6e443 100644
--- a/app/src/main/java/org/lineageos/twelve/fragments/AlbumFragment.kt
+++ b/app/src/main/java/org/lineageos/twelve/fragments/AlbumFragment.kt
@@ -23,6 +23,7 @@ import androidx.lifecycle.lifecycleScope
 import androidx.lifecycle.repeatOnLifecycle
 import androidx.navigation.fragment.findNavController
 import androidx.navigation.ui.setupWithNavController
+import androidx.preference.PreferenceManager
 import androidx.recyclerview.widget.RecyclerView
 import com.google.android.material.appbar.AppBarLayout
 import com.google.android.material.appbar.MaterialToolbar
@@ -35,6 +36,7 @@ import kotlinx.coroutines.launch
 import org.lineageos.twelve.R
 import org.lineageos.twelve.ext.Bundle
 import org.lineageos.twelve.ext.getParcelable
+import org.lineageos.twelve.ext.floatingButtons
 import org.lineageos.twelve.ext.getViewProperty
 import org.lineageos.twelve.ext.loadThumbnail
 import org.lineageos.twelve.ext.navigateSafe
@@ -178,6 +180,10 @@ class AlbumFragment : CollapsingToolbarLayoutFragment(R.layout.fragment_album) {
     override fun onViewCreated(view: View, savedInstanceState: Bundle?) {
         super.onViewCreated(view, savedInstanceState)
 
+        // Kompakt: the play buttons can be turned off in Settings.
+        playButtonsLinearLayout.isVisible =
+            PreferenceManager.getDefaultSharedPreferences(requireContext()).floatingButtons
+
         // Insets
         ViewCompat.setOnApplyWindowInsetsListener(toolbar) { v, windowInsets ->
             val insets = windowInsets.getInsets(WindowInsetsCompat.Type.displayCutout())
diff --git a/app/src/main/java/org/lineageos/twelve/fragments/MainFragment.kt b/app/src/main/java/org/lineageos/twelve/fragments/MainFragment.kt
index 1c5f5e4..0897622 100644
