diff --git a/app/src/main/res/values/kompakt_strings.xml b/app/src/main/res/values/kompakt_strings.xml
new file mode 100644
index 0000000..13ff108
--- /dev/null
+++ b/app/src/main/res/values/kompakt_strings.xml
@@ -0,0 +1,6 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- Kompakt: the floating buttons setting. -->
+<resources>
+    <string name="kompakt_floating_buttons">Floating buttons</string>
+    <string name="kompakt_floating_buttons_summary">The play buttons on the home screen, albums and playlists</string>
+</resources>
diff --git a/app/src/main/res/xml/root_preferences.xml b/app/src/main/res/xml/root_preferences.xml
