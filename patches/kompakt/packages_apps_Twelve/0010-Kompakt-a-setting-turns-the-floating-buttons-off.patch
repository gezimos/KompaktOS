@@ -44,6 +44,14 @@
             app:summary="@string/skip_silence_summary"
             app:title="@string/skip_silence" />
 
+        <!-- Kompakt: Play random and the album and playlist play buttons. -->
+        <SwitchPreference
+            app:defaultValue="true"
+            app:iconSpaceReserved="false"
+            app:key="floating_buttons"
+            app:summary="@string/kompakt_floating_buttons_summary"
+            app:title="@string/kompakt_floating_buttons" />
+
         <Preference
             app:iconSpaceReserved="false"
             app:key="reset_local_stats"
