 import androidx.lifecycle.repeatOnLifecycle
 import androidx.navigation.fragment.findNavController
 import androidx.navigation.ui.setupWithNavController
+import androidx.preference.PreferenceManager
 import androidx.recyclerview.widget.DiffUtil
 import androidx.recyclerview.widget.RecyclerView
 import androidx.viewpager2.adapter.FragmentStateAdapter
@@ -42,6 +43,7 @@ import kotlinx.coroutines.flow.collectLatest
 import kotlinx.coroutines.launch
 import org.lineageos.twelve.R
 import org.lineageos.twelve.SettingsActivity
+import org.lineageos.twelve.ext.floatingButtons
 import org.lineageos.twelve.ext.getViewProperty
 import org.lineageos.twelve.ext.isLandscape
 import org.lineageos.twelve.ext.isRtl
@@ -400,10 +402,12 @@ class MainFragment : Fragment(R.layout.fragment_main) {
 
         viewLifecycleOwner.lifecycleScope.launch {
             viewLifecycleOwner.repeatOnLifecycle(Lifecycle.State.STARTED) {
-                // Kompakt: with the mini player up, no Play random and tabs without labels.
+                // Kompakt: with the mini player up, no Play random and tabs without labels; Play random can be off.
                 launch {
                     nowPlayingViewModel.mediaItem.collectLatest {
-                        playRandomSongsExtendedFloatingActionButton.isVisible = it == null
+                        playRandomSongsExtendedFloatingActionButton.isVisible = it == null &&
+                                PreferenceManager.getDefaultSharedPreferences(requireContext())
+                                    .floatingButtons
                         navigationBarView.labelVisibilityMode = if (it == null)
                             NavigationBarView.LABEL_VISIBILITY_LABELED
                         else NavigationBarView.LABEL_VISIBILITY_UNLABELED
