From: Gezim <25499045+gezimos@users.noreply.github.com>
Date: Sun, 11 Oct 2026 13:32:29 +0200
Subject: [PATCH 4/4] Kompakt: the cover header hides and returns in one step

Album and playlist pages put the cover in a collapsing header that followed
the finger pixel by pixel, which on e-ink is a laggy smear of repaints. The
header can no longer be dragged: the first page forward hides it, a page
back from the top of the list brings it back, and a swipe on the header
itself does the same, each in one step. Only headers that collapse are
touched.

Change-Id: I376f494977673094d30afd824eff6a5984535213
---
 .../java/com/kompakt/eink/PagedScroll.java    | 74 ++++++++++++++++++-
 1 file changed, 73 insertions(+), 1 deletion(-)

diff --git a/app/src/main/java/com/kompakt/eink/PagedScroll.java b/app/src/main/java/com/kompakt/eink/PagedScroll.java
index e8adfb5..519a975 100644
--- a/app/src/main/java/com/kompakt/eink/PagedScroll.java
+++ b/app/src/main/java/com/kompakt/eink/PagedScroll.java
@@ -3,12 +3,17 @@ package com.kompakt.eink;
 import android.view.GestureDetector;
 import android.view.MotionEvent;
 import android.view.View;
+import android.view.ViewGroup;
+import android.view.ViewParent;
 
 import androidx.annotation.NonNull;
+import androidx.coordinatorlayout.widget.CoordinatorLayout;
 import androidx.recyclerview.widget.GridLayoutManager;
 import androidx.recyclerview.widget.LinearLayoutManager;
 import androidx.recyclerview.widget.RecyclerView;
 
+import com.google.android.material.appbar.AppBarLayout;
+
 /** Paged scrolling for Twelve's lists: Settings' PagedScroll, with the grid the Albums tab uses. */
 public final class PagedScroll {
 
@@ -32,13 +37,14 @@ public final class PagedScroll {
 
         final PagedLayoutManager lm = new PagedLayoutManager(rv.getContext(), span);
         rv.setLayoutManager(lm);
+        final AppBarLayout bar = holdHeader(rv);
 
         // fling = one page; dragging keeps paging as the finger travels (inkOS behaviour)
         final GestureDetector detector = new GestureDetector(rv.getContext(),
                 new PageGestureListener(rv.getContext(), new PageGestureListener.Pager() {
                     @Override
                     public boolean page(int delta) {
-                        return PagedScroll.page(rv, lm, delta);
+                        return PagedScroll.page(rv, lm, bar, delta);
                     }
                 }));
 
@@ -59,6 +65,72 @@ public final class PagedScroll {
         });
     }
 
+    /** Kompakt: a cover header hides on the first page forward and returns past the top, in one step. */
+    private static boolean page(RecyclerView rv, PagedLayoutManager lm, AppBarLayout bar,
+            int delta) {
+        if (bar != null && delta > 0 && !collapsed(bar)) {
+            bar.setExpanded(false, false);
+            return true;
+        }
+        final boolean moved = page(rv, lm, delta);
+        if (!moved && bar != null && delta < 0 && collapsed(bar)) {
+            bar.setExpanded(true, false);
+            return true;
+        }
+        return moved;
+    }
+
+    private static boolean collapsed(AppBarLayout bar) {
+        return bar.getTop() <= -bar.getTotalScrollRange();
+    }
+
+    /** The list's collapsing header, made to jump instead of following the finger; null if none. */
+    private static AppBarLayout holdHeader(final RecyclerView rv) {
+        ViewParent p = rv.getParent();
+        while (p != null && !(p instanceof CoordinatorLayout)) p = p.getParent();
+        if (p == null) return null;
+        final ViewGroup coordinator = (ViewGroup) p;
+        AppBarLayout found = null;
+        for (int i = 0; i < coordinator.getChildCount(); i++) {
+            if (coordinator.getChildAt(i) instanceof AppBarLayout) {
+                found = (AppBarLayout) coordinator.getChildAt(i);
+            }
+        }
+        if (found == null || found.getChildCount() == 0) return null;
+        // Only a header that collapses: the first child carries the scroll flag.
+        final ViewGroup.LayoutParams first = found.getChildAt(0).getLayoutParams();
+        if (!(first instanceof AppBarLayout.LayoutParams) || (((AppBarLayout.LayoutParams) first)
+                .getScrollFlags() & AppBarLayout.LayoutParams.SCROLL_FLAG_SCROLL) == 0) {
+            return null;
+        }
+        final AppBarLayout bar = found;
+        // No drag: on e-ink a header that follows the finger is a smear of repaints.
+        final AppBarLayout.Behavior behavior = new AppBarLayout.Behavior();
+        behavior.setDragCallback(new AppBarLayout.Behavior.DragCallback() {
+            @Override
+            public boolean canDrag(@NonNull AppBarLayout appBarLayout) {
+                return false;
+            }
+        });
+        ((CoordinatorLayout.LayoutParams) bar.getLayoutParams()).setBehavior(behavior);
+        // A swipe on the header itself pages too.
+        final GestureDetector detector = new GestureDetector(rv.getContext(),
+                new PageGestureListener(rv.getContext(), new PageGestureListener.Pager() {
+                    @Override
+                    public boolean page(int delta) {
+                        final boolean hide = delta > 0;
+                        if (hide == collapsed(bar)) return false;
+                        bar.setExpanded(!hide, false);
+                        return true;
+                    }
+                }));
+        bar.setOnTouchListener((v, e) -> {
+            detector.onTouchEvent(e);
+            return true;
+        });
+        return bar;
+    }
+
     /** Move by whole pages, in pixels, measured off the rows that are on screen. */
     private static boolean page(RecyclerView rv, PagedLayoutManager lm, int delta) {
         if (delta == 0) return false;
