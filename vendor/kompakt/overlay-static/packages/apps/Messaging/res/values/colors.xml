<?xml version="1.0" encoding="utf-8"?>
<!-- Messaging in black and white. -->
<resources>
    <!-- The bars. -->
    <color name="primary_color">#ffffffff</color>
    <color name="action_bar_background_color">#ffffffff</color>
    <color name="action_bar_background_color_dark">#ffffffff</color>
    <color name="contextual_action_bar_background_color">#ffffffff</color>
    <color name="archived_conversation_action_bar_background_color">#ffffffff</color>
    <color name="archived_conversation_action_bar_background_color_dark">#ffffffff</color>

    <!-- Incoming bubbles: white fill, black text. The outline is in the drawable. -->
