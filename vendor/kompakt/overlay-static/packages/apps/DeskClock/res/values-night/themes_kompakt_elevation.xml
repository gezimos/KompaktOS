<?xml version="1.0" encoding="utf-8"?>
<!-- Kompakt: copies of the app's own Material 3 themes with the elevation overlay switched off. -->
<resources>
    <style name="Theme.DeskClock.DigitalWidgetConfigurationTheme" parent="Theme.Material3Expressive.DynamicColors.DayNight.NoActionBar">
        <item name="appWidgetConfigBackground">?attr/colorSurface</item>
        <item name="appWidgetConfigTitle">?attr/colorOnSurfaceVariant</item>
        <item name="appWidgetConfigSubtitle">?attr/colorSurfaceVariant</item>
        <item name="appWidgetConfigBorder">?attr/colorOutline</item>
        <item name="appWidgetThemeTransparent">@style/Theme.DeskClock.DigitalWidgetTransparentDarkBg</item>
        <item name="appWidgetThemeSolid">@style/Theme.DeskClock.DigitalWidgetDarkBg</item>
        <item name="elevationOverlayEnabled">false</item>
    </style>
</resources>
