<?xml version="1.0" encoding="utf-8"?>
<!-- Kompakt: the selected tab icon sits on the ink pill (KompaktTabIndicator), so it takes the page colour. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:color="@color/kompakt_page" />
    <item android:state_selected="true" android:color="@color/kompakt_page" />
    <item android:color="?attr/colorOnSurface" />
</selector>
