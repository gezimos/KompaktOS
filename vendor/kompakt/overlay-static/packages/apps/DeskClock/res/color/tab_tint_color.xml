<?xml version="1.0" encoding="utf-8"?>
<!-- Kompakt: the selected tab sits on the secondaryContainer pill (ink), so its icon takes onSecondaryContainer; the rest. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:color="?attr/colorOnSecondaryContainer" />
    <item android:state_selected="true" android:color="?attr/colorOnSecondaryContainer" />
    <item android:color="?attr/colorOnSurface" />
</selector>
