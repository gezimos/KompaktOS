<!-- Kompakt: an album is a list row, a 72dp ringed cover beside its title, artist and year, 16dp from the edges and 16dp apart, so four fit a page. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="8dp"
    android:paddingVertical="8dp">

    <androidx.cardview.widget.CardView
        style="?attr/materialCardViewFilledStyle"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:foreground="@drawable/kompakt_cover_ring"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="8dp">

        <ImageView
            android:id="@+id/placeholderImageView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/colorPrimary"
            android:contentDescription="@string/content_description_thumbnail"
            android:padding="8dp"
            android:src="@drawable/ic_album"
            android:visibility="gone"
            app:tint="?attr/colorOnPrimary"
            tools:visibility="visible" />

        <ImageView
            android:id="@+id/thumbnailImageView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/colorSecondaryContainer"
            android:contentDescription="@string/content_description_thumbnail"
            android:scaleType="centerCrop"
            tools:visibility="gone" />

    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/headlineTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="@color/list_item_primary"
            android:visibility="gone"
            tools:text="Headline"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/subheadTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/list_item_secondary"
            android:visibility="gone"
            tools:text="Subhead"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/supportingTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/list_item_secondary"
            android:visibility="gone"
            tools:text="Supporting"
            tools:visibility="visible" />

    </LinearLayout>

</LinearLayout>
