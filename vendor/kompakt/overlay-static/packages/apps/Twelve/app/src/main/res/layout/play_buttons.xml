<!-- Kompakt: upstream's four actions as one row of icon buttons, as the Messaging and Calendar add buttons: 56dp, 16dp corners, a 2dp ink edge, no shadow and no floating toolbar. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/playButtonsLinearLayout"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/shufflePlayButton"
        style="@style/Theme.Twelve.Kompakt.SquareFab"
        android:layout_marginEnd="12dp"
        android:contentDescription="@string/shuffle_play"
        android:tooltipText="@string/shuffle_play"
        app:icon="@drawable/ic_shuffle_play" />

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/addToQueue"
        style="@style/Theme.Twelve.Kompakt.SquareFab"
        android:layout_marginEnd="12dp"
        android:contentDescription="@string/audio_add_to_queue"
        android:tooltipText="@string/audio_add_to_queue"
        app:icon="@drawable/ic_add_to_queue" />

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/playNextButton"
        style="@style/Theme.Twelve.Kompakt.SquareFab"
        android:layout_marginEnd="12dp"
        android:contentDescription="@string/audio_play_next"
        android:tooltipText="@string/audio_play_next"
        app:icon="@drawable/ic_queue_play_next" />

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/playAllButton"
        style="@style/Theme.Twelve.Kompakt.SquareFab"
        android:contentDescription="@string/play_all"
        android:tooltipText="@string/play_all"
        app:icon="@drawable/ic_play_arrow" />

</LinearLayout>
