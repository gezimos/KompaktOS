<?xml version="1.0" encoding="utf-8"?>
<!-- Kompakt: copies of the app's own Material 3 themes with the elevation overlay switched off. -->
<resources>
    <style name="PadButtonStyle" parent="Widget.Material3Expressive.Button">
        <item name="android:layout_width">0dip</item>
        <item name="android:layout_height">0dip</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:padding">0dp</item>
        <item name="android:onClick">onButtonClick</item>
        <item name="android:fontFeatureSettings">tnum, cv03, cv04</item>
        <item name="android:layout_marginHorizontal">@dimen/button_horizontal_margin</item>
        <item name="elevationOverlayEnabled">false</item>
    </style>
    <style name="Theme" parent="Theme.Material3Expressive.DayNight">
        <item name="android:statusBarColor">@color/display_background_color</item>
        <item name="android:windowLightStatusBar">?isLightTheme</item>
        <item name="android:navigationBarColor">?colorSurface</item>
        <item name="android:windowLightNavigationBar">?isLightTheme</item>
        <item name="elevationOverlayEnabled">false</item>
    </style>
    <style name="Theme.Button" parent="ThemeOverlay.Material3Expressive.Button.TextButton">
        <item name="elevationOverlayEnabled">false</item>
    </style>
    <style name="Theme.Licenses" parent="Theme.Material3Expressive.DayNight.NoActionBar">
        <item name="android:statusBarColor">?colorSurface</item>
        <item name="android:windowLightStatusBar">?isLightTheme</item>
        <item name="android:navigationBarColor">?colorSurface</item>
        <item name="android:windowLightNavigationBar">?isLightTheme</item>
        <item name="elevationOverlayEnabled">false</item>
    </style>
</resources>
