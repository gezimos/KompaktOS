<?xml version="1.0" encoding="utf-8"?>
<!-- Kompakt: the enrolling fingerprint, with a fill that follows progress. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item
        android:id="@+id/fingerprint_background"
        android:drawable="@drawable/fp_illustration_enrollment_animation" />

    <item android:id="@+id/kompakt_fingerprint_fill">
        <clip
            android:clipOrientation="vertical"
            android:gravity="bottom"
            android:drawable="@drawable/kompakt_fp_enroll_filled" />
    </item>

    <item
        android:id="@+id/fingerprint_animation"
        android:drawable="@drawable/enrollment_fingerprint_isolated_animation" />

</layer-list>
