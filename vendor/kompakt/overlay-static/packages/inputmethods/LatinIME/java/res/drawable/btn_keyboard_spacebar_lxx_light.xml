<?xml version="1.0" encoding="utf-8"?>
<!-- Kompakt e ink: the spacebar, drawn as a bottom rule only. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item android:gravity="bottom|fill_horizontal" android:height="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="#ff000000" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:gravity="bottom|fill_horizontal" android:height="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="#ff000000" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
