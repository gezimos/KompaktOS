<?xml version="1.0" encoding="utf-8"?>
<!-- Kompakt: copy of the stock drawable with a 2dp outline in the on surface ink. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:androidprv="http://schemas.android.com/apk/prv/res/android">
    <item android:state_focused="false" >
        <shape android:shape="oval">
            <solid android:color="@androidprv:color/materialColorSurfaceContainerHighest"/>
            <stroke android:width="2dp" android:color="@androidprv:color/materialColorOnSurface"/>
        </shape>
    </item>
    <item android:state_focused="true" >
        <shape android:shape="oval">
            <solid android:color="@color/global_actions_lite_button_background_focused"/>
            <stroke android:width="2dp" android:color="@androidprv:color/materialColorOnSurface"/>
        </shape>
    </item>
</selector>
