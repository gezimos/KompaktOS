<?xml version="1.0" encoding="utf-8"?>
<!-- Kompakt: copy of the stock drawable with a 2dp outline in the on surface ink, so the screenshot preview frame shows on a white screen. -->
<shape
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:androidprv="http://schemas.android.com/apk/prv/res/android"
    android:shape="rectangle">
    <solid android:color="@androidprv:color/materialColorSurfaceBright"/>
    <stroke android:width="2dp" android:color="@androidprv:color/materialColorOnSurface"/>
    <corners android:radius="16dp"/>
</shape>
