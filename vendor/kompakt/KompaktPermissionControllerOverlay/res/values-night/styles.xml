<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Kompakt: the permission prompt was Google grey 800 in dark mode. Black, like
         every other dialog here. An overlay replaces the whole style, so its one other
         item, the list divider, falls back to the theme's. -->
    <style name="Theme.PermissionGrantDialog" parent="@android:style/Theme.DeviceDefault.Dialog">
        <item name="android:colorBackground">@android:color/system_neutral1_900</item>
    </style>

    <!-- Kompakt: the icon over the prompt was tinted system_accent1_300, which is black
         in this palette. White on the black dialog. The other items are the original's. -->
    <style name="PermissionGrantTitleIconMaterial3">
        <item name="android:layout_width">32dp</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:tint">@android:color/system_accent1_100</item>
    </style>
</resources>
