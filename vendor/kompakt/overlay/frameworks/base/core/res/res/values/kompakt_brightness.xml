<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Kompakt: a frontlight curve, not a backlight one. It peaks under a lamp, falls in a lit room and
         is off from 300 lux, where the reflective panel needs no light. The points are the tops of the
         Kompakt app's rows (LightCurve.kt: dark up to 1 lux, dim room to 9, lamp light to 25, lit room to
         63, bright room to 173, off from 300), the same slide the app saves from its defaults; this curve
         runs until it has saved one. -->
    <integer-array name="config_autoBrightnessLevels">
        <item>1</item>
        <item>9</item>
        <item>25</item>
        <item>63</item>
        <item>173</item>
        <item>300</item>
    </integer-array>

    <!-- One more value than levels: at 0 and 1 lux the dark row, then each row's number at the top of
         its band, then off (1), as Android's brightness numbers. Kernel patch 0041 maps a number to the
         front light's PWM by a square law (510 * (n / 255)^2 of 1023): 31, 40, 48 and 18 are 2, 3, 4 and
         1 percent of full light. -->
    <integer-array name="config_autoBrightnessLcdBacklightValues">
        <item>31</item>
        <item>31</item>
        <item>40</item>
        <item>48</item>
        <item>40</item>
        <item>18</item>
        <item>1</item>
    </integer-array>

    <!-- Kompakt: the ramp rates stay the framework's (slow 60, fast 180, on the HLG scale, so the dim end
         is the slow end): a change of row is a quarter of a second, lamp light to off about three. The ramp
         only runs with frameworks_base 0164 and 0165; 9 here (builds 449, 450) was a twenty-second slide. -->

    <!-- Kompakt: no screen brightness hysteresis. The framework ignored a new automatic level within
         10 percent above or 20 percent below the current one, so the slide between rows stuck on a row's
         number and a tap on a row often changed nothing. Every change of the curve's level now applies;
         the ambient lux keeps its own hysteresis, which is what holds the light still on sensor jitter. -->
    <integer-array name="config_screenBrighteningThresholds">
        <item>0</item>
    </integer-array>
    <integer-array name="config_screenDarkeningThresholds">
        <item>0</item>
    </integer-array>

    <!-- Kompakt: stock. The sensor reports only when the light changes, so a kept lux stays until it does. -->
    <bool name="config_autoBrightnessResetAmbientLuxAfterWarmUp">true</bool>

    <!-- Kompakt: the display manager rejects a user curve under this one as too dark; a frontlight curve ends at off. -->
    <array name="config_minimumBrightnessCurveNits">
        <item>0.0</item>
        <item>0.0</item>
        <item>0.0</item>
    </array>
</resources>
