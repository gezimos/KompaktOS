# The two /sys/einkinfo nodes Mudita's own init does not hand over.
on post-fs-data
    chown system system /sys/einkinfo/manual_mode
    chmod 0664 /sys/einkinfo/manual_mode
    chown system system /sys/einkinfo/refresh_mode
    chmod 0664 /sys/einkinfo/refresh_mode

# Again once everything is up.
on property:sys.boot_completed=1
    chown system system /sys/einkinfo/manual_mode
    chmod 0664 /sys/einkinfo/manual_mode
    chown system system /sys/einkinfo/refresh_mode
    chmod 0664 /sys/einkinfo/refresh_mode

# /dev/ttyGS0, for KompaktService LinkService.
on property:sys.usb.state=*
    chmod 0666 /dev/ttyGS0
